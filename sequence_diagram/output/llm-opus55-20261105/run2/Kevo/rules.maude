load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < userA | ('msg' : nils , 'near' : deviceA) > < userC | ('msg' : nils , 'near' : nils) > < deviceA | ('key' : 'keyA') > < cloudA | (deviceA : ('owners' : nils , 'key' : 'keyA')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars FreshR : Qid .
vars K : Qid .
vars K2 : Qid .
vars M : Item .
vars Owners : Set .
vars R : Qid .
vars R2 : Qid .
vars Rest : Set .
vars UserX : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceA 
= < UserX | ('near' : deviceA , ..) > .
eq < UserX | ('near' : deviceA , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > .
eq < system | ('counter' : N , ..) > < deviceA | ('key' : K , ...) > $ UserX 'pressButton' deviceA 
= < system | ('counter' : N + 1 , ..) > < deviceA | ('key' : K , ...) > $ deviceA 'sendMessage' UserX | (encrypt(randomStr('R', N), K)) .
eq < UserX | ('msg' : nils , ..) > $ deviceA 'sendMessage' UserX | (M) 
= < UserX | ('msg' : M , ..) > .
eq < UserX | ('msg' : encrypt(R2, K2) , ..) > $ deviceA 'sendMessage' UserX | (M) 
= < UserX | ('msg' : encrypt(R2, K2) , ..) > .
eq < cloudA | (deviceA : ('key' : K , 'owners' : Owners , ..) , ...) > $ UserX 'bind' cloudA | (encrypt(R, K)) 
= < cloudA | (deviceA : ('key' : K , 'owners' : (UserX , Owners) , ..) , ...) > .
eq < cloudA | (deviceA : ('owners' : (UserX , Rest) , ..) , ...) > $ UserX 'reset' cloudA | (deviceA) 
= < cloudA | (deviceA : ('owners' : (nils , Rest) , ..) , ...) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars FreshR : Qid .
vars K : Qid .
vars K2 : Qid .
vars M : Item .
vars Owners : Set .
vars R : Qid .
vars R2 : Qid .
vars Rest : Set .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid Qid -> Event .
ops ev5 : User Qid -> Event .
ops ev6 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceA .
eq ev2(UserX) = $ UserX 'leave' deviceA .
eq ev3(UserX) = $ UserX 'pressButton' deviceA .
eq ev4(UserX, R, K) = $ UserX 'bind' cloudA | (encrypt(R, K)) .
eq ev5(UserX, MessageA) = $ UserX 'bind' cloudA | (MessageA) .
eq ev6(UserX) = $ UserX 'reset' cloudA | (deviceA) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev5]: E @ S < UserX | ('msg' : MessageA , ..) > 
=> ep: ev5(UserX, MessageA) @ S < UserX | ('msg' : MessageA , ..) > .
rl [rev6]: E @ S < UserX | (..) > 
=> ep: ev6(UserX) @ S < UserX | (..) > .

endm
