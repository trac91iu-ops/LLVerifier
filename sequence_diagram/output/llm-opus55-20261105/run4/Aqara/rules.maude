load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < userA | ('key' : nils) > < userC | ('key' : nils) > < deviceA | ('trusted' : cloudA , 'power' : 'off' , 'key' : nils) > < cloudA | (userA : ('device' : deviceA , 'members' : nils) , userC : ('device' : nils , 'members' : nils)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars D : Device .
vars FreshKey : Qid .
vars Key : Qid .
vars Members : Set .
vars OldKey : Set .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < system | ('counter' : N , ..) > < UserX | ('key' : OldKey , ...) > $ UserX 'openWindow' cloudA | (deviceA) 
= < system | ('counter' : N + 1 , ..) > < UserX | ('key' : randomStr('Key', N) , ...) > $ cloudA 'openBindingWindow' deviceA | (randomStr('Key', N)) .
eq < deviceA | ('key' : nils , ..) > $ cloudA 'openBindingWindow' deviceA | (Key) 
= < deviceA | ('key' : Key , ..) > .
eq < deviceA | ('key' : Key , 'trusted' : Trusted , ..) > $ UserX 'bind' deviceA | (Key) 
= < deviceA | ('key' : Key , 'trusted' : (UserX , Trusted) , ..) > .
eq < deviceA | ('trusted' : (UserX , Trusted) , 'power' : 'off' , ..) > $ UserX 'turnOn' deviceA 
= < deviceA | ('trusted' : (UserX , Trusted) , 'power' : 'on' , ..) > .
eq < cloudA | (UserX : ('device' : deviceA , ..) , ...) > $ UserX 'turnOnViaCloud' cloudA | (deviceA) 
= < cloudA | (UserX : ('device' : deviceA , ..) , ...) > $ cloudA 'turnOn' deviceA .
eq < deviceA | ('trusted' : (cloudA , Trusted) , 'power' : 'off' , ..) > $ cloudA 'turnOn' deviceA 
= < deviceA | ('trusted' : (cloudA , Trusted) , 'power' : 'on' , ..) > .
eq < cloudA | (UserX : ('members' : Members , 'device' : deviceA , ..) , UserY : ('device' : nils , ...) , ....) > $ UserX 'invite' cloudA | (UserY) 
= < cloudA | (UserX : ('members' : (UserY , Members) , 'device' : deviceA , ..) , UserY : ('device' : deviceA , ...) , ....) > .
eq < cloudA | (UserX : ('members' : Members , 'device' : nils , ..) , ...) > $ UserX 'invite' cloudA | (UserY) 
= < cloudA | (UserX : ('members' : (UserY , Members) , 'device' : nils , ..) , ...) > .
eq < cloudA | (UserX : ('members' : Members , 'device' : deviceA , ..) , UserY : ('device' : deviceA , ...) , ....) > $ UserX 'invite' cloudA | (UserY) 
= < cloudA | (UserX : ('members' : (UserY , Members) , 'device' : deviceA , ..) , UserY : ('device' : deviceA , ...) , ....) > .
eq < cloudA | (UserX : ('members' : (UserY , Members) , 'device' : D , ..) , UserY : ('device' : D , ...) , ....) > $ UserX 'kick' cloudA | (UserY) 
= < cloudA | (UserX : ('members' : Members , 'device' : D , ..) , UserY : ('device' : nils , ...) , ....) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars D : Device .
vars FreshKey : Qid .
vars Key : Qid .
vars Members : Set .
vars OldKey : Set .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
vars Rest : Set .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Qid -> Event .
ops ev3 : User -> Event .
ops ev4 : User -> Event .
ops ev5 : User User -> Event .
ops ev6 : User User -> Event .
*** events
eq ev1(UserX) = $ UserX 'openWindow' cloudA | (deviceA) .
eq ev2(UserX, Key) = $ UserX 'bind' deviceA | (Key) .
eq ev3(UserX) = $ UserX 'turnOn' deviceA .
eq ev4(UserX) = $ UserX 'turnOnViaCloud' cloudA | (deviceA) .
eq ev5(UserX, UserY) = $ UserX 'invite' cloudA | (UserY) .
eq ev6(UserX, UserY) = $ UserX 'kick' cloudA | (UserY) .
*** transitions
rl [rev1]: E @ S < cloudA | (UserX : ('device' : deviceA , ..) , ...) > < UserX | ('key' : nils , ....) > 
=> ep: ev1(UserX) @ S < cloudA | (UserX : ('device' : deviceA , ..) , ...) > < UserX | ('key' : nils , ....) > .
rl [rev2]: E @ S < UserX | ('key' : (Key , Rest) , ..) > 
=> ep: ev2(UserX, Key) @ S < UserX | ('key' : (Key , Rest) , ..) > .
rl [rev3]: E @ S < UserX | (..) > < deviceA | (...) > 
=> ep: ev3(UserX) @ S < UserX | (..) > < deviceA | (...) > .
rl [rev4]: E @ S < UserX | (..) > 
=> ep: ev4(UserX) @ S < UserX | (..) > .
rl [rev5]: E @ S < UserX | (..) > < UserY | (...) > 
=> ep: ev5(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > .
rl [rev6]: E @ S < cloudA | (UserX : ('device' : deviceA , 'members' : (UserY , Rest) , ..) , UserY : ('device' : deviceA , ...) , ....) > 
=> ep: ev6(UserX, UserY) @ S < cloudA | (UserX : ('device' : deviceA , 'members' : (UserY , Rest) , ..) , UserY : ('device' : deviceA , ...) , ....) > .

endm
