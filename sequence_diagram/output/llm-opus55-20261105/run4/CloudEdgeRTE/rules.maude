load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | ('near' : deviceB) > < userC | ('near' : deviceD) > < deviceB | ('key' : nils , 'button' : false) > < deviceD | ('key' : nils , 'button' : false) > < cloudA | (userA : ('key' : 'keyA') , userC : ('key' : 'keyC') , deviceB : ('owner' : nils) , deviceD : ('owner' : nils)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars DeviceX : Device .
vars K : Qid .
vars UserX : User .
vars UserY : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' DeviceX 
= < UserX | ('near' : DeviceX , ..) > .
eq < UserX | ('near' : DeviceX , ..) > $ UserX 'leave' DeviceX 
= < UserX | ('near' : nils , ..) > .
eq < DeviceX | ('button' : false , ..) > $ UserX 'pressButton' DeviceX 
= < DeviceX | ('button' : true , ..) > .
eq < DeviceX | ('button' : true , 'key' : nils , ..) > $ UserX 'sendKey' DeviceX | (K) 
= < DeviceX | ('button' : false , 'key' : K , ..) > .
eq < DeviceX | ('key' : K , ..) > $ UserX 'discover' DeviceX 
= < DeviceX | ('key' : K , ..) > $ DeviceX 'bind' cloudA | (K) .
eq < cloudA | (DeviceX : ('owner' : nils , ..) , UserY : ('key' : K , ...) , ....) > $ DeviceX 'bind' cloudA | (K) 
= < cloudA | (DeviceX : ('owner' : UserY , ..) , UserY : ('key' : K , ...) , ....) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars DeviceX : Device .
vars K : Qid .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User Device -> Event .
ops ev2 : User Device -> Event .
ops ev3 : User Device -> Event .
ops ev4 : User Device Qid -> Event .
ops ev5 : User Device -> Event .
*** events
eq ev1(UserX, DeviceX) = $ UserX 'approach' DeviceX .
eq ev2(UserX, DeviceX) = $ UserX 'leave' DeviceX .
eq ev3(UserX, DeviceX) = $ UserX 'pressButton' DeviceX .
eq ev4(UserX, DeviceX, K) = $ UserX 'sendKey' DeviceX | (K) .
eq ev5(UserX, DeviceX) = $ UserX 'discover' DeviceX .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > < DeviceX | (...) > 
=> ep: ev1(UserX, DeviceX) @ S < UserX | ('near' : nils , ..) > < DeviceX | (...) > .
rl [rev2]: E @ S < UserX | ('near' : DeviceX , ..) > 
=> ep: ev2(UserX, DeviceX) @ S < UserX | ('near' : DeviceX , ..) > .
rl [rev3]: E @ S < UserX | ('near' : DeviceX , ..) > 
=> ep: ev3(UserX, DeviceX) @ S < UserX | ('near' : DeviceX , ..) > .
rl [rev4]: E @ S < UserX | ('near' : DeviceX , ..) > < cloudA | (UserY : ('key' : K , ...) , ....) > 
=> ep: ev4(UserX, DeviceX, K) @ S < UserX | ('near' : DeviceX , ..) > < cloudA | (UserY : ('key' : K , ...) , ....) > .
rl [rev5]: E @ S < UserX | ('near' : DeviceX , ..) > 
=> ep: ev5(UserX, DeviceX) @ S < UserX | ('near' : DeviceX , ..) > .

endm
