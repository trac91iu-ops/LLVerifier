load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < userA | ('signedKey' : nils , 'key' : nils , 'near' : deviceA) > < userC | ('signedKey' : nils , 'key' : nils , 'near' : nils) > < deviceA | ('trusted' : (userA) , 'secret' : 'secret' , 'key' : '') > < cloudA | (deviceA : ('trusted' : (userA)) , 'secret' : 'secret') > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars FreshKey : Qid .
vars K : Qid .
vars M : Item .
vars S : Qid .
vars UserX : User .
vars UserY : User .
vars Users : Set .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceA 
= < UserX | ('near' : deviceA , ..) > .
eq < UserX | ('near' : deviceA , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > .
eq < system | ('counter' : N , ..) > < UserX | ('key' : nils , ...) > < deviceA | ('key' : K , ....) > $ UserX 'requestKey' deviceA 
= < system | ('counter' : N + 1 , ..) > < UserX | ('key' : randomStr('Key', N) , ...) > < deviceA | ('key' : randomStr('Key', N) , ....) > .
eq < cloudA | ('secret' : S , deviceA : ('trusted' : (UserX , Users) , ..) , ...) > $ UserX 'signKey' cloudA | (deviceA ; K) 
= < cloudA | ('secret' : S , deviceA : ('trusted' : (UserX , Users) , ..) , ...) > $ cloudA 'sendSignedKey' UserX | (deviceA ; encrypt(K, S)) .
eq < UserX | ('signedKey' : nils , ..) > $ cloudA 'sendSignedKey' UserX | (deviceA ; M) 
= < UserX | ('signedKey' : M , ..) > .
ceq < UserX | ('signedKey' : M , ..) > < deviceA | ('key' : K , 'secret' : S , 'trusted' : Users , ...) > $ UserX 'bind' deviceA | (M) 
= < UserX | ('signedKey' : M , ..) > < deviceA | ('key' : K , 'secret' : S , 'trusted' : (UserX , Users) , ...) > if M == encrypt(K, S) .
eq < cloudA | (deviceA : ('trusted' : Users , ..) , ...) > $ UserX 'share' cloudA | (deviceA ; UserY) 
= < cloudA | (deviceA : ('trusted' : (UserY , Users) , ..) , ...) > .
eq < cloudA | (deviceA : ('trusted' : (UserX , UserY , Users) , ..) , ...) > $ UserX 'revoke' cloudA | (deviceA ; UserY) 
= < cloudA | (deviceA : ('trusted' : (UserX , Users) , ..) , ...) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars FreshKey : Qid .
vars K : Qid .
vars M : Item .
vars S : Qid .
vars UserX : User .
vars UserY : User .
vars Users : Set .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid -> Event .
ops ev5 : User Item -> Event .
ops ev6 : User User -> Event .
ops ev7 : User User -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceA .
eq ev2(UserX) = $ UserX 'leave' deviceA .
eq ev3(UserX) = $ UserX 'requestKey' deviceA .
eq ev4(UserX, K) = $ UserX 'signKey' cloudA | (deviceA ; K) .
eq ev5(UserX, M) = $ UserX 'bind' deviceA | (M) .
eq ev6(UserX, UserY) = $ UserX 'share' cloudA | (deviceA ; UserY) .
eq ev7(UserX, UserY) = $ UserX 'revoke' cloudA | (deviceA ; UserY) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > < deviceA | (...) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > < deviceA | (...) > .
rl [rev2]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev4]: E @ S < UserX | ('key' : K , ..) > < deviceA | (...) > 
=> ep: ev4(UserX, K) @ S < UserX | ('key' : K , ..) > < deviceA | (...) > .
rl [rev5]: E @ S < UserX | ('near' : deviceA , 'signedKey' : M , ..) > 
=> ep: ev5(UserX, M) @ S < UserX | ('near' : deviceA , 'signedKey' : M , ..) > .
rl [rev6]: E @ S < UserX | (..) > < UserY | (...) > < deviceA | (....) > 
=> ep: ev6(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > < deviceA | (....) > .
rl [rev7]: E @ S < UserX | (..) > < UserY | (...) > 
=> ep: ev7(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > .

endm
