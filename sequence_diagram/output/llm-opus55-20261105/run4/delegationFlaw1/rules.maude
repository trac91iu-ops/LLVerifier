load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < cloudGoogle | (deviceSwitch : ('trust' : (userA) , 'on' : false , 'key' : 'keySwitch')) > < userA | ('key' : nils) > < userC | ('key' : nils) > < cloudSmartThing | (deviceSwitch : ('bind' : deviceLock , 'key' : 'keySwitch' , 'trust' : (cloudGoogle))) > < deviceLock | ('trust' : (cloudSmartThing) , 'on' : false) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars CloudX : Cloud .
vars DeviceX : Device .
vars DeviceY : Device .
vars Key : Qid .
vars P : Principal .
vars Rest : Set .
vars Trust : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < CloudX | (DeviceX : ('trust' : (UserX , Rest) , 'key' : Key , ..) , ...) > $ UserX 'requestKey' CloudX 
= < CloudX | (DeviceX : ('trust' : (UserX , Rest) , 'key' : Key , ..) , ...) > $ CloudX 'sendKey' UserX | (Key) .
eq < UserX | ('key' : nils , ..) > $ CloudX 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < CloudX | (DeviceX : ('trust' : (UserX , Rest) , ..) , ...) > $ UserX 'delegate' CloudX | (DeviceX ; UserY) 
= < CloudX | (DeviceX : ('trust' : (UserX , Rest , UserY) , ..) , ...) > .
eq < CloudX | (DeviceX : ('trust' : (UserX , UserY , Rest) , ..) , ...) > $ UserX 'revoke' CloudX | (DeviceX ; UserY) 
= < CloudX | (DeviceX : ('trust' : (UserX , Rest) , ..) , ...) > .
eq < cloudSmartThing | (DeviceX : ('trust' : Trust , 'key' : Key , ..) , ...) > $ UserX 'provideKey' cloudSmartThing | (DeviceX ; Key) 
= < cloudSmartThing | (DeviceX : ('trust' : (Trust , UserX) , 'key' : Key , ..) , ...) > .
eq < CloudX | (DeviceX : ('trust' : (P , Rest) , 'on' : false , ..) , ...) > $ P 'turnOn' DeviceX 
= < CloudX | (DeviceX : ('trust' : (P , Rest) , 'on' : true , ..) , ...) > $ CloudX 'turnOn' DeviceX .
eq < cloudSmartThing | (DeviceX : ('bind' : DeviceY , ..) , ...) > $ cloudSmartThing 'turnOn' DeviceX 
= < cloudSmartThing | (DeviceX : ('bind' : DeviceY , ..) , ...) > $ cloudSmartThing 'turnOn' DeviceY .
eq < deviceLock | ('trust' : (P , Rest) , 'on' : false , ..) > $ P 'turnOn' deviceLock 
= < deviceLock | ('trust' : (P , Rest) , 'on' : true , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars CloudX : Cloud .
vars DeviceX : Device .
vars DeviceY : Device .
vars Key : Qid .
vars P : Principal .
vars Rest : Set .
vars Trust : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User Cloud -> Event .
ops ev2 : User Cloud Device User -> Event .
ops ev3 : User Cloud Device User -> Event .
ops ev4 : User Device Qid -> Event .
ops ev5 : Principal Device -> Event .
*** events
eq ev1(UserX, CloudX) = $ UserX 'requestKey' CloudX .
eq ev2(UserX, CloudX, DeviceX, UserY) = $ UserX 'delegate' CloudX | (DeviceX ; UserY) .
eq ev3(UserX, CloudX, DeviceX, UserY) = $ UserX 'revoke' CloudX | (DeviceX ; UserY) .
eq ev4(UserX, DeviceX, Key) = $ UserX 'provideKey' cloudSmartThing | (DeviceX ; Key) .
eq ev5(P, DeviceX) = $ P 'turnOn' DeviceX .
*** transitions
rl [rev1]: E @ S < UserX | (..) > < CloudX | (...) > 
=> ep: ev1(UserX, CloudX) @ S < UserX | (..) > < CloudX | (...) > .
rl [rev2]: E @ S < UserX | (..) > < UserY | (...) > < CloudX | (....) > < DeviceX | ..... > 
=> ep: ev2(UserX, CloudX, DeviceX, UserY) @ S < UserX | (..) > < UserY | (...) > < CloudX | (....) > < DeviceX | ..... > .
rl [rev3]: E @ S < UserX | (..) > < UserY | (...) > < CloudX | (....) > < DeviceX | ..... > 
=> ep: ev3(UserX, CloudX, DeviceX, UserY) @ S < UserX | (..) > < UserY | (...) > < CloudX | (....) > < DeviceX | ..... > .
rl [rev4]: E @ S < UserX | ('key' : Key , ..) > < cloudSmartThing | (...) > < DeviceX | .... > 
=> ep: ev4(UserX, DeviceX, Key) @ S < UserX | ('key' : Key , ..) > < cloudSmartThing | (...) > < DeviceX | .... > .
rl [rev5]: E @ S < UserX | (..) > < CloudX | (...) > < DeviceX | .... > 
=> ep: ev5(UserX, DeviceX) @ S < UserX | (..) > < CloudX | (...) > < DeviceX | .... > .
rl [rev5]: E @ S < UserX | (..) > < DeviceX | (...) > 
=> ep: ev5(UserX, DeviceX) @ S < UserX | (..) > < DeviceX | (...) > .

endm
