load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < deviceA | ('key' : nils , 'buttonPressed' : false) > < cloudA | (deviceA : ('owner' : nils , 'bindKey' : '')) > < userA | ('near' : deviceA , 'key' : 'keyA') > < userC | ('near' : nils , 'key' : 'keyC') > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Key : Qid .
vars OldKey : Set .
vars UserX : User .
*** policy
eq < deviceA | ('buttonPressed' : false , ..) > $ UserX 'pressButton' deviceA 
= < deviceA | ('buttonPressed' : true , ..) > .
eq < deviceA | ('buttonPressed' : true , 'key' : OldKey , ..) > $ UserX 'setKey' deviceA | (Key) 
= < deviceA | ('buttonPressed' : false , 'key' : Key , ..) > $ deviceA 'sendBindKey' cloudA | (Key) .
eq < cloudA | (deviceA : ('bindKey' : OldKey , ..) , ...) > $ deviceA 'sendBindKey' cloudA | (Key) 
= < cloudA | (deviceA : ('bindKey' : Key , ..) , ...) > .
eq < deviceA | ('buttonPressed' : true , 'key' : Key , ..) > $ UserX 'retrieveKey' deviceA 
= < deviceA | ('buttonPressed' : false , 'key' : Key , ..) > $ deviceA 'sendKey' UserX | (Key) .
eq < UserX | ('key' : OldKey , ..) > $ deviceA 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < cloudA | (deviceA : ('bindKey' : Key , 'owner' : nils , ..) , ...) > $ UserX 'bindDevice' cloudA | (deviceA ; Key) 
= < cloudA | (deviceA : ('bindKey' : Key , 'owner' : UserX , ..) , ...) > .
eq < cloudA | (deviceA : ('bindKey' : Key , 'owner' : UserX , ..) , ...) > $ UserX 'resetDevice' cloudA | (deviceA ; Key) 
= < cloudA | (deviceA : ('bindKey' : nils , 'owner' : nils , ..) , ...) > .
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceA 
= < UserX | ('near' : deviceA , ..) > .
eq < UserX | ('near' : deviceA , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Key : Qid .
vars OldKey : Set .
vars UserX : User .
vars MessageA : Qid .
vars Rest : Set .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Qid -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid -> Event .
ops ev5 : User Qid -> Event .
ops ev6 : User -> Event .
ops ev7 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'pressButton' deviceA .
eq ev2(UserX, Key) = $ UserX 'setKey' deviceA | (Key) .
eq ev3(UserX) = $ UserX 'retrieveKey' deviceA .
eq ev4(UserX, Key) = $ UserX 'bindDevice' cloudA | (deviceA ; Key) .
eq ev5(UserX, Key) = $ UserX 'resetDevice' cloudA | (deviceA ; Key) .
eq ev6(UserX) = $ UserX 'approach' deviceA .
eq ev7(UserX) = $ UserX 'leave' deviceA .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceA , 'key' : (Key , Rest) , ..) > 
=> ep: ev2(UserX, Key) @ S < UserX | ('near' : deviceA , 'key' : (Key , Rest) , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev4]: E @ S < UserX | ('key' : (Key , Rest) , ..) > < deviceA | (...) > 
=> ep: ev4(UserX, Key) @ S < UserX | ('key' : (Key , Rest) , ..) > < deviceA | (...) > .
rl [rev5]: E @ S < UserX | ('key' : (Key , Rest) , ..) > < deviceA | (...) > 
=> ep: ev5(UserX, Key) @ S < UserX | ('key' : (Key , Rest) , ..) > < deviceA | (...) > .
rl [rev6]: E @ S < UserX | ('near' : nils , ..) > < deviceA | (...) > 
=> ep: ev6(UserX) @ S < UserX | ('near' : nils , ..) > < deviceA | (...) > .
rl [rev7]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev7(UserX) @ S < UserX | ('near' : deviceA , ..) > .

endm
