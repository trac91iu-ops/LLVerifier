load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < deviceB | ('key' : 'keyB') > < userA | ('near' : deviceB , 'key' : nils) > < userC | ('near' : nils , 'key' : nils) > < cloudA | (userA : ('members' : nils , 'devices' : nils) , userC : ('members' : nils , 'devices' : nils) , deviceB : ('owners' : nils , 'bindKey' : 'keyB')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars K : Qid .
vars Members : Set .
vars Owners : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < deviceB | ('key' : K , ..) > $ UserX 'pressButton' deviceB 
= < deviceB | ('key' : K , ..) > $ deviceB 'sendKey' UserX | (K) .
eq < UserX | ('key' : nils , ..) > $ deviceB 'sendKey' UserX | (K) 
= < UserX | ('key' : K , ..) > .
eq < cloudA | (deviceB : ('bindKey' : K , 'owners' : Owners , ..) , ...) > $ UserX 'bind' cloudA | (deviceB ; K) 
= < cloudA | (deviceB : ('bindKey' : K , 'owners' : (UserX , Owners) , ..) , ...) > .
eq < cloudA | (UserX : ('devices' : nils , 'members' : Members , ..) , ...) > $ UserX 'invite' cloudA | (UserY) 
= < cloudA | (UserX : ('devices' : nils , 'members' : (UserY , Members) , ..) , ...) > .
eq < cloudA | (UserX : ('devices' : nils , 'members' : (UserY , Members) , ..) , ...) > $ UserX 'removeMember' cloudA | (UserY) 
= < cloudA | (UserX : ('devices' : nils , 'members' : Members , ..) , ...) > .
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : deviceB , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars K : Qid .
vars Members : Set .
vars Owners : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Qid -> Event .
ops ev3 : User User -> Event .
ops ev4 : User User -> Event .
ops ev5 : User -> Event .
ops ev6 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'pressButton' deviceB .
eq ev2(UserX, K) = $ UserX 'bind' cloudA | (deviceB ; K) .
eq ev3(UserX, UserY) = $ UserX 'invite' cloudA | (UserY) .
eq ev4(UserX, UserY) = $ UserX 'removeMember' cloudA | (UserY) .
eq ev5(UserX) = $ UserX 'approach' deviceB .
eq ev6(UserX) = $ UserX 'leave' deviceB .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev2]: E @ S < UserX | ('key' : K , ..) > < deviceB | (...) > 
=> ep: ev2(UserX, K) @ S < UserX | ('key' : K , ..) > < deviceB | (...) > .
rl [rev3]: E @ S < UserX | (..) > < UserY | (...) > 
=> ep: ev3(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > .
rl [rev4]: E @ S < UserX | (..) > < UserY | (...) > 
=> ep: ev4(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > .
rl [rev5]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev6]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev6(UserX) @ S < UserX | ('near' : deviceB , ..) > .

endm
