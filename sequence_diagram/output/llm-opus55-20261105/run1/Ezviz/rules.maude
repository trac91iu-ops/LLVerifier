load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | ('key' : nils , 'near' : deviceA) > < userC | ('key' : nils , 'near' : nils) > < deviceA | ('online' : false , 'key' : 'keyA') > < cloudA | (deviceA : ('owner' : nils , 'bindKey' : 'keyA')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars K : Qid .
vars UserX : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceA 
= < UserX | ('near' : deviceA , ..) > .
eq < UserX | ('near' : deviceA , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > .
eq < deviceA | ('online' : false , 'key' : K , ..) > $ UserX 'pressButton' deviceA 
= < deviceA | ('online' : true , 'key' : K , ..) > $ deviceA 'sendKey' UserX | (K) .
eq < UserX | ('key' : nils , ..) > $ deviceA 'sendKey' UserX | (K) 
= < UserX | ('key' : K , ..) > .
eq < cloudA | (deviceA : ('bindKey' : K , 'owner' : nils , ..) , ...) > < deviceA | ('online' : true , ....) > $ UserX 'bind' cloudA | (K) 
= < cloudA | (deviceA : ('bindKey' : K , 'owner' : UserX , ..) , ...) > < deviceA | ('online' : true , ....) > .
eq < cloudA | (deviceA : ('owner' : UserX , ..) , ...) > < deviceA | ('online' : false , ....) > $ UserX 'reset' cloudA | (deviceA) 
= < cloudA | (deviceA : ('owner' : nils , ..) , ...) > < deviceA | ('online' : false , ....) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars K : Qid .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid -> Event .
ops ev5 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceA .
eq ev2(UserX) = $ UserX 'leave' deviceA .
eq ev3(UserX) = $ UserX 'pressButton' deviceA .
eq ev4(UserX, K) = $ UserX 'bind' cloudA | (K) .
eq ev5(UserX) = $ UserX 'reset' cloudA | (deviceA) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev4]: E @ S < UserX | ('key' : K , ..) > 
=> ep: ev4(UserX, K) @ S < UserX | ('key' : K , ..) > .
rl [rev5]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : deviceA , ..) > .

endm
