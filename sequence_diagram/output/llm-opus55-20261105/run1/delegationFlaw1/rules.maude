load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < cloudGoogle | (deviceSwitch : ('trust' : userA , 'on' : false , 'key' : 'keySwitch')) > < userA | ('key' : nils) > < userC | ('key' : nils) > < cloudSmartThing | (deviceSwitch : ('bind' : deviceLock , 'key' : 'keySwitch' , 'trust' : (cloudGoogle))) > < deviceLock | ('trust' : (cloudSmartThing) , 'on' : false) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Cloud : Cloud .
vars DeviceX : Device .
vars K : Qid .
vars LinkedDevice : Device .
vars P : Principal .
vars Rest : Set .
vars Trust : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < Cloud | (DeviceX : ('trust' : (UserX , Rest) , 'key' : K , ..) , ...) > $ UserX 'requestKey' Cloud 
= < Cloud | (DeviceX : ('trust' : (UserX , Rest) , 'key' : K , ..) , ...) > $ Cloud 'sendKey' UserX | (K) .
eq < UserX | ('key' : nils , ..) > $ Cloud 'sendKey' UserX | (K) 
= < UserX | ('key' : K , ..) > .
eq < Cloud | (DeviceX : ('trust' : (UserX , Rest) , ..) , ...) > $ UserX 'delegate' Cloud | (DeviceX ; UserY) 
= < Cloud | (DeviceX : ('trust' : (UserX , Rest , UserY) , ..) , ...) > .
eq < Cloud | (DeviceX : ('trust' : (UserX , UserY , Rest) , ..) , ...) > $ UserX 'revoke' Cloud | (DeviceX ; UserY) 
= < Cloud | (DeviceX : ('trust' : (UserX , Rest) , ..) , ...) > .
eq < cloudSmartThing | (DeviceX : ('trust' : Trust , 'key' : K , ..) , ...) > $ UserX 'provideKey' cloudSmartThing | (DeviceX ; K) 
= < cloudSmartThing | (DeviceX : ('trust' : (Trust , UserX) , 'key' : K , ..) , ...) > .
eq < Cloud | (DeviceX : ('trust' : (P , Rest) , 'on' : false , ..) , ...) > $ P 'turnOn' DeviceX 
= < Cloud | (DeviceX : ('trust' : (P , Rest) , 'on' : true , ..) , ...) > $ Cloud 'turnOn' DeviceX .
eq < cloudSmartThing | (DeviceX : ('bind' : LinkedDevice , ..) , ...) > $ cloudSmartThing 'turnOn' DeviceX 
= < cloudSmartThing | (DeviceX : ('bind' : LinkedDevice , ..) , ...) > $ cloudSmartThing 'turnOn' LinkedDevice .
eq < deviceLock | ('trust' : (P , Rest) , 'on' : false , ..) > $ P 'turnOn' deviceLock 
= < deviceLock | ('trust' : (P , Rest) , 'on' : true , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Cloud : Cloud .
vars DeviceX : Device .
vars K : Qid .
vars LinkedDevice : Device .
vars P : Principal .
vars Rest : Set .
vars Trust : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User Cloud -> Event .
ops ev2 : User Cloud Device User -> Event .
ops ev3 : User Cloud Device User -> Event .
ops ev4 : User Device Qid -> Event .
ops ev5 : Principal Device -> Event .
*** events
eq ev1(UserX, Cloud) = $ UserX 'requestKey' Cloud .
eq ev2(UserX, Cloud, DeviceX, UserY) = $ UserX 'delegate' Cloud | (DeviceX ; UserY) .
eq ev3(UserX, Cloud, DeviceX, UserY) = $ UserX 'revoke' Cloud | (DeviceX ; UserY) .
eq ev4(UserX, DeviceX, K) = $ UserX 'provideKey' cloudSmartThing | (DeviceX ; K) .
eq ev5(P, DeviceX) = $ P 'turnOn' DeviceX .
*** transitions
rl [rev1]: E @ S < UserX | (..) > < Cloud | (...) > 
=> ep: ev1(UserX, Cloud) @ S < UserX | (..) > < Cloud | (...) > .
rl [rev2]: E @ S < UserX | (..) > < UserY | (...) > < Cloud | (....) > < DeviceX | ..... > 
=> ep: ev2(UserX, Cloud, DeviceX, UserY) @ S < UserX | (..) > < UserY | (...) > < Cloud | (....) > < DeviceX | ..... > .
rl [rev3]: E @ S < UserX | (..) > < UserY | (...) > < Cloud | (....) > < DeviceX | ..... > 
=> ep: ev3(UserX, Cloud, DeviceX, UserY) @ S < UserX | (..) > < UserY | (...) > < Cloud | (....) > < DeviceX | ..... > .
rl [rev4]: E @ S < UserX | ('key' : K , ..) > < cloudSmartThing | (...) > < DeviceX | .... > 
=> ep: ev4(UserX, DeviceX, K) @ S < UserX | ('key' : K , ..) > < cloudSmartThing | (...) > < DeviceX | .... > .
rl [rev5]: E @ S < UserX | (..) > < DeviceX | (...) > 
=> ep: ev5(UserX, DeviceX) @ S < UserX | (..) > < DeviceX | (...) > .
rl [rev5]: E @ S < UserX | (..) > < Cloud | (...) > < DeviceX | .... > 
=> ep: ev5(UserX, DeviceX) @ S < UserX | (..) > < Cloud | (...) > < DeviceX | .... > .

endm
