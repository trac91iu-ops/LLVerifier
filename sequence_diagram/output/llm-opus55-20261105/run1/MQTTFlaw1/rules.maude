load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < cloudB | ('perm' : (userA , deviceA) , 'buffer' : nils) > < deviceA | ('on' : false) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Msg : Qid .
vars Perms : Set .
vars UserX : User .
*** policy
eq < cloudB | ('buffer' : nils , 'perm' : (UserX , Perms) , ..) > $ UserX 'publish' cloudB | ('toggle') 
= < cloudB | ('buffer' : 'toggle' , 'perm' : (UserX , Perms) , ..) > $ cloudB 'ack' UserX | ('toggle') .
eq < cloudB | ('perm' : (UserX , Perms) , ..) > $ cloudB 'revokePermission' cloudB | (UserX) 
= < cloudB | ('perm' : Perms , ..) > .
eq < cloudB | ('buffer' : Msg , 'perm' : (deviceA , Perms) , ..) > $ UserX 'release' cloudB 
= < cloudB | ('buffer' : nils , 'perm' : (deviceA , Perms) , ..) > $ cloudB 'deliver' deviceA | (Msg) .
eq < deviceA | ('on' : false , ..) > $ cloudB 'deliver' deviceA | ('toggle') 
= < deviceA | ('on' : true , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Msg : Qid .
vars Perms : Set .
vars UserX : User .
vars MessageA : Qid .
vars Rest : Set .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'publish' cloudB | ('toggle') .
eq ev2(UserX) = $ cloudB 'revokePermission' cloudB | (UserX) .
eq ev3(UserX) = $ UserX 'release' cloudB .
*** transitions
rl [rev1]: E @ S < UserX | (..) > 
=> ep: ev1(UserX) @ S < UserX | (..) > .
rl [rev2]: E @ S < cloudB | ('perm' : (UserX , Rest) , ..) > 
=> ep: ev2(UserX) @ S < cloudB | ('perm' : (UserX , Rest) , ..) > .
rl [rev3]: E @ S < UserX | (..) > 
=> ep: ev3(UserX) @ S < UserX | (..) > .

endm
