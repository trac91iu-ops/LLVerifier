load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | ('key' : nils , 'near' : deviceA) > < userC | ('key' : nils , 'near' : nils) > < deviceA | ('key' : 'keyA') > < cloudA | (deviceA : ('key' : 'keyA' , 'owner' : nils)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars K : Qid .
vars Near : Set .
vars UserX : User .
*** policy
eq < UserX | ('near' : Near , 'key' : nils , ..) > $ UserX 'approach' deviceA 
= < UserX | ('near' : deviceA , 'key' : nils , ..) > .
eq < UserX | ('near' : Near , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > .
eq < deviceA | ('key' : K , ..) > $ UserX 'pressButton' deviceA 
= < deviceA | ('key' : K , ..) > $ deviceA 'sendKey' UserX | (K) .
eq < UserX | ('key' : nils , ..) > $ deviceA 'sendKey' UserX | (K) 
= < UserX | ('key' : K , ..) > .
eq < cloudA | (deviceA : ('key' : K , 'owner' : nils , ..) , ...) > $ UserX 'bind' cloudA | (deviceA ; K) 
= < cloudA | (deviceA : ('key' : K , 'owner' : UserX , ..) , ...) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars K : Qid .
vars Near : Set .
vars UserX : User .
vars MessageA : Qid .
vars Rest : Set .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceA .
eq ev2(UserX) = $ UserX 'leave' deviceA .
eq ev3(UserX) = $ UserX 'pressButton' deviceA .
eq ev4(UserX, K) = $ UserX 'bind' cloudA | (deviceA ; K) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : (deviceA , Rest) , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : (deviceA , Rest) , ..) > .
rl [rev3]: E @ S < UserX | ('near' : (deviceA , Rest) , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : (deviceA , Rest) , ..) > .
rl [rev4]: E @ S < UserX | ('key' : K , ..) > < deviceA | (...) > 
=> ep: ev4(UserX, K) @ S < UserX | ('key' : K , ..) > < deviceA | (...) > .

endm
