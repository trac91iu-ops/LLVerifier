load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < deviceB | ('key' : 'keyB') > < userA | ('near' : deviceB , 'msg' : nils) > < userC | ('near' : nils , 'msg' : nils) > < cloudA | (deviceB : ('owner' : nils , 'key' : 'keyB')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars FreshR : Qid .
vars Key : Qid .
vars M : Item .
vars Owners : Set .
vars R : Qid .
vars Rest : Set .
vars UserX : User .
*** policy
eq < system | ('counter' : N , ..) > < deviceB | ('key' : Key , ...) > $ UserX 'pressButton' deviceB 
= < system | ('counter' : N + 1 , ..) > < deviceB | ('key' : Key , ...) > $ deviceB 'sendEncryptedText' UserX | (encrypt(randomStr('R', N), Key)) .
eq < UserX | ('msg' : nils , ..) > $ deviceB 'sendEncryptedText' UserX | (M) 
= < UserX | ('msg' : M , ..) > .
eq < cloudA | (deviceB : ('key' : Key , 'owner' : Owners , ..) , ...) > $ UserX 'bindDevice' cloudA | (deviceB ; encrypt(R, Key)) 
= < cloudA | (deviceB : ('key' : Key , 'owner' : (Owners , UserX) , ..) , ...) > .
eq < cloudA | (deviceB : ('owner' : (UserX , Rest) , ..) , ...) > $ UserX 'resetDevice' cloudA | (deviceB) 
= < cloudA | (deviceB : ('owner' : (nils , Rest) , ..) , ...) > .
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : deviceB , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars FreshR : Qid .
vars Key : Qid .
vars M : Item .
vars Owners : Set .
vars R : Qid .
vars Rest : Set .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Qid Qid -> Event .
ops ev3 : User Qid -> Event .
ops ev4 : User -> Event .
ops ev5 : User -> Event .
ops ev6 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'pressButton' deviceB .
eq ev2(UserX, R, Key) = $ UserX 'bindDevice' cloudA | (deviceB ; encrypt(R, Key)) .
eq ev3(UserX, MessageA) = $ UserX 'bindDevice' cloudA | (MessageA) .
eq ev4(UserX) = $ UserX 'resetDevice' cloudA | (deviceB) .
eq ev5(UserX) = $ UserX 'approach' deviceB .
eq ev6(UserX) = $ UserX 'leave' deviceB .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | ('msg' : MessageA , ..) > 
=> ep: ev3(UserX, MessageA) @ S < UserX | ('msg' : MessageA , ..) > .
rl [rev4]: E @ S < UserX | (..) > 
=> ep: ev4(UserX) @ S < UserX | (..) > .
rl [rev5]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev6]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev6(UserX) @ S < UserX | ('near' : deviceB , ..) > .

endm
