load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < userA | ('signedKey' : nils , 'near' : deviceA , 'key' : nils) > < userC | ('signedKey' : nils , 'near' : nils , 'key' : nils) > < deviceA | ('key' : '' , 'trusted' : (userA) , 'secret' : 'secret') > < cloudA | (deviceA : ('trusted' : (userA)) , 'secret' : 'secret') > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars FreshKey : Qid .
vars Key : Qid .
vars M : Item .
vars OldKey : Qid .
vars Rest : Set .
vars Secret : Qid .
vars UserX : User .
vars UserY : User .
vars Users : Set .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceA 
= < UserX | ('near' : deviceA , ..) > .
eq < UserX | ('near' : deviceA , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > .
eq < system | ('counter' : N , ..) > < UserX | ('key' : nils , ...) > < deviceA | ('key' : OldKey , ....) > $ UserX 'requestKey' deviceA 
= < system | ('counter' : N + 1 , ..) > < UserX | ('key' : randomStr('Key', N) , ...) > < deviceA | ('key' : randomStr('Key', N) , ....) > .
eq < cloudA | ('secret' : Secret , deviceA : ('trusted' : (UserX , Rest) , ..) , ...) > $ UserX 'signKey' cloudA | (deviceA ; Key) 
= < cloudA | ('secret' : Secret , deviceA : ('trusted' : (UserX , Rest) , ..) , ...) > $ cloudA 'sendSignedKey' UserX | (deviceA ; encrypt(Key, Secret)) .
eq < UserX | ('signedKey' : nils , ..) > $ cloudA 'sendSignedKey' UserX | (deviceA ; M) 
= < UserX | ('signedKey' : M , ..) > .
eq < UserX | ('signedKey' : encrypt(Key, Secret) , ..) > < deviceA | ('key' : Key , 'secret' : Secret , 'trusted' : Users , ...) > $ UserX 'bind' deviceA | (encrypt(Key, Secret)) 
= < UserX | ('signedKey' : encrypt(Key, Secret) , ..) > < deviceA | ('key' : Key , 'secret' : Secret , 'trusted' : (UserX , Users) , ...) > .
eq < cloudA | (deviceA : ('trusted' : Users , ..) , ...) > $ UserX 'share' cloudA | (deviceA ; UserY) 
= < cloudA | (deviceA : ('trusted' : (UserY , Users) , ..) , ...) > .
eq < cloudA | (deviceA : ('trusted' : (UserX , UserY , Rest) , ..) , ...) > $ UserX 'revoke' cloudA | (deviceA ; UserY) 
= < cloudA | (deviceA : ('trusted' : (UserX , Rest) , ..) , ...) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars FreshKey : Qid .
vars Key : Qid .
vars M : Item .
vars OldKey : Qid .
vars Rest : Set .
vars Secret : Qid .
vars UserX : User .
vars UserY : User .
vars Users : Set .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid -> Event .
ops ev5 : User Qid Qid -> Event .
ops ev6 : User Qid -> Event .
ops ev7 : User User -> Event .
ops ev8 : User User -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceA .
eq ev2(UserX) = $ UserX 'leave' deviceA .
eq ev3(UserX) = $ UserX 'requestKey' deviceA .
eq ev4(UserX, Key) = $ UserX 'signKey' cloudA | (deviceA ; Key) .
eq ev5(UserX, Key, Secret) = $ UserX 'bind' deviceA | (encrypt(Key, Secret)) .
eq ev6(UserX, MessageA) = $ UserX 'bind' deviceA | (MessageA) .
eq ev7(UserX, UserY) = $ UserX 'share' cloudA | (deviceA ; UserY) .
eq ev8(UserX, UserY) = $ UserX 'revoke' cloudA | (deviceA ; UserY) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > < deviceA | (...) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > < deviceA | (...) > .
rl [rev2]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev4]: E @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > 
=> ep: ev4(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > .
rl [rev6]: E @ S < UserX | ('near' : deviceA , 'signedKey' : MessageA , ..) > 
=> ep: ev6(UserX, MessageA) @ S < UserX | ('near' : deviceA , 'signedKey' : MessageA , ..) > .
rl [rev7]: E @ S < UserX | (..) > < UserY | (...) > < deviceA | (....) > 
=> ep: ev7(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > < deviceA | (....) > .
rl [rev8]: E @ S < UserX | (..) > < UserY | (...) > 
=> ep: ev8(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > .

endm
