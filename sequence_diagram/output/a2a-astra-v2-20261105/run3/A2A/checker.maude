load rules .
load model-checker .
mod PREDS is
pr TRANSITION * (sort State to State') .
including SATISFACTION .
pr BOOL-OPS .

subsort Vertex < State .

vars N : Nat .
vars Rest : Set .
var Vtx : Vertex .
var P : Prop .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .

ops boundReached sp : -> Prop .
ops attackerReadsVictimData victimContextTampered : -> Prop .

*** property template: CTX-isolation (attacker = clientB)
*** attackerReadsVictimData : the attacker holds a message that the victim sent
*** victimContextTampered : the victim's context holds a message that the attacker sent

eq E @ S < clientB | ('receivedHistory' : ('msgA' , Rest) , ..) > |= attackerReadsVictimData = true .
eq E @ S < serverA | ('contexts' : ('id' : 'ctxX' , 'history' : ('msgB' , Rest) , ..) , ...) > |= victimContextTampered = true .

*** predefined
ceq E @ S |= sp = true if subject(E) == system . *** system performs actions
ceq E @ S < system | 'counter' : N , ... > |= boundReached = true if N >= 5 . *** Max turns number
ceq E @ S < system | 'time' : N , ... > |= boundReached = true if N >= 3 . *** time pass

eq Vtx |= P = false [owise] .
endm

mod CHECK is
pr PREDS .
including MODEL-CHECKER .

ops spec basic safety : -> Prop .

eq basic = [] (~ boundReached) .

eq safety = <> (attackerReadsVictimData \/ victimContextTampered) .

*** security property specification
eq spec = O ~ (safety /\ basic) .
endm

load ../lib/postProcess .
