load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < deviceB | ('key' : 'deviceKey') > < userA | ('near' : deviceB , 'key' : nils) > < userC | ('near' : nils , 'key' : nils) > < cloudA | (userA : ('deviceList' : nils , 'members' : nils) , userC : ('deviceList' : nils , 'members' : nils) , deviceB : ('bindingKey' : 'deviceKey' , 'owners' : nils)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Key : Qid .
vars Members : Set .
vars Owners : Set .
vars Rest : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < deviceB | ('key' : Key , ..) > $ UserX 'pressButton' deviceB 
= < deviceB | ('key' : Key , ..) > $ deviceB 'sendKey' UserX | (Key) .
eq < UserX | ('key' : nils , ..) > $ deviceB 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < UserX | ('key' : Key , ..) > < cloudA | (deviceB : ('bindingKey' : Key , 'owners' : nils , ...) , ....) > $ UserX 'bind' cloudA | (deviceB ; Key) 
= < UserX | ('key' : Key , ..) > < cloudA | (deviceB : ('bindingKey' : Key , 'owners' : (UserX) , ...) , ....) > .
eq < UserX | ('key' : Key , ..) > < cloudA | (deviceB : ('bindingKey' : Key , 'owners' : (UserX , Rest) , ...) , ....) > $ UserX 'bind' cloudA | (deviceB ; Key) 
= < UserX | ('key' : Key , ..) > < cloudA | (deviceB : ('bindingKey' : Key , 'owners' : (UserX , Rest) , ...) , ....) > .
eq < UserX | ('key' : Key , ..) > < cloudA | (deviceB : ('bindingKey' : Key , 'owners' : Owners , ...) , ....) > $ UserX 'bind' cloudA | (deviceB ; Key) 
= < UserX | ('key' : Key , ..) > < cloudA | (deviceB : ('bindingKey' : Key , 'owners' : (UserX , Owners) , ...) , ....) > .
eq < cloudA | (UserX : ('deviceList' : nils , 'members' : nils , ..) , ...) > $ UserX 'invite' cloudA | (UserY) 
= < cloudA | (UserX : ('deviceList' : nils , 'members' : (UserY) , ..) , ...) > .
eq < cloudA | (UserX : ('deviceList' : nils , 'members' : (UserY , Rest) , ..) , ...) > $ UserX 'invite' cloudA | (UserY) 
= < cloudA | (UserX : ('deviceList' : nils , 'members' : (UserY , Rest) , ..) , ...) > .
eq < cloudA | (UserX : ('deviceList' : nils , 'members' : Members , ..) , ...) > $ UserX 'invite' cloudA | (UserY) 
= < cloudA | (UserX : ('deviceList' : nils , 'members' : (UserY , Members) , ..) , ...) > .
eq < cloudA | (UserX : ('deviceList' : nils , 'members' : (UserY , Rest) , ..) , ...) > $ UserX 'removeMember' cloudA | (UserY) 
= < cloudA | (UserX : ('deviceList' : nils , 'members' : Rest , ..) , ...) > .
eq < cloudA | (UserX : ('deviceList' : nils , 'members' : Members , ..) , ...) > $ UserX 'removeMember' cloudA | (UserY) 
= < cloudA | (UserX : ('deviceList' : nils , 'members' : Members , ..) , ...) > .
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : deviceB , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Key : Qid .
vars Members : Set .
vars Owners : Set .
vars Rest : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Qid -> Event .
ops ev3 : User Qid -> Event .
ops ev4 : User User -> Event .
ops ev5 : User User -> Event .
ops ev6 : User -> Event .
ops ev7 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'pressButton' deviceB .
eq ev2(UserX, Key) = $ deviceB 'sendKey' UserX | (Key) .
eq ev3(UserX, Key) = $ UserX 'bind' cloudA | (deviceB ; Key) .
eq ev4(UserX, UserY) = $ UserX 'invite' cloudA | (UserY) .
eq ev5(UserX, UserY) = $ UserX 'removeMember' cloudA | (UserY) .
eq ev6(UserX) = $ UserX 'approach' deviceB .
eq ev7(UserX) = $ UserX 'leave' deviceB .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > 
=> ep: ev3(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > .
rl [rev4]: E @ S < UserX | (..) > < UserY | (...) > 
=> ep: ev4(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > .
rl [rev5]: E @ S < UserX | (..) > < UserY | (...) > 
=> ep: ev5(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > .
rl [rev6]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev6(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev7]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev7(UserX) @ S < UserX | ('near' : deviceB , ..) > .

endm
