load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < deviceB | ('key' : nils , 'buttonPressed' : false) > < userA | ('near' : deviceB , 'key' : ('keyA')) > < userC | ('near' : nils , 'key' : ('keyC')) > < cloudA | ('owner' : nils , deviceB : ('bindingKey' : 'empty')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Key : Qid .
vars OldKey : Set .
vars UserX : User .
*** policy
eq < deviceA | ('buttonPressed' : false , ..) > $ UserX 'pressButton' deviceA 
= < deviceA | ('buttonPressed' : true , ..) > .
eq < deviceA | ('buttonPressed' : true , ..) > $ UserX 'pressButton' deviceA 
= < deviceA | ('buttonPressed' : true , ..) > .
eq < UserX | ('key' : Key , ..) > < deviceA | ('buttonPressed' : true , 'key' : OldKey , ...) > $ UserX 'setKey' deviceA | (Key) 
= < UserX | ('key' : Key , ..) > < deviceA | ('buttonPressed' : false , 'key' : Key , ...) > $ deviceA 'sendBindingKey' cloudA | (Key) .
eq < cloudA | (deviceA : ('bindingKey' : OldKey , ..) , ...) > $ deviceA 'sendBindingKey' cloudA | (Key) 
= < cloudA | (deviceA : ('bindingKey' : Key , ..) , ...) > .
eq < deviceA | ('buttonPressed' : true , 'key' : Key , ..) > $ UserX 'getKey' deviceA 
= < deviceA | ('buttonPressed' : false , 'key' : Key , ..) > $ deviceA 'sendKey' UserX | (Key) .
eq < UserX | ('key' : OldKey , ..) > $ deviceA 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < UserX | ('key' : Key , ..) > < cloudA | (deviceA : ('bindingKey' : Key , ...) , 'owner' : nils , ....) > $ UserX 'bindDevice' cloudA | (deviceA ; Key) 
= < UserX | ('key' : Key , ..) > < cloudA | (deviceA : ('bindingKey' : Key , ...) , 'owner' : UserX , ....) > .
eq < UserX | ('key' : Key , ..) > < cloudA | (deviceA : ('bindingKey' : Key , ...) , 'owner' : UserX , ....) > $ UserX 'resetDevice' cloudA | (deviceA ; Key) 
= < UserX | ('key' : Key , ..) > < cloudA | (deviceA : ('bindingKey' : 'empty' , ...) , 'owner' : nils , ....) > .
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceA 
= < UserX | ('near' : deviceA , ..) > .
eq < UserX | ('near' : deviceA , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Key : Qid .
vars OldKey : Set .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Qid -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid -> Event .
ops ev5 : User -> Event .
ops ev6 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'pressButton' deviceA .
eq ev2(UserX, Key) = $ UserX 'setKey' deviceA | (Key) .
eq ev3(UserX) = $ UserX 'getKey' deviceA .
eq ev4(UserX, Key) = $ UserX 'bindDevice' cloudA | (deviceA ; Key) .
eq ev5(UserX) = $ UserX 'approach' deviceA .
eq ev6(UserX) = $ UserX 'leave' deviceA .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceA , 'key' : Key , ..) > 
=> ep: ev2(UserX, Key) @ S < UserX | ('near' : deviceA , 'key' : Key , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev5]: E @ S < UserX | ('near' : nils , ..) > < deviceA | (...) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : nils , ..) > < deviceA | (...) > .
rl [rev6]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev6(UserX) @ S < UserX | ('near' : deviceA , ..) > .

endm
