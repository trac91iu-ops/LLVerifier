load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | ('key' : nils , 'near' : deviceB) > < userC | ('key' : nils , 'near' : nils) > < deviceB | ('online' : false , 'owner' : nils , 'key' : 'key1' , 'buttonPressed' : nils) > < cloudB | (deviceB : ('owner' : nils , 'key' : 'key1')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Button : Set .
vars Key : Qid .
vars Owner : User .
vars UserX : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : deviceB , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
eq < UserX | ('near' : deviceB , ..) > < deviceB | ('owner' : nils , 'online' : false , 'key' : Key , 'buttonPressed' : Button , ...) > $ UserX 'pressButton' deviceB 
= < UserX | ('near' : deviceB , ..) > < deviceB | ('owner' : nils , 'online' : true , 'key' : Key , 'buttonPressed' : true , ...) > $ deviceB 'sendKey' UserX | (Key) .
eq < UserX | ('key' : nils , ..) > $ deviceB 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < UserX | ('key' : Key , ..) > < deviceB | ('owner' : nils , 'online' : true , 'key' : Key , ...) > < cloudB | (deviceB : ('owner' : nils , 'key' : Key , ....) , .....) > $ UserX 'callAPI_bind' cloudB | (deviceB ; Key) 
= < UserX | ('key' : Key , ..) > < deviceB | ('owner' : UserX , 'online' : true , 'key' : Key , ...) > < cloudB | (deviceB : ('owner' : UserX , 'key' : Key , ....) , .....) > .
eq < UserX | ('key' : Key , ..) > < cloudB | (deviceB : ('owner' : UserX , ...) , ....) > $ UserX 'callAPI_reset' cloudB | (deviceB) 
= < UserX | ('key' : Key , ..) > < cloudB | (deviceB : ('owner' : nils , ...) , ....) > $ cloudB 'reset' deviceB .
eq < deviceB | ('online' : true , 'owner' : Owner , ..) > $ cloudB 'reset' deviceB 
= < deviceB | ('online' : false , 'owner' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Button : Set .
vars Key : Qid .
vars Owner : User .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid -> Event .
ops ev5 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceB .
eq ev2(UserX) = $ UserX 'leave' deviceB .
eq ev3(UserX) = $ UserX 'pressButton' deviceB .
eq ev4(UserX, Key) = $ UserX 'callAPI_bind' cloudB | (deviceB ; Key) .
eq ev5(UserX) = $ UserX 'callAPI_reset' cloudB | (deviceB) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev4]: E @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > 
=> ep: ev4(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > .
rl [rev5]: E @ S < UserX | ('key' : Key , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('key' : Key , ..) > .

endm
