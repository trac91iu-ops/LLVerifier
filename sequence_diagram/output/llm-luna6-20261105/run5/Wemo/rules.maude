load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < deviceB | ('exists' : false , 'buttonPressed' : false , 'key' : nils) > < cloudA | (userA : ('accountKey' : 'accountKeyA') , userC : ('accountKey' : 'accountKeyC') , deviceB : ('owner' : nils)) > < userA | ('near' : deviceB , 'knownDevices' : nils) > < userC | ('near' : nils , 'knownDevices' : nils) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Key : Qid .
vars KnownDevices : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < deviceA | ('buttonPressed' : false , ..) > $ UserX 'pressButton' deviceA 
= < deviceA | ('buttonPressed' : true , ..) > .
eq < cloudA | (UserX : ('accountKey' : Key , ..) , ...) > < deviceA | ('buttonPressed' : true , 'key' : nils , ....) > $ UserX 'sendKey' deviceA | (Key) 
= < cloudA | (UserX : ('accountKey' : Key , ..) , ...) > < deviceA | ('buttonPressed' : false , 'key' : Key , ....) > .
eq < UserX | ('knownDevices' : KnownDevices , ..) > < deviceA | ('key' : Key , ...) > $ UserX 'discover' deviceA 
= < UserX | ('knownDevices' : (KnownDevices , deviceA) , ..) > < deviceA | ('key' : Key , ...) > $ deviceA 'bind' cloudA | (Key) .
eq < cloudA | (UserY : ('accountKey' : Key , ..) , deviceA : ('owner' : nils , ...) , ....) > $ deviceA 'bind' cloudA | (Key) 
= < cloudA | (UserY : ('accountKey' : Key , ..) , deviceA : ('owner' : UserY , ...) , ....) > .
eq < UserX | ('near' : nils , ..) > < deviceA | ('exists' : true , ...) > $ UserX 'approach' deviceA 
= < UserX | ('near' : deviceA , ..) > < deviceA | ('exists' : true , ...) > .
eq < UserX | ('near' : deviceA , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Key : Qid .
vars KnownDevices : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Qid -> Event .
ops ev3 : User -> Event .
ops ev4 : User -> Event .
ops ev5 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'pressButton' deviceA .
eq ev2(UserX, Key) = $ UserX 'sendKey' deviceA | (Key) .
eq ev3(UserX) = $ UserX 'discover' deviceA .
eq ev4(UserX) = $ UserX 'approach' deviceA .
eq ev5(UserX) = $ UserX 'leave' deviceA .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceA , ..) > < cloudA | (UserX : ('accountKey' : Key , ...) , ....) > 
=> ep: ev2(UserX, Key) @ S < UserX | ('near' : deviceA , ..) > < cloudA | (UserX : ('accountKey' : Key , ...) , ....) > .
rl [rev3]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev4]: E @ S < UserX | ('near' : nils , ..) > < deviceA | ('exists' : true , ...) > 
=> ep: ev4(UserX) @ S < UserX | ('near' : nils , ..) > < deviceA | ('exists' : true , ...) > .
rl [rev5]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : deviceA , ..) > .

endm
