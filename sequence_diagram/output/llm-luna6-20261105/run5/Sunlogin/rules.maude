load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < deviceB | ('deviceKey' : 'deviceKeyA') > < userA | ('near' : deviceB , 'key' : nils) > < userC | ('near' : nils , 'key' : nils) > < cloudA | (deviceB : ('key' : 'deviceKeyA' , 'owner' : nils)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars DeviceKey : Qid .
vars UserX : User .
*** policy
eq < deviceB | ('deviceKey' : DeviceKey , ..) > $ UserX 'pressButton' deviceB 
= < deviceB | ('deviceKey' : DeviceKey , ..) > $ deviceB 'sendDeviceKey' UserX | (DeviceKey) .
eq < UserX | ('key' : nils , ..) > $ deviceB 'sendDeviceKey' UserX | (DeviceKey) 
= < UserX | ('key' : DeviceKey , ..) > .
eq < cloudA | (deviceB : ('key' : DeviceKey , 'owner' : nils , ..) , ...) > $ UserX 'bind' cloudA | (deviceB ; DeviceKey) 
= < cloudA | (deviceB : ('key' : DeviceKey , 'owner' : UserX , ..) , ...) > .
eq < UserX | ('near' : nils , 'key' : nils , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , 'key' : nils , ..) > .
eq < UserX | ('near' : deviceB , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars DeviceKey : Qid .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Qid -> Event .
ops ev3 : User -> Event .
ops ev4 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'pressButton' deviceB .
eq ev2(UserX, DeviceKey) = $ UserX 'bind' cloudA | (deviceB ; DeviceKey) .
eq ev3(UserX) = $ UserX 'approach' deviceB .
eq ev4(UserX) = $ UserX 'leave' deviceB .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev2]: E @ S < UserX | ('key' : DeviceKey , ..) > < deviceB | (...) > 
=> ep: ev2(UserX, DeviceKey) @ S < UserX | ('key' : DeviceKey , ..) > < deviceB | (...) > .
rl [rev3]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev4]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev4(UserX) @ S < UserX | ('near' : deviceB , ..) > .

endm
