load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < userA | ('storedMessage' : nils , 'near' : deviceB) > < userC | ('storedMessage' : nils , 'near' : nils) > < deviceB | ('key' : 'key') > < cloudA | (deviceB : ('owners' : nils , 'key' : 'key')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars FreshR : Qid .
vars Key : Qid .
vars Message : Item .
vars OldMessage : Item .
vars Owners : Set .
vars UserX : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceA 
= < UserX | ('near' : deviceA , ..) > .
eq < UserX | ('near' : deviceA , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > .
eq < system | ('counter' : N , ..) > < deviceA | ('key' : Key , ...) > $ UserX 'pressButton' deviceA 
= < system | ('counter' : N + 1 , ..) > < deviceA | ('key' : Key , ...) > $ deviceA 'sendMessage' UserX | (encrypt(randomStr('R', N), Key)) .
eq < UserX | ('storedMessage' : nils , ..) > $ deviceA 'sendMessage' UserX | (Message) 
= < UserX | ('storedMessage' : Message , ..) > .
eq < UserX | ('storedMessage' : OldMessage , ..) > $ deviceA 'sendMessage' UserX | (Message) 
= < UserX | ('storedMessage' : OldMessage , ..) > .
eq < system | ('counter' : N , ..) > < UserX | ('storedMessage' : encrypt(FreshR, Key) , ...) > < cloudA | (deviceA : ('key' : Key , 'owners' : Owners , ....) , .....) > $ UserX 'bind' cloudA | (deviceA ; encrypt(FreshR, Key)) 
= < system | ('counter' : N + 1 , ..) > < UserX | ('storedMessage' : encrypt(randomStr('R', N), Key) , ...) > < cloudA | (deviceA : ('key' : Key , 'owners' : (UserX , Owners) , ....) , .....) > .
eq < system | ('counter' : N , ..) > < UserX | ('storedMessage' : encrypt(FreshR, Key) , ...) > < cloudA | (deviceA : ('key' : Key , 'owners' : (UserX , Owners) , ....) , .....) > $ UserX 'bind' cloudA | (deviceA ; encrypt(FreshR, Key)) 
= < system | ('counter' : N + 1 , ..) > < UserX | ('storedMessage' : encrypt(randomStr('R', N), Key) , ...) > < cloudA | (deviceA : ('key' : Key , 'owners' : (UserX , Owners) , ....) , .....) > .
eq < cloudA | (deviceA : ('owners' : (UserX , Owners) , ..) , ...) > $ UserX 'reset' cloudA | (deviceA) 
= < cloudA | (deviceA : ('owners' : (UserX : (nils) , Owners) , ..) , ...) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars FreshR : Qid .
vars Key : Qid .
vars Message : Item .
vars OldMessage : Item .
vars Owners : Set .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User Nat Qid -> Event .
ops ev5 : User Qid -> Event .
ops ev6 : User Qid Qid -> Event .
ops ev7 : User Qid -> Event .
ops ev8 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceA .
eq ev2(UserX) = $ UserX 'leave' deviceA .
eq ev3(UserX) = $ UserX 'pressButton' deviceA .
eq ev4(UserX, N, Key) = $ deviceA 'sendMessage' UserX | (encrypt(randomStr('R', N), Key)) .
eq ev5(UserX, MessageA) = $ deviceA 'sendMessage' UserX | (MessageA) .
eq ev6(UserX, FreshR, Key) = $ UserX 'bind' cloudA | (deviceA ; encrypt(FreshR, Key)) .
eq ev7(UserX, MessageA) = $ UserX 'bind' cloudA | (MessageA) .
eq ev8(UserX) = $ UserX 'reset' cloudA | (deviceA) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev7]: E @ S < UserX | ('storedMessage' : MessageA , ..) > 
=> ep: ev7(UserX, MessageA) @ S < UserX | ('storedMessage' : MessageA , ..) > .
rl [rev8]: E @ S < UserX | (..) > 
=> ep: ev8(UserX) @ S < UserX | (..) > .

endm
