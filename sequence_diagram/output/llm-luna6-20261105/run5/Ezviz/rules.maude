load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | ('near' : deviceB , 'key' : nils) > < userC | ('near' : nils , 'key' : nils) > < deviceB | ('online' : false , 'key' : 'keyB') > < cloudA | (deviceB : ('owner' : nils , 'bindingKey' : 'keyB')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Key : Qid .
vars UserX : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : deviceB , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
eq < deviceB | ('online' : false , 'key' : Key , ..) > $ UserX 'pressButton' deviceB 
= < deviceB | ('online' : true , 'key' : Key , ..) > $ deviceB 'sendKey' UserX | (Key) .
eq < UserX | ('key' : nils , ..) > $ deviceB 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < UserX | ('key' : Key , ..) > < deviceB | ('online' : true , ...) > < cloudA | (deviceB : ('bindingKey' : Key , 'owner' : nils , ....) , .....) > $ UserX 'bind' cloudA | (Key) 
= < UserX | ('key' : Key , ..) > < deviceB | ('online' : true , ...) > < cloudA | (deviceB : ('bindingKey' : Key , 'owner' : UserX , ....) , .....) > .
eq < UserX | ('near' : deviceB , ..) > < cloudA | (deviceB : ('owner' : UserX , ...) , ....) > < deviceB | ('online' : false , .....) > $ UserX 'reset' cloudA | (deviceB) 
= < UserX | ('near' : deviceB , ..) > < cloudA | (deviceB : ('owner' : nils , ...) , ....) > < deviceB | ('online' : false , .....) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Key : Qid .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid -> Event .
ops ev5 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceB .
eq ev2(UserX) = $ UserX 'leave' deviceB .
eq ev3(UserX) = $ UserX 'pressButton' deviceB .
eq ev4(UserX, Key) = $ UserX 'bind' cloudA | (Key) .
eq ev5(UserX) = $ UserX 'reset' cloudA | (deviceB) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev4]: E @ S < UserX | ('key' : Key , ..) > 
=> ep: ev4(UserX, Key) @ S < UserX | ('key' : Key , ..) > .
rl [rev5]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : deviceB , ..) > .

endm
