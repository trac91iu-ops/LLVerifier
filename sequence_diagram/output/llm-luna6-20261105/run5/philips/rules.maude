load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('time' : 0 , 'counter' : 0) > < userA | ('knownSecrets' : nils , 'near' : deviceB) > < userC | ('knownSecrets' : nils , 'near' : nils) > < cloudA | (deviceB : ('tickets' : nils , 'owners' : nils)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars CurrentTime : Nat .
vars FreshSecret : Qid .
vars Issued : Nat .
vars Owner : User .
vars Secret : Qid .
vars Secrets : Set .
vars UserX : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceA 
= < UserX | ('near' : deviceA , ..) > .
eq < UserX | ('near' : deviceA , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > .
eq < system | ('counter' : N , ..) > < UserX | ('near' : deviceA , ...) > $ UserX 'pressButton' deviceA 
= < system | ('counter' : N + 1 , ..) > < UserX | ('near' : deviceA , ...) > $ deviceA 'uploadSecret' cloudA | (randomStr('Secret', N)) .
eq < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceA : ('tickets' : ((FreshSecret , CurrentTime)) , ...) , ....) > $ deviceA 'uploadSecret' cloudA | (FreshSecret) 
= < system | ('time' : CurrentTime , 'counter' : N + 1 , ..) > < cloudA | (deviceA : ('tickets' : ((randomStr('Secret', N) , CurrentTime) , ..) , ...) , ....) > .
ceq < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceA : ('tickets' : ((Secret , Issued) , ...) , ....) , .....) > $ UserX 'getKey' cloudA | (deviceA) 
= < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceA : ('tickets' : ((Secret , Issued) , ...) , ....) , .....) > $ cloudA 'sendSecret' UserX | (Secret) if Issued == CurrentTime .
eq < UserX | ('knownSecrets' : Secrets , ..) > $ cloudA 'sendSecret' UserX | (Secret) 
= < UserX | ('knownSecrets' : (Secrets , Secret) , ..) > .
eq < UserX | ('knownSecrets' : (Secret , ..) , ...) > $ UserX 'bind' cloudA | (deviceA ; Secret) 
= < UserX | ('knownSecrets' : (Secret , ..) , ...) > .
eq < cloudA | (deviceA : ('tickets' : ((Secret , Issued) , ..) , 'owners' : nils , ...) , ....) > $ UserX 'bind' cloudA | (deviceA ; Secret) 
= < cloudA | (deviceA : ('tickets' : ((Secret , Issued) , ..) , 'owners' : (UserX) , ...) , ....) > .
eq < UserX | ('knownSecrets' : (Secret , ..) , ...) > $ UserX 'join' cloudA | (deviceA ; Secret) 
= < UserX | ('knownSecrets' : (Secret , ..) , ...) > .
eq < cloudA | (deviceA : ('tickets' : ((Secret , Issued) , ..) , 'owners' : (Owner , ...) , ....) , .....) > $ UserX 'join' cloudA | (deviceA ; Secret) 
= < cloudA | (deviceA : ('tickets' : ((Secret , Issued) , ..) , 'owners' : (Owner , UserX , ...) , ....) , .....) > .
ceq < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceA : ('tickets' : ((Secret , Issued) , ...) , ....) , .....) > 
= < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceA : ('tickets' : nils , ....) , .....) > if CurrentTime - Issued > 2 .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars CurrentTime : Nat .
vars FreshSecret : Qid .
vars Issued : Nat .
vars Owner : User .
vars Secret : Qid .
vars Secrets : Set .
vars UserX : User .
vars MessageA : Qid .
vars Rest : Set .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : Nat -> Event .
ops ev5 : User -> Event .
ops ev6 : User Qid -> Event .
ops ev7 : User Qid -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceA .
eq ev2(UserX) = $ UserX 'leave' deviceA .
eq ev3(UserX) = $ UserX 'pressButton' deviceA .
eq ev4(N) = $ deviceA 'uploadSecret' cloudA | (randomStr('Secret', N)) .
eq ev5(UserX) = $ UserX 'getKey' cloudA | (deviceA) .
eq ev6(UserX, Secret) = $ UserX 'bind' cloudA | (deviceA ; Secret) .
eq ev7(UserX, Secret) = $ UserX 'join' cloudA | (deviceA ; Secret) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev5]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev6]: E @ S < UserX | ('knownSecrets' : Secret , ..) > 
=> ep: ev6(UserX, Secret) @ S < UserX | ('knownSecrets' : Secret , ..) > .
rl [rev6]: E @ S < UserX | ('knownSecrets' : (Secret , Rest) , ..) > 
=> ep: ev6(UserX, Secret) @ S < UserX | ('knownSecrets' : (Secret , Rest) , ..) > .
rl [rev7]: E @ S < UserX | ('knownSecrets' : Secret , ..) > 
=> ep: ev7(UserX, Secret) @ S < UserX | ('knownSecrets' : Secret , ..) > .
rl [rev7]: E @ S < UserX | ('knownSecrets' : (Secret , Rest) , ..) > 
=> ep: ev7(UserX, Secret) @ S < UserX | ('knownSecrets' : (Secret , Rest) , ..) > .
rl [rtp]: E @ S < system | ('time' : N , .. ) >
=> ep: timepass @ S < system | ('time' : (N + 1) , .. ) > .


endm
