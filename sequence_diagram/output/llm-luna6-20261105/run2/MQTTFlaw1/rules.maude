load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | (nils) > < userC | (nils) > < cloudB | (deviceB : ('permission' : true) , 'buffer' : nils , userA : ('permission' : true) , userC : ('permission' : false)) > < deviceA | ('on' : false) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Message : Qid .
vars UserX : User .
*** policy
eq < UserX | (..) > < cloudB | (UserX : ('permission' : true , ...) , 'buffer' : nils , ....) > $ UserX 'publishToggle' cloudB 
= < UserX | (..) > < cloudB | (UserX : ('permission' : true , ...) , 'buffer' : 'toggle' , ....) > $ cloudB 'acknowledge' UserX .
eq < cloudB | (UserX : ('permission' : true , ..) , ...) > $ cloudB 'revokePermission' cloudB 
= < cloudB | (UserX : ('permission' : false , ..) , ...) > .
eq < UserX | (..) > < cloudB | ('buffer' : Message , deviceA : ('permission' : true , ...) , ....) > $ UserX 'releaseBufferedMessage' cloudB 
= < UserX | (..) > < cloudB | ('buffer' : nils , deviceA : ('permission' : true , ...) , ....) > $ cloudB 'publish' deviceA | (Message) .
eq < deviceA | ('on' : false , ..) > $ cloudB 'publish' deviceA | ('toggle') 
= < deviceA | ('on' : true , ..) > .
eq < deviceA | ('on' : true , ..) > $ cloudB 'publish' deviceA | ('toggle') 
= < deviceA | ('on' : true , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Message : Qid .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 :  -> Event .
ops ev3 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'publishToggle' cloudB .
eq ev2 = $ cloudB 'revokePermission' cloudB .
eq ev3(UserX) = $ UserX 'releaseBufferedMessage' cloudB .
*** transitions
rl [rev1]: E @ S < UserX | (..) > 
=> ep: ev1(UserX) @ S < UserX | (..) > .
rl [rev2]: E @ S < cloudB | (UserX : ('permission' : true , ..) , ...) > 
=> ep: ev2(cloudB) @ S < cloudB | (UserX : ('permission' : true , ..) , ...) > .
rl [rev3]: E @ S < UserX | (..) > 
=> ep: ev3(UserX) @ S < UserX | (..) > .

endm
