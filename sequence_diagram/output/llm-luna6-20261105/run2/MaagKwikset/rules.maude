load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < userA | ('near' : deviceB , 'signedKey' : nils , 'key' : nils) > < userC | ('near' : nils , 'signedKey' : nils , 'key' : nils) > < deviceB | ('key' : '' , 'trusted' : (userA) , 'secret' : 'secretA') > < cloudA | (deviceB : ('trusted' : (userA) , 'secret' : 'secretA')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars DeviceKey : Qid .
vars FreshKeyA : Qid .
vars Key : Qid .
vars Rest : Set .
vars Secret : Qid .
vars SignedKey : Item .
vars TrustedUsers : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < UserX | ('near' : nils , ..) > < deviceA | ('key' : DeviceKey , ...) > $ UserX 'approach' deviceA 
= < UserX | ('near' : deviceA , ..) > < deviceA | ('key' : DeviceKey , ...) > .
eq < UserX | ('near' : deviceA , ..) > < deviceA | ('key' : DeviceKey , ...) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > < deviceA | ('key' : DeviceKey , ...) > .
eq < system | ('counter' : N , ..) > < UserX | ('key' : nils , ...) > < deviceA | ('key' : DeviceKey , ....) > $ UserX 'requestKey' deviceA 
= < system | ('counter' : N + 1 , ..) > < UserX | ('key' : randomStr('KeyA', N) , ...) > < deviceA | ('key' : randomStr('KeyA', N) , ....) > .
eq < cloudA | (deviceA : ('trusted' : (UserX , Rest) , 'secret' : Secret , ..) , ...) > $ UserX 'signKey' cloudA | (deviceA ; Key) 
= < cloudA | (deviceA : ('trusted' : (UserX , Rest) , 'secret' : Secret , ..) , ...) > $ cloudA 'signedKey' UserX | (deviceA ; encrypt(Key, Secret)) .
eq < UserX | ('signedKey' : nils , ..) > $ cloudA 'signedKey' UserX | (deviceA ; SignedKey) 
= < UserX | ('signedKey' : SignedKey , ..) > .
ceq < UserX | ('near' : deviceA , 'signedKey' : SignedKey , ..) > < deviceA | ('key' : Key , 'secret' : Secret , 'trusted' : TrustedUsers , ...) > $ UserX 'bind' deviceA | (SignedKey) 
= < UserX | ('near' : deviceA , 'signedKey' : SignedKey , ..) > < deviceA | ('key' : Key , 'secret' : Secret , 'trusted' : (UserX , TrustedUsers) , ...) > if SignedKey == encrypt(Key, Secret) .
eq < cloudA | (deviceA : ('trusted' : TrustedUsers , ..) , ...) > $ UserX 'shareAccess' cloudA | (deviceA ; UserY) 
= < cloudA | (deviceA : ('trusted' : (UserY , TrustedUsers) , ..) , ...) > .
ceq < cloudA | (deviceA : ('trusted' : (UserX , UserY , Rest) , ..) , ...) > $ UserX 'revokeAccess' cloudA | (deviceA ; UserY) 
= < cloudA | (deviceA : ('trusted' : (UserX , Rest) , ..) , ...) > if UserX =/= UserY .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars DeviceKey : Qid .
vars FreshKeyA : Qid .
vars Key : Qid .
vars Rest : Set .
vars Secret : Qid .
vars SignedKey : Item .
vars TrustedUsers : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid -> Event .
ops ev5 : User Item -> Event .
ops ev6 : User Item -> Event .
ops ev7 : User User -> Event .
ops ev8 : User User -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceA .
eq ev2(UserX) = $ UserX 'leave' deviceA .
eq ev3(UserX) = $ UserX 'requestKey' deviceA .
eq ev4(UserX, Key) = $ UserX 'signKey' cloudA | (deviceA ; Key) .
eq ev5(UserX, SignedKey) = $ cloudA 'signedKey' UserX | (deviceA ; SignedKey) .
eq ev6(UserX, SignedKey) = $ UserX 'bind' deviceA | (SignedKey) .
eq ev7(UserX, UserY) = $ UserX 'shareAccess' cloudA | (deviceA ; UserY) .
eq ev8(UserX, UserY) = $ UserX 'revokeAccess' cloudA | (deviceA ; UserY) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > < deviceA | (...) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > < deviceA | (...) > .
rl [rev2]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev4]: E @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > 
=> ep: ev4(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > .
rl [rev6]: E @ S < UserX | ('near' : deviceA , 'signedKey' : SignedKey , ..) > 
=> ep: ev6(UserX, SignedKey) @ S < UserX | ('near' : deviceA , 'signedKey' : SignedKey , ..) > .
rl [rev7]: E @ S < UserX | (..) > < UserY | (...) > < deviceA | (....) > 
=> ep: ev7(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > < deviceA | (....) > .
rl [rev8]: E @ S < UserX | (..) > < UserY | (...) > 
=> ep: ev8(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > .

endm
