load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | ('key' : nils , 'near' : deviceB) > < userC | ('key' : nils , 'near' : nils) > < deviceB | ('key' : 'keyB') > < cloudA | (deviceB : ('owner' : nils , 'key' : 'keyB')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars CloudX : Cloud .
vars DeviceX : Device .
vars Key : Qid .
vars UserX : User .
*** policy
eq < UserX | ('near' : nils , 'key' : nils , ..) > $ UserX 'approach' DeviceX 
= < UserX | ('near' : DeviceX , 'key' : nils , ..) > .
eq < UserX | ('near' : DeviceX , ..) > $ UserX 'leave' DeviceX 
= < UserX | ('near' : nils , ..) > .
eq < DeviceX | ('key' : Key , ..) > $ UserX 'pressButton' DeviceX 
= < DeviceX | ('key' : Key , ..) > $ DeviceX 'sendKey' UserX | (Key) .
eq < UserX | ('key' : nils , ..) > $ DeviceX 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < UserX | ('key' : Key , ..) > < DeviceX | (...) > < CloudX | (DeviceX : ('key' : Key , 'owner' : nils , ....) , .....) > $ UserX 'bind' CloudX | (DeviceX ; Key) 
= < UserX | ('key' : Key , ..) > < DeviceX | (...) > < CloudX | (DeviceX : ('key' : Key , 'owner' : UserX , ....) , .....) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars CloudX : Cloud .
vars DeviceX : Device .
vars Key : Qid .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User Device -> Event .
ops ev2 : User Device -> Event .
ops ev3 : User Device -> Event .
ops ev4 : User Cloud Device Qid -> Event .
*** events
eq ev1(UserX, DeviceX) = $ UserX 'approach' DeviceX .
eq ev2(UserX, DeviceX) = $ UserX 'leave' DeviceX .
eq ev3(UserX, DeviceX) = $ UserX 'pressButton' DeviceX .
eq ev4(UserX, CloudX, DeviceX, Key) = $ UserX 'bind' CloudX | (DeviceX ; Key) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX, deviceB) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : DeviceX , ..) > 
=> ep: ev2(UserX, DeviceX) @ S < UserX | ('near' : DeviceX , ..) > .
rl [rev3]: E @ S < UserX | ('near' : DeviceX , ..) > 
=> ep: ev3(UserX, DeviceX) @ S < UserX | ('near' : DeviceX , ..) > .
rl [rev4]: E @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > < cloudB | (....) > 
=> ep: ev4(UserX, cloudB, deviceB, Key) @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > < cloudB | (....) > .

endm
