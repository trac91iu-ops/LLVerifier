load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | ('near' : deviceB , 'key' : nils) > < userC | ('near' : nils , 'key' : nils) > < deviceB | ('key' : 'deviceKey') > < cloudA | (deviceB : ('key' : 'deviceKey' , 'owner' : nils)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Cloud : Cloud .
vars Device : Device .
vars Key : Qid .
vars UserX : User .
*** policy
eq < UserX | ('near' : Device , ..) > < Device | ('key' : Key , ...) > $ UserX 'pressButton' Device 
= < UserX | ('near' : Device , ..) > < Device | ('key' : Key , ...) > $ Device 'sendKey' UserX | (Key) .
eq < UserX | ('key' : nils , ..) > $ Device 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < UserX | ('key' : Key , ..) > < Device | (...) > < Cloud | (Device : ('key' : Key , 'owner' : nils , ....) , .....) > $ UserX 'bind' Cloud | (Device ; Key) 
= < UserX | ('key' : Key , ..) > < Device | (...) > < Cloud | (Device : ('key' : Key , 'owner' : UserX , ....) , .....) > .
eq < UserX | ('near' : nils , 'key' : nils , ..) > $ UserX 'approach' Device 
= < UserX | ('near' : Device , 'key' : nils , ..) > .
eq < UserX | ('near' : Device , ..) > $ UserX 'leave' Device 
= < UserX | ('near' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Cloud : Cloud .
vars Device : Device .
vars Key : Qid .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User Device -> Event .
ops ev2 : User Cloud Device Qid -> Event .
ops ev3 : User Device -> Event .
ops ev4 : User Device -> Event .
*** events
eq ev1(UserX, Device) = $ UserX 'pressButton' Device .
eq ev2(UserX, Cloud, Device, Key) = $ UserX 'bind' Cloud | (Device ; Key) .
eq ev3(UserX, Device) = $ UserX 'approach' Device .
eq ev4(UserX, Device) = $ UserX 'leave' Device .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : Device , ..) > 
=> ep: ev1(UserX, Device) @ S < UserX | ('near' : Device , ..) > .
rl [rev2]: E @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > 
=> ep: ev2(UserX, cloudB, deviceB, Key) @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > .
rl [rev3]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev3(UserX, deviceB) @ S < UserX | ('near' : nils , ..) > .
rl [rev4]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev4(UserX, deviceB) @ S < UserX | ('near' : deviceB , ..) > .

endm
