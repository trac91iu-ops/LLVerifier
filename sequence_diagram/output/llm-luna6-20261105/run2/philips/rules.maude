load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('time' : 0 , 'counter' : 0) > < userA | ('knownSecrets' : nils , 'near' : deviceB) > < userC | ('knownSecrets' : nils , 'near' : nils) > < deviceB | (nils) > < cloudA | (deviceB : ('tickets' : nils , 'owner' : nils)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars CurrentTime : Nat .
vars FreshSecret : Qid .
vars Issued : Nat .
vars Owner : User .
vars Secret : Qid .
vars Secrets : Set .
vars Tickets : Set .
vars UserX : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : deviceB , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
eq < system | ('counter' : N , ..) > < UserX | ('near' : deviceB , ...) > < deviceB | (....) > $ UserX 'pressButton' deviceB 
= < system | ('counter' : N + 1 , ..) > < UserX | ('near' : deviceB , ...) > < deviceB | (....) > $ deviceB 'uploadSecret' cloudA | (randomStr('Secret', N)) .
eq < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceB : ('tickets' : Tickets , ...) , ....) > $ deviceB 'uploadSecret' cloudA | (Secret) 
= < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceB : ('tickets' : ((Secret , CurrentTime) , Tickets) , ...) , ....) > .
ceq < system | ('time' : CurrentTime , 'counter' : N , ..) > < UserX | ('near' : deviceB , ...) > < cloudA | (deviceB : ('tickets' : ((Secret , Issued) , ....) , .....) , ......) > $ UserX 'getKey' cloudA 
= < system | ('time' : CurrentTime , 'counter' : N , ..) > < UserX | ('near' : deviceB , ...) > < cloudA | (deviceB : ('tickets' : ((Secret , Issued) , ....) , .....) , ......) > $ cloudA 'sendSecret' UserX | (Secret) if Issued == CurrentTime .
eq < UserX | ('knownSecrets' : Secrets , ..) > $ cloudA 'sendSecret' UserX | (Secret) 
= < UserX | ('knownSecrets' : (Secret , Secrets) , ..) > .
eq < UserX | ('knownSecrets' : (Secret , ..) , ...) > < cloudA | (deviceB : ('owner' : nils , 'tickets' : ((Secret , Issued) , ....) , .....) , ......) > $ UserX 'bind' cloudA | (deviceB ; Secret) 
= < UserX | ('knownSecrets' : (Secret , ..) , ...) > < cloudA | (deviceB : ('owner' : UserX , 'tickets' : ((Secret , Issued) , ....) , .....) , ......) > .
eq < UserX | ('knownSecrets' : (Secret , ..) , ...) > < cloudA | (deviceB : ('owner' : Owner , 'tickets' : ((Secret , Issued) , ....) , .....) , ......) > $ UserX 'join' cloudA | (deviceB ; Secret) 
= < UserX | ('knownSecrets' : (Secret , ..) , ...) > < cloudA | (deviceB : ('owner' : (Owner , UserX , ..) , 'tickets' : ((Secret , Issued) , ....) , .....) , ......) > .
ceq < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceB : ('tickets' : ((Secret , Issued) , ...) , ....) , .....) > 
= < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceB : ('tickets' : nils , ....) , .....) > if CurrentTime - Issued > 2 .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars CurrentTime : Nat .
vars FreshSecret : Qid .
vars Issued : Nat .
vars Owner : User .
vars Secret : Qid .
vars Secrets : Set .
vars Tickets : Set .
vars UserX : User .
vars MessageA : Qid .
vars Rest : Set .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : Nat -> Event .
ops ev5 : User -> Event .
ops ev6 : User Qid -> Event .
ops ev7 : User Qid -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceB .
eq ev2(UserX) = $ UserX 'leave' deviceB .
eq ev3(UserX) = $ UserX 'pressButton' deviceB .
eq ev4(N) = $ deviceB 'uploadSecret' cloudA | (randomStr('Secret', N)) .
eq ev5(UserX) = $ UserX 'getKey' cloudA .
eq ev6(UserX, Secret) = $ UserX 'bind' cloudA | (deviceB ; Secret) .
eq ev7(UserX, Secret) = $ UserX 'join' cloudA | (deviceB ; Secret) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev5]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev6]: E @ S < UserX | ('knownSecrets' : Secret , ..) > 
=> ep: ev6(UserX, Secret) @ S < UserX | ('knownSecrets' : Secret , ..) > .
rl [rev6]: E @ S < UserX | ('knownSecrets' : (Secret , Rest) , ..) > 
=> ep: ev6(UserX, Secret) @ S < UserX | ('knownSecrets' : (Secret , Rest) , ..) > .
rl [rev7]: E @ S < UserX | ('knownSecrets' : Secret , ..) > 
=> ep: ev7(UserX, Secret) @ S < UserX | ('knownSecrets' : Secret , ..) > .
rl [rev7]: E @ S < UserX | ('knownSecrets' : (Secret , Rest) , ..) > 
=> ep: ev7(UserX, Secret) @ S < UserX | ('knownSecrets' : (Secret , Rest) , ..) > .
rl [rtp]: E @ S < system | ('time' : N , .. ) >
=> ep: timepass @ S < system | ('time' : (N + 1) , .. ) > .


endm
