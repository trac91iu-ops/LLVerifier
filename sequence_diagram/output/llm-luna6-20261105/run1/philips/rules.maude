load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('time' : 0 , 'counter' : 0) > < userA | ('knows' : nils , 'near' : deviceB) > < userC | ('knows' : nils , 'near' : nils) > < deviceB | (nils) > < cloudA | (deviceB : ('tickets' : nils , 'owners' : nils , 'owner' : nils)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars CurrentTime : Nat .
vars FreshSecret : Qid .
vars IssuedAt : Nat .
vars Knowns : Set .
vars Owner : User .
vars Owners : Set .
vars Secret : Qid .
vars Tickets : Set .
vars UserX : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : deviceB , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
eq < system | ('time' : CurrentTime , 'counter' : N , ..) > < deviceB | (...) > $ UserX 'pressButton' deviceB 
= < system | ('time' : CurrentTime , 'counter' : N + 1 , ..) > < deviceB | (...) > $ deviceB 'uploadSecret' cloudA | (randomStr('Secret', N) ; CurrentTime) .
eq < cloudA | (deviceB : ('tickets' : Tickets , ..) , ...) > $ deviceB 'uploadSecret' cloudA | (Secret ; IssuedAt) 
= < cloudA | (deviceB : ('tickets' : (Tickets , (Secret , IssuedAt)) , ..) , ...) > .
eq < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceB : ('tickets' : (Tickets , (Secret , CurrentTime)) , ...) , ....) > $ UserX 'getKey' cloudA 
= < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceB : ('tickets' : (Tickets , (Secret , CurrentTime)) , ...) , ....) > $ cloudA 'sendSecret' UserX | (Secret) .
eq < UserX | ('knows' : Knowns , ..) > $ cloudA 'sendSecret' UserX | (Secret) 
= < UserX | ('knows' : (Knowns , Secret) , ..) > .
eq < cloudA | (deviceB : ('owner' : nils , 'tickets' : Tickets , ..) , ...) > $ UserX 'bind' cloudA | (Secret) 
= < cloudA | (deviceB : ('owner' : UserX , 'tickets' : Tickets , ..) , ...) > .
eq < cloudA | (deviceB : ('owner' : Owner , 'owners' : Owners , 'tickets' : Tickets , ..) , ...) > $ UserX 'join' cloudA | (Secret) 
= < cloudA | (deviceB : ('owner' : Owner , 'owners' : (Owners , UserX) , 'tickets' : Tickets , ..) , ...) > .
ceq < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceB : ('tickets' : (Tickets , (Secret , IssuedAt)) , ...) , ....) > 
= < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceB : ('tickets' : nils , ...) , ....) > if CurrentTime - IssuedAt > 2 .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars CurrentTime : Nat .
vars FreshSecret : Qid .
vars IssuedAt : Nat .
vars Knowns : Set .
vars Owner : User .
vars Owners : Set .
vars Secret : Qid .
vars Tickets : Set .
vars UserX : User .
vars MessageA : Qid .
vars Rest : Set .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : Nat Nat -> Event .
ops ev5 : Qid Nat -> Event .
ops ev6 : User -> Event .
ops ev7 : User Qid -> Event .
ops ev8 : User Qid -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceB .
eq ev2(UserX) = $ UserX 'leave' deviceB .
eq ev3(UserX) = $ UserX 'pressButton' deviceB .
eq ev4(N, CurrentTime) = $ deviceB 'uploadSecret' cloudA | (randomStr('Secret', N) ; CurrentTime) .
eq ev5(Secret, IssuedAt) = $ deviceB 'uploadSecret' cloudA | (Secret ; IssuedAt) .
eq ev6(UserX) = $ UserX 'getKey' cloudA .
eq ev7(UserX, Secret) = $ UserX 'bind' cloudA | (Secret) .
eq ev8(UserX, Secret) = $ UserX 'join' cloudA | (Secret) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev6]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev6(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev7]: E @ S < UserX | ('knows' : (Secret , Rest) , ..) > 
=> ep: ev7(UserX, Secret) @ S < UserX | ('knows' : (Secret , Rest) , ..) > .
rl [rev8]: E @ S < UserX | ('knows' : (Secret , Rest) , ..) > 
=> ep: ev8(UserX, Secret) @ S < UserX | ('knows' : (Secret , Rest) , ..) > .
rl [rtp]: E @ S < system | ('time' : N , .. ) >
=> ep: timepass @ S < system | ('time' : (N + 1) , .. ) > .


endm
