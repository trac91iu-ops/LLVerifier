load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < cloudB | (deviceLock : ('on' : false , 'trusted' : (cloudSmartThing)) , deviceSwitch : ('trusted' : (userA) , 'key' : 'keyA')) > < userA | ('key' : nils) > < userC | ('key' : nils) > < cloudSmartThing | (deviceSwitch : ('linkedLock' : deviceLock , 'key' : 'keyA' , 'on' : false)) > < deviceB | (nils) > < deviceLock | ('on' : false , 'trusted' : (cloudB)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars CloudX : Cloud .
vars DeviceX : Device .
vars Key : Qid .
vars P : Principal .
vars Rest : Set .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < CloudX | (DeviceX : ('trusted' : (UserX , Trusted) , 'key' : Key , ..) , ...) > $ UserX 'requestKey' CloudX 
= < CloudX | (DeviceX : ('trusted' : (UserX , Trusted) , 'key' : Key , ..) , ...) > $ CloudX 'sendKey' UserX | (Key) .
eq < UserX | ('key' : nils , ..) > $ CloudX 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < CloudX | (DeviceX : ('trusted' : Trusted , ..) , ...) > $ UserX 'delegateAccess' CloudX | (DeviceX ; UserY) 
= < CloudX | (DeviceX : ('trusted' : (UserY , Trusted) , ..) , ...) > .
eq < CloudX | (DeviceX : ('trusted' : (UserX , (UserY , Rest) , ..) , ...) , ....) > $ UserX 'revokeAccess' CloudX | (DeviceX ; UserY) 
= < CloudX | (DeviceX : ('trusted' : (UserX , Rest) , ...) , ....) > .
eq < UserX | ('key' : Key , ..) > < cloudSmartThing | (deviceSwitch : ('key' : Key , 'on' : false , ...) , ....) > $ UserX 'turnOnWithKey' cloudSmartThing | (deviceSwitch ; Key) 
= < UserX | ('key' : Key , ..) > < cloudSmartThing | (deviceSwitch : ('key' : Key , 'on' : true , ...) , ....) > $ cloudSmartThing 'turnOn' deviceSwitch .
eq < DeviceX | (..) > $ UserX 'turnOn' DeviceX 
= < DeviceX | (..) > .
eq < cloudB | (deviceSwitch : ('trusted' : (P , Trusted) , 'on' : false , ..) , ...) > $ P 'turnOn' deviceSwitch 
= < cloudB | (deviceSwitch : ('trusted' : (P , Trusted) , 'on' : true , ..) , ...) > $ cloudB 'turnOn' deviceSwitch .
eq < cloudSmartThing | (deviceSwitch : ('linkedLock' : deviceLock , ..) , ...) > $ cloudSmartThing 'turnOn' deviceSwitch 
= < cloudSmartThing | (deviceSwitch : ('linkedLock' : deviceLock , ..) , ...) > $ cloudSmartThing 'turnOn' deviceLock .
eq < deviceLock | ('trusted' : (P , Trusted) , 'on' : false , ..) > $ P 'turnOn' deviceLock 
= < deviceLock | ('trusted' : (P , Trusted) , 'on' : true , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars CloudX : Cloud .
vars DeviceX : Device .
vars Key : Qid .
vars P : Principal .
vars Rest : Set .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User Cloud -> Event .
ops ev2 : User Cloud Device User -> Event .
ops ev3 : User Cloud Device User -> Event .
ops ev4 : User Qid -> Event .
ops ev5 : User Device -> Event .
ops ev6 : Principal -> Event .
*** events
eq ev1(UserX, CloudX) = $ UserX 'requestKey' CloudX .
eq ev2(UserX, CloudX, DeviceX, UserY) = $ UserX 'delegateAccess' CloudX | (DeviceX ; UserY) .
eq ev3(UserX, CloudX, DeviceX, UserY) = $ UserX 'revokeAccess' CloudX | (DeviceX ; UserY) .
eq ev4(UserX, Key) = $ UserX 'turnOnWithKey' cloudSmartThing | (deviceSwitch ; Key) .
eq ev5(UserX, DeviceX) = $ UserX 'turnOn' DeviceX .
eq ev6(P) = $ P 'turnOn' deviceSwitch .
*** transitions
rl [rev1]: E @ S < UserX | (..) > < cloudB | (...) > 
=> ep: ev1(UserX, cloudB) @ S < UserX | (..) > < cloudB | (...) > .
rl [rev2]: E @ S < UserX | (..) > < UserY | (...) > < cloudB | (....) > < DeviceX | ..... > 
=> ep: ev2(UserX, cloudB, DeviceX, UserY) @ S < UserX | (..) > < UserY | (...) > < cloudB | (....) > < DeviceX | ..... > .
rl [rev3]: E @ S < UserX | (..) > < UserY | (...) > < cloudB | (....) > < DeviceX | ..... > 
=> ep: ev3(UserX, cloudB, DeviceX, UserY) @ S < UserX | (..) > < UserY | (...) > < cloudB | (....) > < DeviceX | ..... > .
rl [rev5]: E @ S < UserX | (..) > < deviceB | (nils , ...) > 
=> ep: ev5(UserX, deviceB) @ S < UserX | (..) > < deviceB | (nils , ...) > .
rl [rev5]: E @ S < UserX | (..) > < deviceLock | (...) > 
=> ep: ev5(UserX, deviceLock) @ S < UserX | (..) > < deviceLock | (...) > .

endm
