load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < cloudA | (userA : ('device' : deviceB , 'members' : nils) , userC : ('device' : nils , 'members' : nils)) > < deviceB | ('key' : 'deviceKey') > < userA | ('key' : nils , 'near' : deviceB) > < userC | ('key' : nils , 'near' : nils) > < deviceA | ('on' : false , 'key' : nils) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars DeviceA : Device .
vars Key : Qid .
vars Members : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < cloudA | (UserX : ('members' : Members , ..) , ...) > $ UserX 'invite' cloudA | (UserY) 
= < cloudA | (UserX : ('members' : (UserY , Members) , ..) , ...) > .
eq < cloudA | (UserX : ('device' : DeviceA , ..) , UserY : ('device' : nils , ...) , ....) > 
= < cloudA | (UserX : ('device' : DeviceA , ..) , UserY : ('device' : DeviceA , ...) , ....) > .
eq < cloudA | (UserX : ('device' : DeviceA , ..) , ...) > < DeviceA | ('key' : Key , ....) > $ UserX 'requestKey' cloudA | (DeviceA) 
= < cloudA | (UserX : ('device' : DeviceA , ..) , ...) > < DeviceA | ('key' : Key , ....) > $ cloudA 'sendKey' UserX | (DeviceA ; Key) .
eq < UserX | ('key' : nils , ..) > $ cloudA 'sendKey' UserX | (DeviceA ; Key) 
= < UserX | ('key' : Key , ..) > .
eq < deviceA | ('key' : Key , 'on' : false , ..) > $ UserX 'turnOn' deviceA | (Key) 
= < deviceA | ('key' : Key , 'on' : true , ..) > .
eq < cloudA | (UserX : ('device' : DeviceA , ..) , ...) > < deviceA | ('on' : false , ....) > $ UserX 'cloudTurnOn' cloudA | (DeviceA) 
= < cloudA | (UserX : ('device' : DeviceA , ..) , ...) > < deviceA | ('on' : true , ....) > .
eq < cloudA | (UserX : ('device' : DeviceA , ..) , UserX : ('members' : (UserY) , ...) , UserY : ('device' : DeviceA , ....) , .....) > $ UserX 'removeMember' cloudA | (UserY) 
= < cloudA | (UserX : ('device' : DeviceA , ...) , UserX : ('members' : nils , ...) , UserY : ('device' : nils , ....) , .....) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars DeviceA : Device .
vars Key : Qid .
vars Members : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User User -> Event .
ops ev2 : User Device -> Event .
ops ev3 : User Qid -> Event .
ops ev4 : User Device -> Event .
ops ev5 : User User -> Event .
*** events
eq ev1(UserX, UserY) = $ UserX 'invite' cloudA | (UserY) .
eq ev2(UserX, DeviceA) = $ UserX 'requestKey' cloudA | (DeviceA) .
eq ev3(UserX, Key) = $ UserX 'turnOn' deviceA | (Key) .
eq ev4(UserX, DeviceA) = $ UserX 'cloudTurnOn' cloudA | (DeviceA) .
eq ev5(UserX, UserY) = $ UserX 'removeMember' cloudA | (UserY) .
*** transitions
rl [rev1]: E @ S < UserX | (..) > < UserY | (...) > 
=> ep: ev1(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > .
rl [rev2]: E @ S < UserX | (..) > < DeviceA | (...) > 
=> ep: ev2(UserX, DeviceA) @ S < UserX | (..) > < DeviceA | (...) > .
rl [rev3]: E @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > 
=> ep: ev3(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > .
rl [rev4]: E @ S < UserX | (..) > < DeviceA | (...) > 
=> ep: ev4(UserX, DeviceA) @ S < UserX | (..) > < DeviceA | (...) > .
rl [rev5]: E @ S < cloudA | (UserX : ('device' : DeviceA , 'members' : (UserY) , ..) , ...) > 
=> ep: ev5(UserX, UserY) @ S < cloudA | (UserX : ('device' : DeviceA , 'members' : (UserY) , ..) , ...) > .

endm
