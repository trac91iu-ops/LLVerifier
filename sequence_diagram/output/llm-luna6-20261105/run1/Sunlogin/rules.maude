load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < deviceB | ('key' : 'deviceKey') > < userA | ('near' : deviceB , 'key' : nils) > < userC | ('near' : nils , 'key' : nils) > < cloudA | (deviceB : ('owner' : nils , 'key' : 'deviceKey')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Key : Qid .
vars UserX : User .
*** policy
eq < deviceA | ('key' : Key , ..) > $ UserX 'pressButton' deviceA 
= < deviceA | ('key' : Key , ..) > $ deviceA 'sendDeviceKey' UserX | (Key) .
eq < UserX | ('key' : nils , ..) > $ deviceA 'sendDeviceKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < cloudA | (deviceA : ('key' : Key , 'owner' : nils , ..) , ...) > $ UserX 'bindDevice' cloudA | (deviceA ; Key) 
= < cloudA | (deviceA : ('key' : Key , 'owner' : UserX , ..) , ...) > .
eq < UserX | ('key' : nils , 'near' : nils , ..) > $ UserX 'approach' deviceA 
= < UserX | ('key' : nils , 'near' : deviceA , ..) > .
eq < UserX | ('near' : deviceA , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Key : Qid .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Qid -> Event .
ops ev3 : User -> Event .
ops ev4 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'pressButton' deviceA .
eq ev2(UserX, Key) = $ UserX 'bindDevice' cloudA | (deviceA ; Key) .
eq ev3(UserX) = $ UserX 'approach' deviceA .
eq ev4(UserX) = $ UserX 'leave' deviceA .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev2]: E @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > 
=> ep: ev2(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > .
rl [rev3]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev4]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev4(UserX) @ S < UserX | ('near' : deviceA , ..) > .

endm
