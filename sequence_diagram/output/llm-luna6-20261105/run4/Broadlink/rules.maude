load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < userA | ('key' : nils , 'near' : deviceB) > < userC | ('key' : nils , 'near' : nils) > < deviceB | ('key' : 'keyB' , 'unlocked' : true) > < cloudA | (userA : ('devices' : nils) , userC : ('devices' : nils) , deviceB : ('members' : nils , 'owners' : nils)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars DeviceB : Device .
vars DeviceKey : Qid .
vars FreshKeyA : Qid .
vars Key : Qid .
vars Members : Set .
vars OldKey : Qid .
vars Owners : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : deviceB , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
eq < system | ('counter' : N , ..) > < UserX | ('near' : deviceB , ...) > < deviceB | ('key' : OldKey , ....) > $ UserX 'pressButton' deviceB 
= < system | ('counter' : N + 1 , ..) > < UserX | ('near' : deviceB , ...) > < deviceB | ('key' : randomStr('KeyA', N) , ....) > .
eq < UserX | ('near' : deviceB , 'key' : nils , ..) > < deviceB | ('unlocked' : true , 'key' : DeviceKey , ...) > $ UserX 'retrieveKey' deviceB 
= < UserX | ('near' : deviceB , 'key' : DeviceKey , ..) > < deviceB | ('unlocked' : true , 'key' : DeviceKey , ...) > .
eq < UserX | ('near' : DeviceB , 'key' : Key , ..) > < DeviceB | ('unlocked' : true , 'key' : Key , ...) > $ UserX 'lock' DeviceB 
= < UserX | ('near' : DeviceB , 'key' : Key , ..) > < DeviceB | ('unlocked' : false , 'key' : Key , ...) > .
eq < UserX | ('key' : Key , ..) > < deviceB | ('key' : Key , ...) > < cloudA | (deviceB : ('owners' : Owners , ....) , .....) > $ UserX 'bind' cloudA | (deviceB ; Key) 
= < UserX | ('key' : Key , ..) > < deviceB | ('key' : Key , ...) > < cloudA | (deviceB : ('owners' : (UserX , Owners) , ....) , .....) > .
eq < cloudA | (UserX : ('devices' : nils , ..) , userC : ('members' : Members , ...) , ....) > $ UserX 'invite' cloudA | (UserY) 
= < cloudA | (UserX : ('devices' : nils , ..) , userC : ('members' : (userA , Members) , ...) , ....) > .
eq < cloudA | (UserX : ('devices' : nils , ..) , userC : ('members' : (userA , Members) , ...) , ....) > $ UserX 'remove' cloudA | (UserY) 
= < cloudA | (UserX : ('devices' : nils , ..) , userC : ('members' : Members , ...) , ....) > .
eq < UserY | ('key' : Key , ..) > < deviceB | (...) > < cloudA | (....) > $ UserY 'retrieveKey' cloudA | (deviceB) 
= < UserY | ('key' : Key , ..) > < deviceB | (...) > < cloudA | (....) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars DeviceB : Device .
vars DeviceKey : Qid .
vars FreshKeyA : Qid .
vars Key : Qid .
vars Members : Set .
vars OldKey : Qid .
vars Owners : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User -> Event .
ops ev5 : User Device -> Event .
ops ev6 : User Qid -> Event .
ops ev7 : User User -> Event .
ops ev8 : User User -> Event .
ops ev9 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceB .
eq ev2(UserX) = $ UserX 'leave' deviceB .
eq ev3(UserX) = $ UserX 'pressButton' deviceB .
eq ev4(UserX) = $ UserX 'retrieveKey' deviceB .
eq ev5(UserX, DeviceB) = $ UserX 'lock' DeviceB .
eq ev6(UserX, Key) = $ UserX 'bind' cloudA | (deviceB ; Key) .
eq ev7(UserX, UserY) = $ UserX 'invite' cloudA | (UserY) .
eq ev8(UserX, UserY) = $ UserX 'remove' cloudA | (UserY) .
eq ev9(UserY) = $ UserY 'retrieveKey' cloudA | (deviceB) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev4]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev4(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev5]: E @ S < UserX | ('key' : Key , 'near' : deviceB , ..) > 
=> ep: ev5(UserX, deviceB) @ S < UserX | ('key' : Key , 'near' : deviceB , ..) > .
rl [rev6]: E @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > 
=> ep: ev6(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > .
rl [rev7]: E @ S < userC | (..) > < userA | (...) > 
=> ep: ev7(userC, userA) @ S < userC | (..) > < userA | (...) > .
rl [rev8]: E @ S < userC | (..) > < userA | (...) > 
=> ep: ev8(userC, userA) @ S < userC | (..) > < userA | (...) > .
rl [rev9]: E @ S < UserY | ('key' : Key , ..) > < deviceB | (...) > 
=> ep: ev9(UserY) @ S < UserY | ('key' : Key , ..) > < deviceB | (...) > .

endm
