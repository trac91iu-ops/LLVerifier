load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < cloudA | (userA : ('device' : deviceB , 'members' : nils) , userC : ('device' : nils , 'members' : nils) , deviceB : ('key' : nils)) > < userA | ('key' : nils) > < userC | ('key' : nils) > < deviceB | ('on' : false , 'key' : 'deviceKey') > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Device : Device .
vars Key : Qid .
vars Members : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < cloudA | (UserX : ('members' : Members , ..) , ...) > $ UserX 'invite' cloudA | (UserY) 
= < cloudA | (UserX : ('members' : (UserY , Members) , ..) , ...) > .
eq < cloudA | (UserX : ('device' : Device , ..) , UserY : ('device' : nils , ...) , ....) > 
= < cloudA | (UserX : ('device' : Device , ..) , UserY : ('device' : Device , ...) , ....) > .
eq < cloudA | (UserX : ('device' : Device , ..) , Device : ('key' : Key , ...) , ....) > $ UserX 'requestKey' cloudA | (Device) 
= < cloudA | (UserX : ('device' : Device , ..) , Device : ('key' : Key , ...) , ....) > $ cloudA 'sendKey' UserX | (Device ; Key) .
eq < UserX | ('key' : nils , ..) > $ cloudA 'sendKey' UserX | (Device ; Key) 
= < UserX | ('key' : Key , ..) > .
eq < Device | ('key' : Key , 'on' : false , ..) > $ UserX 'turnOn' Device | (Key) 
= < Device | ('key' : Key , 'on' : true , ..) > .
eq < cloudA | (UserX : ('device' : Device , ..) , ...) > < Device | ('on' : false , ....) > $ UserX 'cloudTurnOn' cloudA | (Device) 
= < cloudA | (UserX : ('device' : Device , ..) , ...) > < Device | ('on' : true , ....) > .
eq < cloudA | (UserX : ('device' : Device , 'members' : (UserY) , ..) , UserY : ('device' : Device , ...) , ....) > $ UserX 'removeMember' cloudA | (UserY) 
= < cloudA | (UserX : ('device' : Device , 'members' : nils , ..) , UserY : ('device' : nils , ...) , ....) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Device : Device .
vars Key : Qid .
vars Members : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
vars DeviceKey : Qid .
vars KeyX : Qid .
vars KeyY : Qid .
vars UserKey : Qid .
*** events type declaration
ops ev1 : User User -> Event .
ops ev2 : User Device -> Event .
ops ev3 : User Device Qid -> Event .
ops ev4 : User Device -> Event .
ops ev5 : User User -> Event .
*** events
eq ev1(UserX, UserY) = $ UserX 'invite' cloudA | (UserY) .
eq ev2(UserX, Device) = $ UserX 'requestKey' cloudA | (Device) .
eq ev3(UserX, Device, Key) = $ UserX 'turnOn' Device | (Key) .
eq ev4(UserX, Device) = $ UserX 'cloudTurnOn' cloudA | (Device) .
eq ev5(UserX, UserY) = $ UserX 'removeMember' cloudA | (UserY) .
*** transitions
rl [rev1]: E @ S < UserX | ('key' : KeyX , ..) > < UserY | ('key' : KeyY , ...) > < cloudA | (....) > 
=> ep: ev1(UserX, UserY) @ S < UserX | ('key' : KeyX , ..) > < UserY | ('key' : KeyY , ...) > < cloudA | (....) > .
rl [rev2]: E @ S < UserX | ('key' : UserKey , ..) > < Device | ('key' : DeviceKey , ...) > < cloudA | (....) > 
=> ep: ev2(UserX, Device) @ S < UserX | ('key' : UserKey , ..) > < Device | ('key' : DeviceKey , ...) > < cloudA | (....) > .
rl [rev3]: E @ S < UserX | ('key' : Key , ..) > < Device | ('key' : DeviceKey , ...) > 
=> ep: ev3(UserX, Device, Key) @ S < UserX | ('key' : Key , ..) > < Device | ('key' : DeviceKey , ...) > .
rl [rev4]: E @ S < UserX | ('key' : UserKey , ..) > < Device | ('key' : DeviceKey , ...) > < cloudA | (....) > 
=> ep: ev4(UserX, Device) @ S < UserX | ('key' : UserKey , ..) > < Device | ('key' : DeviceKey , ...) > < cloudA | (....) > .
rl [rev5]: E @ S < cloudA | (UserX : ('device' : Device , 'members' : (UserY) , ..) , ...) > 
=> ep: ev5(UserX, UserY) @ S < cloudA | (UserX : ('device' : Device , 'members' : (UserY) , ..) , ...) > .

endm
