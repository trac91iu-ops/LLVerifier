load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < cloudGoogle | (deviceSwitch : ('linkedLock' : nils , 'key' : 'keyA' , 'state' : nils , 'trusted' : (userA)) , cloudGoogle : ('trusted' : nils , 'key' : nils)) > < cloudSmartThing | (deviceSwitch : ('linkedLock' : deviceLock , 'key' : 'keyA' , 'state' : nils , 'trusted' : (cloudGoogle)) , cloudSmartThing : ('trusted' : nils , 'key' : nils)) > < userA | ('key' : nils) > < userC | ('key' : nils) > < deviceSwitch | ('trusted' : nils , 'state' : nils) > < deviceLock | ('trusted' : (cloudSmartThing) , 'state' : nils) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars CloudX : Cloud .
vars DeviceSwitch : Device .
vars DeviceX : Device .
vars Key : Qid .
vars LockX : Device .
vars P : Principal .
vars Rest : Set .
vars SmartThingsCloud : Cloud .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < CloudX | (deviceSwitch : ('trusted' : (UserX , ..) , 'key' : Key , ...) , ....) > $ UserX 'requestKey' CloudX 
= < CloudX | (deviceSwitch : ('trusted' : (UserX , ..) , 'key' : Key , ...) , ....) > $ CloudX 'sendKey' UserX | (Key) .
eq < UserX | ('key' : nils , ..) > $ CloudX 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < CloudX | (DeviceX : ('trusted' : (UserX , Rest) , ..) , ...) > $ UserX 'delegateAccess' CloudX | (DeviceX ; UserY) 
= < CloudX | (DeviceX : ('trusted' : (UserX , Rest , UserY) , ..) , ...) > .
eq < CloudX | (DeviceX : ('trusted' : (UserX , UserY , Rest) , ..) , ...) > $ UserX 'revokeAccess' CloudX | (DeviceX ; UserY) 
= < CloudX | (DeviceX : ('trusted' : (UserX , Rest) , ..) , ...) > .
eq < UserX | ('key' : Key , ..) > < CloudX | (DeviceX : ('key' : Key , 'trusted' : Trusted , ...) , ....) > $ UserX 'provideKey' CloudX | (DeviceX ; Key) 
= < UserX | ('key' : Key , ..) > < CloudX | (DeviceX : ('key' : Key , 'trusted' : (Trusted , UserX) , ...) , ....) > .
eq < DeviceX | (..) > $ UserX 'turnOn' DeviceX 
= < DeviceX | (..) > .
eq < CloudX | (DeviceSwitch : ('state' : 'off' , 'trusted' : (P , Rest) , ..) , ...) > $ P 'turnOn' deviceSwitch 
= < CloudX | (DeviceSwitch : ('state' : 'on' , 'trusted' : (P , Rest) , ..) , ...) > $ CloudX 'turnOn' deviceSwitch .
eq < SmartThingsCloud | (DeviceSwitch : ('linkedLock' : LockX , ..) , ...) > $ SmartThingsCloud 'turnOn' deviceSwitch 
= < SmartThingsCloud | (DeviceSwitch : ('linkedLock' : LockX , ..) , ...) > $ SmartThingsCloud 'turnOn' LockX .
eq < LockX | ('trusted' : (P , Rest) , 'state' : 'off' , ..) > $ P 'turnOn' LockX 
= < LockX | ('trusted' : (P , Rest) , 'state' : 'on' , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars CloudX : Cloud .
vars DeviceSwitch : Device .
vars DeviceX : Device .
vars Key : Qid .
vars LockX : Device .
vars P : Principal .
vars Rest : Set .
vars SmartThingsCloud : Cloud .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User Cloud -> Event .
ops ev2 : User Cloud Device User -> Event .
ops ev3 : User Cloud Device User -> Event .
ops ev4 : User Cloud Device Qid -> Event .
ops ev5 : User Device -> Event .
ops ev6 : Principal -> Event .
ops ev7 : Cloud -> Event .
ops ev8 : Cloud Device -> Event .
*** events
eq ev1(UserX, CloudX) = $ UserX 'requestKey' CloudX .
eq ev2(UserX, CloudX, DeviceX, UserY) = $ UserX 'delegateAccess' CloudX | (DeviceX ; UserY) .
eq ev3(UserX, CloudX, DeviceX, UserY) = $ UserX 'revokeAccess' CloudX | (DeviceX ; UserY) .
eq ev4(UserX, CloudX, DeviceX, Key) = $ UserX 'provideKey' CloudX | (DeviceX ; Key) .
eq ev5(UserX, DeviceX) = $ UserX 'turnOn' DeviceX .
eq ev6(P) = $ P 'turnOn' deviceSwitch .
eq ev7(CloudX) = $ CloudX 'turnOn' deviceSwitch .
eq ev8(SmartThingsCloud, LockX) = $ SmartThingsCloud 'turnOn' LockX .
*** transitions
rl [rev1]: E @ S < UserX | (..) > < CloudX | (...) > 
=> ep: ev1(UserX, CloudX) @ S < UserX | (..) > < CloudX | (...) > .
rl [rev2]: E @ S < UserX | (..) > < UserY | (...) > < CloudX | (....) > < DeviceX | (.....) > 
=> ep: ev2(UserX, CloudX, DeviceX, UserY) @ S < UserX | (..) > < UserY | (...) > < CloudX | (....) > < DeviceX | (.....) > .
rl [rev3]: E @ S < UserX | (..) > < UserY | (...) > < CloudX | (....) > < DeviceX | (.....) > 
=> ep: ev3(UserX, CloudX, DeviceX, UserY) @ S < UserX | (..) > < UserY | (...) > < CloudX | (....) > < DeviceX | (.....) > .
rl [rev4]: E @ S < UserX | ('key' : Key , ..) > < CloudX | (...) > < DeviceX | (....) > 
=> ep: ev4(UserX, CloudX, DeviceX, Key) @ S < UserX | ('key' : Key , ..) > < CloudX | (...) > < DeviceX | (....) > .
rl [rev5]: E @ S < UserX | (..) > < DeviceX | (...) > 
=> ep: ev5(UserX, DeviceX) @ S < UserX | (..) > < DeviceX | (...) > .

endm
