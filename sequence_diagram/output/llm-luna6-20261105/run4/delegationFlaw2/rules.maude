load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | ('key' : nils) > < userC | ('key' : nils) > < cloudB | (deviceLock : ('linkedLock' : nils , 'key' : 'keyA' , 'state' : nils , 'trusted' : cloudSmartThing)) > < deviceB | (nils) > < deviceLock | ('trusted' : (cloudB) , 'state' : nils) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Cloud : Cloud .
vars Device : Device .
vars Key : Qid .
vars P : Principal .
vars Rest : Set .
vars SmartThingsCloud : Cloud .
vars UserKey : Qid .
vars UserX : User .
vars UserY : User .
*** policy
eq < UserX | ('key' : UserKey , ..) > $ UserX 'requestKey' Cloud 
= < UserX | ('key' : UserKey , ..) > .
eq < Cloud | (Device : ('trusted' : (UserX , Rest) , 'key' : Key , ..) , ...) > $ UserX 'requestKey' Cloud 
= < Cloud | (Device : ('trusted' : (UserX , Rest) , 'key' : Key , ..) , ...) > $ Cloud 'sendKey' UserX | (Key) .
eq < UserX | ('key' : nils , ..) > $ Cloud 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < Cloud | (Device : ('trusted' : (UserX , Rest) , ..) , ...) > $ UserX 'delegateAccess' Cloud | (Device ; UserY) 
= < Cloud | (Device : ('trusted' : (UserX , UserY , Rest) , ..) , ...) > .
eq < Cloud | (Device : ('trusted' : (UserX , UserY , Rest) , ..) , ...) > $ UserX 'revokeAccess' Cloud | (Device ; UserY) 
= < Cloud | (Device : ('trusted' : (UserX , Rest) , ..) , ...) > .
eq < UserX | ('key' : Key , ..) > < SmartThingsCloud | (Device : ('key' : Key , 'state' : 'off' , ...) , ....) > $ UserX 'turnOnWithKey' SmartThingsCloud | (Device ; Key) 
= < UserX | ('key' : Key , ..) > < SmartThingsCloud | (Device : ('key' : Key , 'state' : 'on' , ...) , ....) > $ SmartThingsCloud 'turnOn' Device .
eq < Device | (..) > $ UserX 'turnOn' Device 
= < Device | (..) > .
eq < Cloud | (Device : ('state' : 'off' , 'trusted' : (P , Rest) , ..) , ...) > $ P 'turnOn' Cloud | (Device) 
= < Cloud | (Device : ('state' : 'on' , 'trusted' : (P , Rest) , ..) , ...) > $ Cloud 'turnOn' Device .
eq < SmartThingsCloud | (Device : ('linkedLock' : deviceLock , ..) , ...) > $ SmartThingsCloud 'turnOn' Device 
= < SmartThingsCloud | (Device : ('linkedLock' : deviceLock , ..) , ...) > $ SmartThingsCloud 'turnOn' deviceLock .
eq < deviceLock | ('trusted' : (P , Rest) , 'state' : 'off' , ..) > $ P 'turnOn' deviceLock 
= < deviceLock | ('trusted' : (P , Rest) , 'state' : 'on' , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Cloud : Cloud .
vars Device : Device .
vars Key : Qid .
vars P : Principal .
vars Rest : Set .
vars SmartThingsCloud : Cloud .
vars UserKey : Qid .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User Cloud -> Event .
ops ev2 : User Cloud Device User -> Event .
ops ev3 : User Cloud Device User -> Event .
ops ev4 : User Device -> Event .
*** events
eq ev1(UserX, Cloud) = $ UserX 'requestKey' Cloud .
eq ev2(UserX, Cloud, Device, UserY) = $ UserX 'delegateAccess' Cloud | (Device ; UserY) .
eq ev3(UserX, Cloud, Device, UserY) = $ UserX 'revokeAccess' Cloud | (Device ; UserY) .
eq ev4(UserX, Device) = $ UserX 'turnOn' Device .
*** transitions
rl [rev1]: E @ S < UserX | (..) > < Cloud | (...) > 
=> ep: ev1(UserX, Cloud) @ S < UserX | (..) > < Cloud | (...) > .
rl [rev2]: E @ S < UserX | (..) > < UserY | (...) > < Cloud | (....) > < Device | (.....) > 
=> ep: ev2(UserX, Cloud, Device, UserY) @ S < UserX | (..) > < UserY | (...) > < Cloud | (....) > < Device | (.....) > .
rl [rev3]: E @ S < UserX | (..) > < UserY | (...) > < Cloud | (....) > < Device | (.....) > 
=> ep: ev3(UserX, Cloud, Device, UserY) @ S < UserX | (..) > < UserY | (...) > < Cloud | (....) > < Device | (.....) > .
rl [rev4]: E @ S < UserX | ('key' : Key , ..) > < Device | (...) > 
=> ep: ev4(UserX, Device) @ S < UserX | ('key' : Key , ..) > < Device | (...) > .
rl [rev4]: E @ S < UserX | (..) > < Device | (...) > 
=> ep: ev4(UserX, Device) @ S < UserX | (..) > < Device | (...) > .

endm
