load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < userA | ('near' : deviceB , 'signedKey' : nils , 'key' : nils) > < userC | ('signedKey' : nils , 'near' : nils , 'key' : nils) > < deviceB | ('trusted' : (userA) , 'key' : '' , 'secret' : 'secret') > < cloudA | (deviceB : ('trusted' : (userA) , 'secret' : 'secret')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Cloud : Cloud .
vars Device : Device .
vars DeviceKey : Qid .
vars FreshKey : Qid .
vars Key : Qid .
vars Secret : Qid .
vars SignedKey : Item .
vars SignedOld : Item .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < UserX | ('near' : nils , ..) > < Device | (...) > $ UserX 'approach' Device 
= < UserX | ('near' : Device , ..) > < Device | (...) > .
eq < UserX | ('near' : Device , ..) > $ UserX 'leave' Device 
= < UserX | ('near' : nils , ..) > .
eq < system | ('counter' : N , ..) > < UserX | ('key' : nils , ...) > < Device | ('key' : DeviceKey , ....) > $ UserX 'requestKey' Device 
= < system | ('counter' : N + 1 , ..) > < UserX | ('key' : randomStr('Key', N) , ...) > < Device | ('key' : randomStr('Key', N) , ....) > .
eq < UserX | ('key' : Key , 'signedKey' : SignedOld , ..) > < Cloud | (Device : ('trusted' : (UserX , ...) , 'secret' : Secret , ....) , .....) > $ UserX 'signKey' Cloud | (Device ; Key) 
= < UserX | ('key' : Key , 'signedKey' : SignedOld , ..) > < Cloud | (Device : ('trusted' : (UserX , ...) , 'secret' : Secret , ....) , .....) > $ Cloud 'signedKey' UserX | (encrypt(Key, Secret)) .
eq < UserX | ('signedKey' : nils , ..) > $ Cloud 'signedKey' UserX | (SignedKey) 
= < UserX | ('signedKey' : SignedKey , ..) > .
eq < UserX | ('near' : Device , 'signedKey' : encrypt(DeviceKey, Secret) , ..) > < Device | ('key' : DeviceKey , 'secret' : Secret , 'trusted' : Trusted , ...) > $ UserX 'bind' Device | (encrypt(DeviceKey, Secret)) 
= < UserX | ('near' : Device , 'signedKey' : encrypt(DeviceKey, Secret) , ..) > < Device | ('key' : DeviceKey , 'secret' : Secret , 'trusted' : (UserX , Trusted) , ...) > .
eq < Cloud | (Device : ('trusted' : Trusted , ..) , ...) > $ UserX 'shareAccess' Cloud | (Device ; UserY) 
= < Cloud | (Device : ('trusted' : (UserY , Trusted) , ..) , ...) > .
eq < Cloud | (Device : ('trusted' : (UserX , UserY , Trusted) , ..) , ...) > $ UserX 'revokeAccess' Cloud | (Device ; UserY) 
= < Cloud | (Device : ('trusted' : (UserX , Trusted) , ..) , ...) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Cloud : Cloud .
vars Device : Device .
vars DeviceKey : Qid .
vars FreshKey : Qid .
vars Key : Qid .
vars Secret : Qid .
vars SignedKey : Item .
vars SignedOld : Item .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User Device -> Event .
ops ev2 : User Device -> Event .
ops ev3 : User Device -> Event .
ops ev4 : User Cloud Device Qid -> Event .
ops ev5 : User Device Qid Qid -> Event .
ops ev6 : User Device Qid -> Event .
ops ev7 : User Cloud Device User -> Event .
ops ev8 : User Cloud Device User -> Event .
*** events
eq ev1(UserX, Device) = $ UserX 'approach' Device .
eq ev2(UserX, Device) = $ UserX 'leave' Device .
eq ev3(UserX, Device) = $ UserX 'requestKey' Device .
eq ev4(UserX, Cloud, Device, Key) = $ UserX 'signKey' Cloud | (Device ; Key) .
eq ev5(UserX, Device, DeviceKey, Secret) = $ UserX 'bind' Device | (encrypt(DeviceKey, Secret)) .
eq ev6(UserX, Device, MessageA) = $ UserX 'bind' Device | (MessageA) .
eq ev7(UserX, Cloud, Device, UserY) = $ UserX 'shareAccess' Cloud | (Device ; UserY) .
eq ev8(UserX, Cloud, Device, UserY) = $ UserX 'revokeAccess' Cloud | (Device ; UserY) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > < deviceB | (...) > 
=> ep: ev1(UserX, deviceB) @ S < UserX | ('near' : nils , ..) > < deviceB | (...) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev2(UserX, deviceB) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev3(UserX, deviceB) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev4]: E @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > < cloudB | (....) > 
=> ep: ev4(UserX, cloudB, deviceB, Key) @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > < cloudB | (....) > .
rl [rev6]: E @ S < UserX | ('near' : deviceB , 'signedKey' : MessageA , ..) > 
=> ep: ev6(UserX, deviceB, MessageA) @ S < UserX | ('near' : deviceB , 'signedKey' : MessageA , ..) > .
rl [rev7]: E @ S < UserX | (..) > < UserY | (...) > < deviceB | (....) > < cloudB | (.....) > 
=> ep: ev7(UserX, cloudB, deviceB, UserY) @ S < UserX | (..) > < UserY | (...) > < deviceB | (....) > < cloudB | (.....) > .
rl [rev8]: E @ S < UserX | (..) > < UserY | (...) > < deviceB | (....) > < cloudB | (.....) > 
=> ep: ev8(UserX, cloudB, deviceB, UserY) @ S < UserX | (..) > < UserY | (...) > < deviceB | (....) > < cloudB | (.....) > .

endm
