load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('time' : 0 , 'counter' : 0) > < userA | ('knows' : nils , 'near' : deviceB) > < userC | ('knows' : nils , 'near' : nils) > < deviceB | (nils) > < cloudA | (deviceB : ('tickets' : nils , 'owner' : nils)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars CurrentTime : Nat .
vars FreshSecretA : Qid .
vars IssuedAt : Nat .
vars KnownSecrets : Set .
vars Owner : User .
vars Secret : Qid .
vars Tickets : Set .
vars UserX : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceA 
= < UserX | ('near' : deviceA , ..) > .
eq < UserX | ('near' : deviceA , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > .
eq < system | ('time' : CurrentTime , 'counter' : N , ..) > < deviceA | (...) > $ UserX 'pressButton' deviceA 
= < system | ('time' : CurrentTime , 'counter' : N + 1 , ..) > < deviceA | (...) > $ deviceA 'uploadSecret' cloudA | (randomStr('SecretA', N) ; CurrentTime) .
eq < cloudA | (deviceA : ('tickets' : Tickets , ..) , ...) > $ deviceA 'uploadSecret' cloudA | (Secret ; IssuedAt) 
= < cloudA | (deviceA : ('tickets' : (list((Secret ; IssuedAt)) , Tickets) , ..) , ...) > .
eq < UserX | ('near' : deviceA , ..) > $ UserX 'getKey' cloudA | (deviceA) 
= < UserX | ('near' : deviceA , ..) > .
eq < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceA : ('tickets' : (list((Secret ; CurrentTime)) , Tickets) , ...) , ....) > $ UserX 'getKey' cloudA | (deviceA) 
= < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceA : ('tickets' : (list((Secret ; CurrentTime)) , Tickets) , ...) , ....) > $ cloudA 'sendSecret' UserX | (Secret) .
eq < UserX | ('knows' : nils , ..) > $ cloudA 'sendSecret' UserX | (Secret) 
= < UserX | ('knows' : (Secret) , ..) > .
eq < UserX | ('knows' : (KnownSecrets) , ..) > $ cloudA 'sendSecret' UserX | (Secret) 
= < UserX | ('knows' : (Secret , KnownSecrets) , ..) > .
eq < cloudA | (deviceA : ('owner' : nils , 'tickets' : Tickets , ..) , ...) > $ UserX 'bind' cloudA | (deviceA ; Secret) 
= < cloudA | (deviceA : ('owner' : UserX , 'tickets' : Tickets , ..) , ...) > .
eq < cloudA | (deviceA : ('owner' : Owner , 'tickets' : Tickets , ..) , ...) > $ UserX 'join' cloudA | (deviceA ; Secret) 
= < cloudA | (deviceA : ('owner' : (Owner , UserX , ..) , 'tickets' : Tickets , ..) , ...) > .
ceq < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceA : ('tickets' : (list((Secret ; IssuedAt)) , Tickets) , ...) , ....) > 
= < system | ('time' : CurrentTime , 'counter' : N , ..) > < cloudA | (deviceA : ('tickets' : nils , ...) , ....) > if CurrentTime - IssuedAt > 2 .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars CurrentTime : Nat .
vars FreshSecretA : Qid .
vars IssuedAt : Nat .
vars KnownSecrets : Set .
vars Owner : User .
vars Secret : Qid .
vars Tickets : Set .
vars UserX : User .
vars MessageA : Qid .
vars Rest : Set .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : Nat Nat -> Event .
ops ev5 : User -> Event .
ops ev6 : User Qid -> Event .
ops ev7 : User Qid -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceA .
eq ev2(UserX) = $ UserX 'leave' deviceA .
eq ev3(UserX) = $ UserX 'pressButton' deviceA .
eq ev4(N, CurrentTime) = $ deviceA 'uploadSecret' cloudA | (randomStr('SecretA', N) ; CurrentTime) .
eq ev5(UserX) = $ UserX 'getKey' cloudA | (deviceA) .
eq ev6(UserX, Secret) = $ UserX 'bind' cloudA | (deviceA ; Secret) .
eq ev7(UserX, Secret) = $ UserX 'join' cloudA | (deviceA ; Secret) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev5]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev6]: E @ S < UserX | ('knows' : (Secret , Rest) , ..) > 
=> ep: ev6(UserX, Secret) @ S < UserX | ('knows' : (Secret , Rest) , ..) > .
rl [rev7]: E @ S < UserX | ('knows' : (Secret , Rest) , ..) > 
=> ep: ev7(UserX, Secret) @ S < UserX | ('knows' : (Secret , Rest) , ..) > .
rl [rtp]: E @ S < system | ('time' : N , .. ) >
=> ep: timepass @ S < system | ('time' : (N + 1) , .. ) > .


endm
