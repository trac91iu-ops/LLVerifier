load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < userA | ('message' : nils , 'near' : deviceB) > < userC | ('message' : nils , 'near' : nils) > < deviceB | ('key' : 'keyA') > < cloudA | (userA : ('owner' : nils) , userC : ('owner' : nils) , deviceB : ('key' : 'keyA')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars FreshR : Qid .
vars Key : Qid .
vars Message : Item .
vars OldOwner : Set .
vars R : Qid .
vars StoredMessage : Item .
vars UserX : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceA 
= < UserX | ('near' : deviceA , ..) > .
eq < UserX | ('near' : deviceA , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > .
eq < system | ('counter' : N , ..) > < deviceA | ('key' : Key , ...) > $ UserX 'pressButton' deviceA 
= < system | ('counter' : N + 1 , ..) > < deviceA | ('key' : Key , ...) > $ deviceA 'sendMessage' UserX | (encrypt(randomStr('R', N), Key)) .
eq < UserX | ('message' : nils , ..) > $ deviceA 'sendMessage' UserX | (Message) 
= < UserX | ('message' : Message , ..) > .
eq < UserX | ('message' : StoredMessage , ..) > $ deviceA 'sendMessage' UserX | (Message) 
= < UserX | ('message' : StoredMessage , ..) > .
eq < cloudA | (deviceA : ('key' : Key , ..) , UserX : ('owner' : OldOwner , ...) , ....) > $ UserX 'bind' cloudA | (encrypt(R, Key)) 
= < cloudA | (deviceA : ('key' : Key , ..) , UserX : ('owner' : deviceA , ...) , ....) > .
eq < cloudA | (UserX : ('owner' : OldOwner , ..) , ...) > $ UserX 'reset' cloudA 
= < cloudA | (UserX : ('owner' : nils , ..) , ...) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars FreshR : Qid .
vars Key : Qid .
vars Message : Item .
vars OldOwner : Set .
vars R : Qid .
vars StoredMessage : Item .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid Qid -> Event .
ops ev5 : User Qid -> Event .
ops ev6 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceA .
eq ev2(UserX) = $ UserX 'leave' deviceA .
eq ev3(UserX) = $ UserX 'pressButton' deviceA .
eq ev4(UserX, R, Key) = $ UserX 'bind' cloudA | (encrypt(R, Key)) .
eq ev5(UserX, MessageA) = $ UserX 'bind' cloudA | (MessageA) .
eq ev6(UserX) = $ UserX 'reset' cloudA .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev4]: E @ S < UserX | ('message' : encrypt(R, Key) , ..) > 
=> ep: ev4(UserX, R, Key) @ S < UserX | ('message' : encrypt(R, Key) , ..) > .
rl [rev5]: E @ S < UserX | ('message' : MessageA , ..) > 
=> ep: ev5(UserX, MessageA) @ S < UserX | ('message' : MessageA , ..) > .
rl [rev6]: E @ S < UserX | (..) > 
=> ep: ev6(UserX) @ S < UserX | (..) > .

endm
