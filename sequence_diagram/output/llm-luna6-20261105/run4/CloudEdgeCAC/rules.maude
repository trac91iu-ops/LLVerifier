load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | ('near' : deviceB) > < userC | ('near' : deviceD) > < deviceB | ('key' : nils , 'buttonPressed' : false , 'cloud' : cloudA) > < deviceD | ('key' : nils , 'buttonPressed' : false , 'cloud' : cloudA) > < cloudA | ('owner' : nils , userA : ('key' : 'keyA') , userC : ('key' : 'keyC')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Cloud : Cloud .
vars Device : Device .
vars Key : Qid .
vars OtherKey : Qid .
vars Owner : User .
vars UserX : User .
vars UserY : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' Device 
= < UserX | ('near' : Device , ..) > .
eq < UserX | ('near' : Device , ..) > $ UserX 'leave' Device 
= < UserX | ('near' : nils , ..) > .
eq < Device | ('buttonPressed' : false , ..) > $ UserX 'pressButton' Device 
= < Device | ('buttonPressed' : true , ..) > .
eq < Device | ('buttonPressed' : true , 'key' : nils , ..) > $ UserX 'sendKey' Device | (Key) 
= < Device | ('buttonPressed' : false , 'key' : Key , ..) > .
eq < Device | ('key' : Key , 'cloud' : Cloud , ..) > $ UserX 'discover' Device 
= < Device | ('key' : Key , 'cloud' : Cloud , ..) > $ Device 'bind' Cloud | (Key) .
eq < Device | ('key' : nils , ..) > $ UserX 'discover' Device 
= < Device | ('key' : nils , ..) > .
eq < Cloud | ('owner' : nils , UserY : ('key' : Key , ..) , ...) > $ Device 'bind' Cloud | (Key) 
= < Cloud | ('owner' : UserY , UserY : ('key' : Key , ..) , ...) > .
eq < Cloud | ('owner' : nils , UserY : ('key' : OtherKey , ..) , ...) > $ Device 'bind' Cloud | (Key) 
= < Cloud | ('owner' : nils , UserY : ('key' : OtherKey , ..) , ...) > .
eq < Cloud | ('owner' : Owner , ..) > $ Device 'bind' Cloud | (Key) 
= < Cloud | ('owner' : Owner , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Cloud : Cloud .
vars Device : Device .
vars Key : Qid .
vars OtherKey : Qid .
vars Owner : User .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User Device -> Event .
ops ev2 : User Device -> Event .
ops ev3 : User Device -> Event .
ops ev4 : User Device Qid -> Event .
ops ev5 : User Device -> Event .
*** events
eq ev1(UserX, Device) = $ UserX 'approach' Device .
eq ev2(UserX, Device) = $ UserX 'leave' Device .
eq ev3(UserX, Device) = $ UserX 'pressButton' Device .
eq ev4(UserX, Device, Key) = $ UserX 'sendKey' Device | (Key) .
eq ev5(UserX, Device) = $ UserX 'discover' Device .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > < Device | (...) > 
=> ep: ev1(UserX, Device) @ S < UserX | ('near' : nils , ..) > < Device | (...) > .
rl [rev2]: E @ S < UserX | ('near' : Device , ..) > < Device | (...) > 
=> ep: ev2(UserX, Device) @ S < UserX | ('near' : Device , ..) > < Device | (...) > .
rl [rev3]: E @ S < UserX | ('near' : Device , ..) > < Device | (...) > 
=> ep: ev3(UserX, Device) @ S < UserX | ('near' : Device , ..) > < Device | (...) > .
rl [rev4]: E @ S < UserX | ('near' : Device , ..) > < Device | (...) > < cloudB | (UserY : ('key' : Key , ....) , .....) > 
=> ep: ev4(UserX, Device, Key) @ S < UserX | ('near' : Device , ..) > < Device | (...) > < cloudB | (UserY : ('key' : Key , ....) , .....) > .
rl [rev5]: E @ S < UserX | ('near' : Device , ..) > < Device | (...) > 
=> ep: ev5(UserX, Device) @ S < UserX | ('near' : Device , ..) > < Device | (...) > .

endm
