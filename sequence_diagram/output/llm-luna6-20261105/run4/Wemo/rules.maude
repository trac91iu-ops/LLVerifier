load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < deviceB | ('key' : nils , 'buttonPressed' : false) > < cloudA | (userA : ('accountKey' : 'accountKeyA') , userC : ('accountKey' : 'accountKeyC') , deviceB : ('owner' : nils)) > < userA | ('near' : deviceB) > < userC | ('near' : nils) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars K : Qid .
vars UserX : User .
vars UserY : User .
*** policy
eq < deviceB | ('buttonPressed' : false , ..) > $ UserX 'pressButton' deviceB 
= < deviceB | ('buttonPressed' : true , ..) > .
eq < cloudA | (UserX : ('accountKey' : K , ..) , ...) > < deviceB | ('buttonPressed' : true , 'key' : nils , ....) > $ UserX 'sendKey' deviceB | (K) 
= < cloudA | (UserX : ('accountKey' : K , ..) , ...) > < deviceB | ('buttonPressed' : false , 'key' : K , ....) > .
eq < deviceB | ('key' : K , ..) > $ UserX 'discover' deviceB 
= < deviceB | ('key' : K , ..) > $ deviceB 'bind' cloudA | (K) .
eq < cloudA | (UserY : ('accountKey' : K , ..) , deviceB : ('owner' : nils , ...) , ....) > $ deviceB 'bind' cloudA | (K) 
= < cloudA | (UserY : ('accountKey' : K , ..) , deviceB : ('owner' : UserY , ...) , ....) > .
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : deviceB , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars K : Qid .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Qid -> Event .
ops ev3 : User -> Event .
ops ev4 : User -> Event .
ops ev5 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'pressButton' deviceB .
eq ev2(UserX, K) = $ UserX 'sendKey' deviceB | (K) .
eq ev3(UserX) = $ UserX 'discover' deviceB .
eq ev4(UserX) = $ UserX 'approach' deviceB .
eq ev5(UserX) = $ UserX 'leave' deviceB .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , ..) > < cloudA | (UserX : ('accountKey' : K , ...) , ....) > 
=> ep: ev2(UserX, K) @ S < UserX | ('near' : deviceB , ..) > < cloudA | (UserX : ('accountKey' : K , ...) , ....) > .
rl [rev3]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev4]: E @ S < UserX | ('near' : nils , ..) > < deviceB | (...) > 
=> ep: ev4(UserX) @ S < UserX | ('near' : nils , ..) > < deviceB | (...) > .
rl [rev5]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : deviceB , ..) > .

endm
