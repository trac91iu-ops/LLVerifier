load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < deviceB | ('buttonPressed' : false , 'key' : nils) > < cloudA | (deviceB : ('bindingKey' : '' , 'owner' : nils)) > < userA | ('near' : true , 'key' : 'keyA') > < userC | ('near' : false , 'key' : 'keyC') > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Key : Qid .
vars OldKey : Set .
vars UserX : User .
*** policy
eq < deviceA | ('buttonPressed' : false , ..) > $ UserX 'pressButton' deviceA 
= < deviceA | ('buttonPressed' : true , ..) > .
eq < deviceA | ('buttonPressed' : true , 'key' : OldKey , ..) > $ UserX 'setKey' deviceA | (Key) 
= < deviceA | ('buttonPressed' : false , 'key' : Key , ..) > $ deviceA 'sendBindingKey' cloudA | (Key) .
eq < cloudA | (deviceA : ('bindingKey' : OldKey , ..) , ...) > $ deviceA 'sendBindingKey' cloudA | (Key) 
= < cloudA | (deviceA : ('bindingKey' : Key , ..) , ...) > .
eq < deviceA | ('buttonPressed' : true , 'key' : Key , ..) > $ UserX 'getKey' deviceA 
= < deviceA | ('buttonPressed' : false , 'key' : Key , ..) > $ deviceA 'sendKey' UserX | (Key) .
eq < UserX | ('key' : OldKey , ..) > $ deviceA 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < UserX | ('key' : Key , ..) > < cloudA | (deviceA : ('bindingKey' : Key , 'owner' : nils , ...) , ....) > $ UserX 'bindDevice' cloudA | (deviceA ; Key) 
= < UserX | ('key' : Key , ..) > < cloudA | (deviceA : ('bindingKey' : Key , 'owner' : UserX , ...) , ....) > .
eq < UserX | ('key' : Key , ..) > < cloudA | (deviceA : ('bindingKey' : Key , 'owner' : UserX , ...) , ....) > $ UserX 'resetDevice' cloudA | (deviceA ; Key) 
= < UserX | ('key' : Key , ..) > < cloudA | (deviceA : ('bindingKey' : '' , 'owner' : nils , ...) , ....) > .
eq < UserX | ('near' : false , ..) > $ UserX 'approach' deviceA 
= < UserX | ('near' : true , ..) > .
eq < UserX | ('near' : true , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : false , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Key : Qid .
vars OldKey : Set .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Qid -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid -> Event .
ops ev5 : User -> Event .
ops ev6 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'pressButton' deviceA .
eq ev2(UserX, Key) = $ UserX 'setKey' deviceA | (Key) .
eq ev3(UserX) = $ UserX 'getKey' deviceA .
eq ev4(UserX, Key) = $ UserX 'bindDevice' cloudA | (deviceA ; Key) .
eq ev5(UserX) = $ UserX 'approach' deviceA .
eq ev6(UserX) = $ UserX 'leave' deviceA .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : true , ..) > < deviceA | (...) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : true , ..) > < deviceA | (...) > .
rl [rev2]: E @ S < UserX | ('near' : true , 'key' : Key , ..) > < deviceA | (...) > 
=> ep: ev2(UserX, Key) @ S < UserX | ('near' : true , 'key' : Key , ..) > < deviceA | (...) > .
rl [rev3]: E @ S < UserX | ('near' : true , ..) > < deviceA | (...) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : true , ..) > < deviceA | (...) > .
rl [rev4]: E @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > < cloudA | (....) > 
=> ep: ev4(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > < cloudA | (....) > .
rl [rev5]: E @ S < UserX | ('near' : false , ..) > < deviceA | (...) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : false , ..) > < deviceA | (...) > .
rl [rev6]: E @ S < UserX | ('near' : true , ..) > < deviceA | (...) > 
=> ep: ev6(UserX) @ S < UserX | ('near' : true , ..) > < deviceA | (...) > .

endm
