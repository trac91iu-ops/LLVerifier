load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | (nils) > < userC | (nils) > < cloudB | ('buffer' : nils , deviceA : ('permission' : true) , userA : ('permission' : true) , userC : ('permission' : false)) > < deviceA | ('on' : false) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars User : User .
*** policy
eq < User | (..) > < cloudB | ('buffer' : nils , User : ('permission' : true , ...) , ....) > $ User 'publishToggle' cloudB 
= < User | (..) > < cloudB | ('buffer' : 'toggle' , User : ('permission' : true , ...) , ....) > $ cloudB 'acknowledge' User .
eq < User | (..) > < cloudB | ('buffer' : 'toggle' , User : ('permission' : true , ...) , ....) > $ cloudB 'acknowledge' User 
= < User | (..) > < cloudB | ('buffer' : 'toggle' , User : ('permission' : true , ...) , ....) > .
eq < cloudB | (User : ('permission' : true , ..) , ...) > 
= < cloudB | (User : ('permission' : false , ..) , ...) > .
eq < User | (..) > < cloudB | ('buffer' : 'toggle' , deviceA : ('permission' : true , ...) , ....) > $ User 'releaseMessage' cloudB 
= < User | (..) > < cloudB | ('buffer' : nils , deviceA : ('permission' : true , ...) , ....) > $ cloudB 'publish' deviceA | ('toggle') .
eq < deviceA | ('on' : false , ..) > $ cloudB 'publish' deviceA | ('toggle') 
= < deviceA | ('on' : true , ..) > .
eq < deviceA | ('on' : true , ..) > $ cloudB 'publish' deviceA | ('toggle') 
= < deviceA | ('on' : true , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars User : User .
vars MessageA : Qid .
vars UserX : User .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
*** events
eq ev1(User) = $ User 'publishToggle' cloudB .
eq ev2(User) = $ User 'releaseMessage' cloudB .
*** transitions
rl [rev1]: E @ S < UserX | (..) > 
=> ep: ev1(UserX) @ S < UserX | (..) > .
rl [rev2]: E @ S < UserX | (..) > 
=> ep: ev2(UserX) @ S < UserX | (..) > .

endm
