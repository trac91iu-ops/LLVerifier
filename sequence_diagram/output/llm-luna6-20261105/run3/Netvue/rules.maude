load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < userA | ('near' : deviceB , 'message' : nils) > < userC | ('near' : nils , 'message' : nils) > < deviceB | ('key' : 'deviceKey') > < cloudA | (deviceB : ('owners' : nils , 'key' : 'deviceKey')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars DeviceKey : Qid .
vars FreshText : Item .
vars Message : Item .
vars OldMessage : Set .
vars Owners : Set .
vars Text : Item .
vars UserX : User .
*** policy
eq < system | ('counter' : N , ..) > < UserX | ('near' : deviceB , 'message' : OldMessage , ...) > < deviceB | ('key' : DeviceKey , ....) > $ UserX 'pressButton' deviceB 
= < system | ('counter' : N + 1 , ..) > < UserX | ('near' : deviceB , 'message' : OldMessage , ...) > < deviceB | ('key' : DeviceKey , ....) > $ deviceB 'sendMessage' UserX | (encrypt(randomStr('Text', N), DeviceKey)) .
eq < UserX | ('message' : nils , ..) > $ deviceB 'sendMessage' UserX | (Message) 
= < UserX | ('message' : Message , ..) > .
eq < UserX | ('message' : encrypt(Text, DeviceKey) , ..) > < cloudA | (deviceB : ('key' : DeviceKey , 'owners' : Owners , ...) , ....) > $ UserX 'bindDevice' cloudA | (encrypt(Text, DeviceKey)) 
= < UserX | ('message' : encrypt(Text, DeviceKey) , ..) > < cloudA | (deviceB : ('key' : DeviceKey , 'owners' : (UserX , Owners) , ...) , ....) > .
ceq < UserX | ('message' : encrypt(Text, DeviceKey) , ..) > < cloudA | (deviceB : ('key' : DeviceKey , 'owners' : Owners , ...) , ....) > $ UserX 'bindDevice' cloudA | (encrypt(Text, DeviceKey)) 
= < UserX | ('message' : encrypt(Text, DeviceKey) , ..) > < cloudA | (deviceB : ('key' : DeviceKey , 'owners' : Owners , ...) , ....) > if 1 == 1 .
eq < UserX | (..) > < cloudA | (deviceB : ('owners' : (UserX , Owners) , ...) , ....) > $ UserX 'resetDevice' cloudA 
= < UserX | (..) > < cloudA | (deviceB : ('owners' : Owners , ...) , ....) > .
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : deviceB , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars DeviceKey : Qid .
vars FreshText : Item .
vars Message : Item .
vars OldMessage : Set .
vars Owners : Set .
vars Text : Item .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Item Qid -> Event .
ops ev3 : User Qid -> Event .
ops ev4 : User -> Event .
ops ev5 : User -> Event .
ops ev6 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'pressButton' deviceB .
eq ev2(UserX, Text, DeviceKey) = $ UserX 'bindDevice' cloudA | (encrypt(Text, DeviceKey)) .
eq ev3(UserX, MessageA) = $ UserX 'bindDevice' cloudA | (MessageA) .
eq ev4(UserX) = $ UserX 'resetDevice' cloudA .
eq ev5(UserX) = $ UserX 'approach' deviceB .
eq ev6(UserX) = $ UserX 'leave' deviceB .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev2]: E @ S < UserX | ('message' : encrypt(Text, DeviceKey) , ..) > 
=> ep: ev2(UserX, Text, DeviceKey) @ S < UserX | ('message' : encrypt(Text, DeviceKey) , ..) > .
rl [rev3]: E @ S < UserX | ('message' : MessageA , ..) > 
=> ep: ev3(UserX, MessageA) @ S < UserX | ('message' : MessageA , ..) > .
rl [rev4]: E @ S < UserX | (..) > 
=> ep: ev4(UserX) @ S < UserX | (..) > .
rl [rev5]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev6]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev6(UserX) @ S < UserX | ('near' : deviceB , ..) > .

endm
