load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | ('near' : deviceA , 'key' : ('keyA')) > < userC | ('near' : nils , 'key' : ('keyC')) > < deviceA | ('buttonPressed' : false , 'key' : nils) > < cloudA | (deviceA : ('bindingKey' : '' , 'owner' : nils)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Key : Qid .
vars OldKey : Set .
vars UserX : User .
*** policy
eq < UserX | ('near' : deviceA , ..) > < deviceA | ('buttonPressed' : false , ...) > $ UserX 'pressButton' deviceA 
= < UserX | ('near' : deviceA , ..) > < deviceA | ('buttonPressed' : true , ...) > .
eq < UserX | ('near' : deviceA , 'key' : Key , ..) > < deviceA | ('buttonPressed' : true , 'key' : OldKey , ...) > $ UserX 'setKey' deviceA | (Key) 
= < UserX | ('near' : deviceA , 'key' : Key , ..) > < deviceA | ('buttonPressed' : false , 'key' : Key , ...) > $ deviceA 'setBindingKey' cloudA | (Key) .
eq < cloudA | (deviceA : ('bindingKey' : OldKey , ..) , ...) > $ deviceA 'setBindingKey' cloudA | (Key) 
= < cloudA | (deviceA : ('bindingKey' : Key , ..) , ...) > .
eq < UserX | ('near' : deviceA , 'key' : OldKey , ..) > < deviceA | ('buttonPressed' : true , 'key' : Key , ...) > $ UserX 'retrieveKey' deviceA 
= < UserX | ('near' : deviceA , 'key' : OldKey , ..) > < deviceA | ('buttonPressed' : false , 'key' : Key , ...) > $ deviceA 'sendKey' UserX | (Key) .
eq < UserX | ('key' : OldKey , ..) > $ deviceA 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < UserX | ('key' : Key , ..) > < cloudA | (deviceA : ('bindingKey' : Key , 'owner' : nils , ...) , ....) > $ UserX 'bind' cloudA | (deviceA ; Key) 
= < UserX | ('key' : Key , ..) > < cloudA | (deviceA : ('bindingKey' : Key , 'owner' : UserX , ...) , ....) > .
eq < UserX | ('key' : Key , ..) > < cloudA | (deviceA : ('bindingKey' : Key , 'owner' : UserX , ...) , ....) > $ UserX 'reset' cloudA | (deviceA ; Key) 
= < UserX | ('key' : Key , ..) > < cloudA | (deviceA : ('bindingKey' : '' , 'owner' : nils , ...) , ....) > .
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceA 
= < UserX | ('near' : deviceA , ..) > .
eq < UserX | ('near' : deviceA , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Key : Qid .
vars OldKey : Set .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Qid -> Event .
ops ev3 : Qid -> Event .
ops ev4 : User Qid -> Event .
ops ev5 : User Qid -> Event .
ops ev6 : User -> Event .
ops ev7 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'pressButton' deviceA .
eq ev2(UserX, Key) = $ UserX 'setKey' deviceA | (Key) .
eq ev3(Key) = $ deviceA 'setBindingKey' cloudA | (Key) .
eq ev4(UserX, Key) = $ UserX 'bind' cloudA | (deviceA ; Key) .
eq ev5(UserX, Key) = $ UserX 'reset' cloudA | (deviceA ; Key) .
eq ev6(UserX) = $ UserX 'approach' deviceA .
eq ev7(UserX) = $ UserX 'leave' deviceA .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceA , 'key' : Key , ..) > 
=> ep: ev2(UserX, Key) @ S < UserX | ('near' : deviceA , 'key' : Key , ..) > .
rl [rev4]: E @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > 
=> ep: ev4(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > .
rl [rev5]: E @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > 
=> ep: ev5(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > .
rl [rev6]: E @ S < UserX | ('near' : nils , ..) > < deviceA | (...) > 
=> ep: ev6(UserX) @ S < UserX | ('near' : nils , ..) > < deviceA | (...) > .
rl [rev7]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev7(UserX) @ S < UserX | ('near' : deviceA , ..) > .

endm
