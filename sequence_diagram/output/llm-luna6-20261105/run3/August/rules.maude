load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | ('key' : nils , 'near' : deviceB) > < userC | ('key' : nils , 'near' : nils) > < deviceB | ('owner' : nils , 'online' : false , 'key' : 'keyA' , 'buttonPressed' : false) > < cloudA | (deviceB : ('owner' : nils , 'key' : 'keyA')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Key : Qid .
vars Owner : User .
vars UserX : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceA 
= < UserX | ('near' : deviceA , ..) > .
eq < UserX | ('near' : deviceA , ..) > $ UserX 'leave' deviceA 
= < UserX | ('near' : nils , ..) > .
eq < UserX | ('near' : deviceA , ..) > < deviceA | ('owner' : nils , 'online' : false , 'key' : Key , ... , 'buttonPressed' : true) > < cloudA | (deviceA : ('key' : Key , ....) , .....) > $ UserX 'pressButton' deviceA 
= < UserX | ('near' : deviceA , ..) > < deviceA | ('owner' : nils , 'online' : true , 'key' : Key , 'buttonPressed' : true , ...) > < cloudA | (deviceA : ('key' : Key , ....) , .....) > $ deviceA 'sendKey' UserX | (Key) .
eq < UserX | ('key' : nils , ..) > $ deviceA 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < UserX | ('key' : Key , ..) > < deviceA | ('owner' : nils , 'online' : true , 'key' : Key , ...) > < cloudA | (deviceA : ('owner' : nils , 'key' : Key , ....) , .....) > $ UserX 'callAPI:bind' cloudA | (deviceA ; Key) 
= < UserX | ('key' : Key , ..) > < deviceA | ('owner' : UserX , 'online' : true , 'key' : Key , ...) > < cloudA | (deviceA : ('owner' : UserX , 'key' : Key , ....) , .....) > .
eq < UserX | ('key' : Key , ..) > < cloudA | (deviceA : ('owner' : UserX , ...) , ....) > $ UserX 'callAPI:reset' cloudA | (deviceA ; Key) 
= < UserX | ('key' : Key , ..) > < cloudA | (deviceA : ('owner' : nils , ...) , ....) > $ cloudA 'resetDevice' deviceA .
eq < deviceA | ('online' : true , 'owner' : Owner , ..) > $ cloudA 'resetDevice' deviceA 
= < deviceA | ('online' : false , 'owner' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Key : Qid .
vars Owner : User .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid -> Event .
ops ev5 : User Qid -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceA .
eq ev2(UserX) = $ UserX 'leave' deviceA .
eq ev3(UserX) = $ UserX 'pressButton' deviceA .
eq ev4(UserX, Key) = $ UserX 'callAPI:bind' cloudA | (deviceA ; Key) .
eq ev5(UserX, Key) = $ UserX 'callAPI:reset' cloudA | (deviceA ; Key) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceA , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceA , ..) > .
rl [rev4]: E @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > 
=> ep: ev4(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > .
rl [rev5]: E @ S < UserX | ('key' : Key , ..) > 
=> ep: ev5(UserX, Key) @ S < UserX | ('key' : Key , ..) > .

endm
