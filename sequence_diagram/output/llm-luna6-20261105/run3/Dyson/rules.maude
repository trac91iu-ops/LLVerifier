load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < cloudA | (userA : ('members' : nils , 'device' : deviceB) , userC : ('members' : nils , 'device' : nils)) > < deviceB | ('on' : false , 'key' : 'deviceKey') > < userA | ('key' : nils) > < userC | ('key' : nils) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Device : Device .
vars Key : Qid .
vars Members : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < cloudA | (UserX : ('members' : Members , ..) , ...) > $ UserX 'invite' cloudA | (UserY) 
= < cloudA | (UserX : ('members' : (UserY , Members) , ..) , ...) > .
eq < cloudA | (UserX : ('device' : Device , ..) , UserY : ('device' : nils , ...) , ....) > 
= < cloudA | (UserX : ('device' : Device , ..) , UserY : ('device' : Device , ...) , ....) > .
eq < cloudA | (UserX : ('device' : deviceB , ..) , ...) > < deviceB | ('key' : Key , ....) > $ UserX 'requestKey' cloudA | (deviceB) 
= < cloudA | (UserX : ('device' : deviceB , ..) , ...) > < deviceB | ('key' : Key , ....) > $ cloudA 'sendKey' UserX | (deviceB ; Key) .
eq < UserX | ('key' : nils , ..) > $ cloudA 'sendKey' UserX | (Device ; Key) 
= < UserX | ('key' : Key , ..) > .
eq < deviceB | ('key' : Key , 'on' : false , ..) > $ UserX 'turnOn' deviceB | (Key) 
= < deviceB | ('key' : Key , 'on' : true , ..) > .
eq < cloudA | (UserX : ('device' : Device , ..) , ...) > $ UserX 'cloudTurnOn' cloudA | (Device) 
= < cloudA | (UserX : ('device' : Device , ..) , ...) > $ cloudA 'turnOn' Device .
eq < deviceB | ('on' : false , ..) > $ cloudA 'turnOn' deviceB 
= < deviceB | ('on' : true , ..) > .
eq < cloudA | (UserX : ('members' : Members , ..) , UserY : ('device' : Device , ...) , ....) > $ UserX 'removeMember' cloudA | (UserY) 
= < cloudA | (UserX : ('members' : Members , ..) , UserY : ('device' : nils , ...) , ....) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Device : Device .
vars Key : Qid .
vars Members : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
vars Rest : Set .
*** events type declaration
ops ev1 : User User -> Event .
ops ev2 : User -> Event .
ops ev3 : User Qid -> Event .
ops ev4 : User Device -> Event .
ops ev5 : User User -> Event .
*** events
eq ev1(UserX, UserY) = $ UserX 'invite' cloudA | (UserY) .
eq ev2(UserX) = $ UserX 'requestKey' cloudA | (deviceB) .
eq ev3(UserX, Key) = $ UserX 'turnOn' deviceB | (Key) .
eq ev4(UserX, Device) = $ UserX 'cloudTurnOn' cloudA | (Device) .
eq ev5(UserX, UserY) = $ UserX 'removeMember' cloudA | (UserY) .
*** transitions
rl [rev1]: E @ S < UserY | (..) > < cloudA | (UserX : ('members' : Members , ...) , ....) > 
=> ep: ev1(UserX, UserY) @ S < UserY | (..) > < cloudA | (UserX : ('members' : Members , ...) , ....) > .
rl [rev2]: E @ S < UserX | (..) > < deviceB | (...) > 
=> ep: ev2(UserX) @ S < UserX | (..) > < deviceB | (...) > .
rl [rev3]: E @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > 
=> ep: ev3(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > .
rl [rev4]: E @ S < UserX | (..) > < deviceB | (...) > 
=> ep: ev4(UserX, deviceB) @ S < UserX | (..) > < deviceB | (...) > .
rl [rev5]: E @ S < cloudA | (UserX : ('members' : (UserY , Rest) , ..) , ...) > 
=> ep: ev5(UserX, UserY) @ S < cloudA | (UserX : ('members' : (UserY , Rest) , ..) , ...) > .

endm
