load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < cloudA | (userA : ('members' : nils , 'device' : deviceB) , userC : ('members' : nils , 'device' : nils)) > < deviceB | ('on' : false , 'key' : 'deviceKey') > < userA | ('key' : nils) > < userC | ('key' : nils) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars DeviceX : Device .
vars Key : Qid .
vars Members : Set .
vars UserDevice : Device .
vars UserX : User .
vars UserY : User .
*** policy
eq < cloudA | (UserX : ('members' : Members , 'device' : UserDevice , ..) , ...) > $ UserX 'invite' cloudA | (UserY) 
= < cloudA | (UserX : ('members' : (UserY , Members) , 'device' : UserDevice , ..) , ...) > .
eq < cloudA | (UserX : ('device' : UserDevice , ..) , UserY : ('device' : nils , ...) , ....) > 
= < cloudA | (UserX : ('device' : UserDevice , ..) , UserY : ('device' : UserDevice , ...) , ....) > .
eq < deviceA | ('key' : Key , ..) > < cloudA | (UserX : ('device' : deviceA , ...) , ....) > $ UserX 'requestKey' cloudA | (deviceA) 
= < deviceA | ('key' : Key , ..) > < cloudA | (UserX : ('device' : deviceA , ...) , ....) > $ cloudA 'sendKey' UserX | (deviceA ; Key) .
eq < UserX | ('key' : nils , ..) > $ cloudA 'sendKey' UserX | (DeviceX ; Key) 
= < UserX | ('key' : Key , ..) > .
eq < deviceA | ('key' : Key , 'on' : false , ..) > $ UserX 'turnOn' deviceA | (Key) 
= < deviceA | ('key' : Key , 'on' : true , ..) > .
eq < cloudA | (UserX : ('device' : deviceA , ..) , ...) > < deviceA | ('on' : false , ....) > $ UserX 'turnOnCloud' cloudA | (deviceA) 
= < cloudA | (UserX : ('device' : deviceA , ..) , ...) > < deviceA | ('on' : true , ....) > .
eq < cloudA | (UserX : ('members' : (UserY) , ..) , UserY : ('device' : DeviceX , ...) , ....) > $ UserX 'removeMember' cloudA | (UserY) 
= < cloudA | (UserX : ('members' : nils , ..) , UserY : ('device' : nils , ...) , ....) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars DeviceX : Device .
vars Key : Qid .
vars Members : Set .
vars UserDevice : Device .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User User -> Event .
ops ev2 : User -> Event .
ops ev3 : User Qid -> Event .
ops ev4 : User -> Event .
ops ev5 : User User -> Event .
*** events
eq ev1(UserX, UserY) = $ UserX 'invite' cloudA | (UserY) .
eq ev2(UserX) = $ UserX 'requestKey' cloudA | (deviceA) .
eq ev3(UserX, Key) = $ UserX 'turnOn' deviceA | (Key) .
eq ev4(UserX) = $ UserX 'turnOnCloud' cloudA | (deviceA) .
eq ev5(UserX, UserY) = $ UserX 'removeMember' cloudA | (UserY) .
*** transitions
rl [rev1]: E @ S < userA | (..) > < userC | (...) > 
=> ep: ev1(userA, userC) @ S < userA | (..) > < userC | (...) > .
rl [rev1]: E @ S < userA | (..) > < userC | (...) > 
=> ep: ev1(userC, userA) @ S < userA | (..) > < userC | (...) > .
rl [rev2]: E @ S < UserX | (..) > < deviceA | (...) > 
=> ep: ev2(UserX) @ S < UserX | (..) > < deviceA | (...) > .
rl [rev3]: E @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > 
=> ep: ev3(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceA | (...) > .
rl [rev4]: E @ S < UserX | (..) > < deviceA | (...) > 
=> ep: ev4(UserX) @ S < UserX | (..) > < deviceA | (...) > .
rl [rev5]: E @ S < cloudA | (UserX : ('members' : (UserY) , ..) , ...) > 
=> ep: ev5(UserX, UserY) @ S < cloudA | (UserX : ('members' : (UserY) , ..) , ...) > .

endm
