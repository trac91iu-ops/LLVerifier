[formal]
< Cloud | deviceSwitch : ('trusted' : (UserX, Rest) , 'key' : Key , ...) , ... > $ UserX 'requestKey' Cloud
=> < Cloud | deviceSwitch : ('trusted' : (UserX, Rest) , 'key' : Key , ...) , ... > $ Cloud 'sendKey' UserX | (Key) .
< UserX | 'key' : nils , ... > $ Cloud 'sendKey' UserX | (Key)
=> < UserX | 'key' : Key , ... > .
< Cloud | Device : ('trusted' : (UserX, Rest) , ...) , ... > $ UserX 'delegateAccess' Cloud | (Device ; UserY)
=> < Cloud | Device : ('trusted' : (UserX, UserY, Rest) , ...) , ... > if UserX =/= UserY .
< Cloud | Device : ('trusted' : (UserX, UserY, Rest) , ...) , ... > $ UserX 'revokeAccess' Cloud | (Device ; UserY)
=> < Cloud | Device : ('trusted' : (UserX, Rest) , ...) , ... > if UserX =/= UserY .
< UserX | 'key' : Key , ... > < SmartThingsCloud | Device : ('key' : Key , 'trusted' : Trusted , ...) , ... > $ UserX 'provideKey' SmartThingsCloud | (Device ; Key)
=> < UserX | 'key' : Key , ... > < SmartThingsCloud | Device : ('key' : Key , 'trusted' : (UserX, Trusted) , ...) , ... > .
< Device | ... > $ UserX 'turnOn' Device
=> < Device | ... > .
< Cloud | Device : ('state' : 'off' , 'trusted' : (P, Rest) , ...) , ... > $ P 'turnOn' Cloud | (Device)
=> < Cloud | Device : ('state' : 'on' , 'trusted' : (P, Rest) , ...) , ... > $ Cloud 'turnOn' Device .
< SmartThingsCloud | Device : ('linkedLock' : Lock , ...) , ... > $ SmartThingsCloud 'turnOn' Device
=> < SmartThingsCloud | Device : ('linkedLock' : Lock , ...) , ... > $ SmartThingsCloud 'turnOn' Lock .
< Lock | 'trusted' : (P, Rest) , 'state' : 'off' , ... > $ P 'turnOn' Lock
=> < Lock | 'trusted' : (P, Rest) , 'state' : 'on' , ... > .


