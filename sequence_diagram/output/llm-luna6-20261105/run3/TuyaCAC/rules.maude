load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < cloudA | (userA : ('members' : nils , 'device' : deviceB) , userC : ('members' : nils , 'device' : nils)) > < deviceB | ('on' : false , 'key' : 'keyB') > < userA | ('key' : nils) > < userC | ('key' : nils) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Cloud : Cloud .
vars Device : Device .
vars Key : Qid .
vars Members : Set .
vars UserX : User .
vars UserY : User .
vars UserYDevice : Device .
*** policy
eq < Cloud | (UserX : ('members' : Members , ..) , ...) > $ UserX 'invite' Cloud | (UserY) 
= < Cloud | (UserX : ('members' : (UserY , Members) , ..) , ...) > .
eq < Cloud | (UserX : ('device' : Device , ..) , ...) > < Device | ('key' : Key , ....) > $ UserX 'requestKey' Cloud | (Device) 
= < Cloud | (UserX : ('device' : Device , ..) , ...) > < Device | ('key' : Key , ....) > $ Cloud 'sendKey' UserX | (Device ; Key) .
eq < UserX | ('key' : nils , ..) > $ Cloud 'sendKey' UserX | (Device ; Key) 
= < UserX | ('key' : Key , ..) > .
eq < Device | ('key' : Key , 'on' : false , ..) > $ UserX 'turnOnWithKey' Device | (Key) 
= < Device | ('key' : Key , 'on' : true , ..) > .
eq < Cloud | (UserX : ('device' : Device , ..) , ...) > < Device | ('on' : false , ....) > $ UserX 'turnOn' Cloud | (Device) 
= < Cloud | (UserX : ('device' : Device , ..) , ...) > < Device | ('on' : true , ....) > .
eq < Cloud | (UserX : ('device' : Device , 'members' : (UserY) , ..) , UserY : ('device' : UserYDevice , ...) , ....) > $ UserX 'removeMember' Cloud | (UserY) 
= < Cloud | (UserX : ('device' : Device , 'members' : nils , ..) , UserY : ('device' : nils , ...) , ....) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Cloud : Cloud .
vars Device : Device .
vars Key : Qid .
vars Members : Set .
vars UserX : User .
vars UserY : User .
vars UserYDevice : Device .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User Cloud User -> Event .
ops ev2 : User Cloud Device -> Event .
ops ev3 : User Device Qid -> Event .
ops ev4 : User Cloud Device -> Event .
ops ev5 : User Cloud User -> Event .
*** events
eq ev1(UserX, Cloud, UserY) = $ UserX 'invite' Cloud | (UserY) .
eq ev2(UserX, Cloud, Device) = $ UserX 'requestKey' Cloud | (Device) .
eq ev3(UserX, Device, Key) = $ UserX 'turnOnWithKey' Device | (Key) .
eq ev4(UserX, Cloud, Device) = $ UserX 'turnOn' Cloud | (Device) .
eq ev5(UserX, Cloud, UserY) = $ UserX 'removeMember' Cloud | (UserY) .
*** transitions
rl [rev1]: E @ S < UserX | (..) > < UserY | (...) > < cloudB | (....) > 
=> ep: ev1(UserX, cloudB, UserY) @ S < UserX | (..) > < UserY | (...) > < cloudB | (....) > .
rl [rev2]: E @ S < UserX | (..) > < deviceB | (...) > < cloudB | (....) > 
=> ep: ev2(UserX, cloudB, deviceB) @ S < UserX | (..) > < deviceB | (...) > < cloudB | (....) > .
rl [rev3]: E @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > 
=> ep: ev3(UserX, deviceB, Key) @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > .
rl [rev4]: E @ S < UserX | (..) > < deviceB | (...) > < cloudB | (....) > 
=> ep: ev4(UserX, cloudB, deviceB) @ S < UserX | (..) > < deviceB | (...) > < cloudB | (....) > .
rl [rev5]: E @ S < cloudB | (UserX : ('members' : (UserY) , 'device' : Device , ..) , ...) > 
=> ep: ev5(UserX, cloudB, UserY) @ S < cloudB | (UserX : ('members' : (UserY) , 'device' : Device , ..) , ...) > .

endm
