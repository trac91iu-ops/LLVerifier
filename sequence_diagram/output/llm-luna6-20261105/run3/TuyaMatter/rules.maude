load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < cloudA | (userA : ('members' : nils , 'device' : deviceB) , userC : ('members' : nils , 'device' : nils)) > < userA | ('key' : nils) > < userC | ('key' : nils) > < deviceB | ('on' : false , 'trusted' : cloudA , 'key' : nils) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Device : Device .
vars ExistingKey : Qid .
vars FreshKey : Qid .
vars Key : Qid .
vars Members : Set .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < cloudA | (UserX : ('members' : Members , ..) , ...) > $ UserX 'invite' cloudA | (UserY) 
= < cloudA | (UserX : ('members' : (UserY , Members) , ..) , ...) > .
eq < system | ('counter' : N , ..) > < UserX | ('key' : nils , ...) > < cloudA | (UserX : ('device' : Device , ....) , .....) > $ UserX 'openWindow' cloudA | (Device) 
= < system | ('counter' : N + 1 , ..) > < UserX | ('key' : randomStr('Key', N) , ...) > < cloudA | (UserX : ('device' : Device , ....) , .....) > $ cloudA 'openWindow' Device | (randomStr('Key', N)) .
eq < Device | ('key' : nils , ..) > $ cloudA 'openWindow' Device | (Key) 
= < Device | ('key' : Key , ..) > .
eq < Device | ('key' : ExistingKey , ..) > $ cloudA 'openWindow' Device | (Key) 
= < Device | ('key' : ExistingKey , ..) > .
eq < Device | ('key' : Key , 'trusted' : Trusted , ..) > $ UserX 'bind' Device | (Key) 
= < Device | ('key' : Key , 'trusted' : (UserX , Trusted) , ..) > .
eq < Device | ('trusted' : (UserX , Trusted) , 'on' : false , ..) > $ UserX 'turnOn' Device 
= < Device | ('trusted' : (UserX , Trusted) , 'on' : true , ..) > .
eq < cloudA | (UserX : ('device' : Device , ..) , ...) > $ UserX 'turnOn' cloudA | (Device) 
= < cloudA | (UserX : ('device' : Device , ..) , ...) > $ cloudA 'turnOn' Device .
eq < Device | ('trusted' : (cloudA , Trusted) , 'on' : false , ..) > $ cloudA 'turnOn' Device 
= < Device | ('trusted' : (cloudA , Trusted) , 'on' : true , ..) > .
eq < cloudA | (UserX : ('members' : (UserY , Members) , 'device' : Device , ..) , UserY : ('device' : Device , ...) , ....) > $ UserX 'removeMember' cloudA | (UserY) 
= < cloudA | (UserX : ('members' : Members , 'device' : Device , ..) , UserY : ('device' : nils , ...) , ....) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Device : Device .
vars ExistingKey : Qid .
vars FreshKey : Qid .
vars Key : Qid .
vars Members : Set .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
vars Rest : Set .
*** events type declaration
ops ev1 : User User -> Event .
ops ev2 : User Device -> Event .
ops ev3 : User Device Qid -> Event .
ops ev4 : User Device -> Event .
ops ev5 : User Device -> Event .
ops ev6 : User User -> Event .
*** events
eq ev1(UserX, UserY) = $ UserX 'invite' cloudA | (UserY) .
eq ev2(UserX, Device) = $ UserX 'openWindow' cloudA | (Device) .
eq ev3(UserX, Device, Key) = $ UserX 'bind' Device | (Key) .
eq ev4(UserX, Device) = $ UserX 'turnOn' Device .
eq ev5(UserX, Device) = $ UserX 'turnOn' cloudA | (Device) .
eq ev6(UserX, UserY) = $ UserX 'removeMember' cloudA | (UserY) .
*** transitions
rl [rev1]: E @ S < UserX | (..) > < UserY | (...) > 
=> ep: ev1(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > .
rl [rev2]: E @ S < UserX | (..) > < Device | (...) > 
=> ep: ev2(UserX, Device) @ S < UserX | (..) > < Device | (...) > .
rl [rev3]: E @ S < UserX | ('key' : Key , ..) > < Device | (...) > 
=> ep: ev3(UserX, Device, Key) @ S < UserX | ('key' : Key , ..) > < Device | (...) > .
rl [rev4]: E @ S < UserX | (..) > < Device | (...) > 
=> ep: ev4(UserX, Device) @ S < UserX | (..) > < Device | (...) > .
rl [rev5]: E @ S < UserX | (..) > 
=> ep: ev5(UserX, deviceB) @ S < UserX | (..) > .
rl [rev6]: E @ S < cloudA | (UserX : ('members' : (UserY , Rest) , ..) , ...) > < UserY | (....) > 
=> ep: ev6(UserX, UserY) @ S < cloudA | (UserX : ('members' : (UserY , Rest) , ..) , ...) > < UserY | (....) > .

endm
