load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < userA | ('key' : nils , 'near' : deviceB) > < userC | ('devices' : nils , 'near' : nils , 'key' : nils) > < deviceB | ('key' : 'key1' , 'locked' : false) > < cloudA | (deviceB : ('members' : nils , 'owners' : nils) , userA : ('members' : nils , 'owners' : nils) , userC : ('members' : nils , 'owners' : nils)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars FreshKeyA : Qid .
vars Key : Qid .
vars Members : Set .
vars OldKey : Qid .
vars Owners : Set .
vars UserX : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : deviceB , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
eq < system | ('counter' : N , ..) > < deviceB | ('key' : OldKey , ...) > $ UserX 'pressButton' deviceB 
= < system | ('counter' : N + 1 , ..) > < deviceB | ('key' : randomStr('KeyA', N) , ...) > .
eq < UserX | ('key' : nils , ..) > < deviceB | ('locked' : false , 'key' : Key , ...) > $ UserX 'retrieveKey' deviceB 
= < UserX | ('key' : Key , ..) > < deviceB | ('locked' : false , 'key' : Key , ...) > .
eq < UserX | ('near' : deviceB , 'key' : Key , ..) > < deviceB | ('locked' : false , 'key' : Key , ...) > $ UserX 'lockDevice' deviceB 
= < UserX | ('near' : deviceB , 'key' : Key , ..) > < deviceB | ('locked' : true , 'key' : Key , ...) > .
eq < UserX | ('key' : Key , ..) > < deviceB | ('key' : Key , ...) > < cloudA | (deviceB : ('owners' : (Owners) , ....) , .....) > $ UserX 'bindDevice' cloudA | (deviceB ; Key) 
= < UserX | ('key' : Key , ..) > < deviceB | ('key' : Key , ...) > < cloudA | (deviceB : ('owners' : (UserX , Owners) , ....) , .....) > .
eq < userC | ('devices' : nils , ..) > < cloudA | (userC : ('members' : Members , ...) , ....) > $ userC 'invite' cloudA | (userA) 
= < userC | ('devices' : nils , ..) > < cloudA | (userC : ('members' : (userA , Members) , ...) , ....) > .
eq < userC | ('devices' : nils , ..) > < cloudA | (userC : ('members' : (userA , Members) , ...) , ....) > $ userC 'remove' cloudA | (userA) 
= < userC | ('devices' : nils , ..) > < cloudA | (userC : ('members' : Members , ...) , ....) > .
eq < cloudA | (..) > $ userY 'retrieveKey' cloudA | (deviceB) 
= < cloudA | (..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars FreshKeyA : Qid .
vars Key : Qid .
vars Members : Set .
vars OldKey : Qid .
vars Owners : Set .
vars UserX : User .
vars MessageA : Qid .
vars UserY : User .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User -> Event .
ops ev5 : User -> Event .
ops ev6 : User Qid -> Event .
ops ev7 :  -> Event .
ops ev8 :  -> Event .
ops ev9 :  -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceB .
eq ev2(UserX) = $ UserX 'leave' deviceB .
eq ev3(UserX) = $ UserX 'pressButton' deviceB .
eq ev4(UserX) = $ UserX 'retrieveKey' deviceB .
eq ev5(UserX) = $ UserX 'lockDevice' deviceB .
eq ev6(UserX, Key) = $ UserX 'bindDevice' cloudA | (deviceB ; Key) .
eq ev7 = $ userC 'invite' cloudA | (userA) .
eq ev8 = $ userC 'remove' cloudA | (userA) .
eq ev9 = $ userY 'retrieveKey' cloudA | (deviceB) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev4]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev4(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev5]: E @ S < UserX | ('key' : Key , 'near' : deviceB , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('key' : Key , 'near' : deviceB , ..) > .
rl [rev6]: E @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > 
=> ep: ev6(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > .
rl [rev7]: E @ S  
=> ep: ev7(userC) @ S  .
rl [rev8]: E @ S  
=> ep: ev8(userC) @ S  .
rl [rev9]: E @ S < UserY | ('key' : Key , ..) > < deviceB | (...) > 
=> ep: ev9(UserY) @ S < UserY | ('key' : Key , ..) > < deviceB | (...) > .

endm
