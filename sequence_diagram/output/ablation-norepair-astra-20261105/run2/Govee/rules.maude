load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | ('key' : nils , 'near' : deviceB) > < userC | ('key' : nils , 'near' : nils) > < deviceB | ('key' : 'keyB') > < cloudA | (deviceB : ('owner' : nils , 'key' : 'keyB')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Key : Qid .
vars OldNear : Set .
vars UserX : User .
*** policy
eq < UserX | ('near' : OldNear , 'key' : nils , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , 'key' : nils , ..) > .
eq < UserX | ('near' : OldNear , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
eq < deviceB | ('key' : Key , ..) > $ UserX 'pressButton' deviceB 
= < deviceB | ('key' : Key , ..) > $ deviceB 'sendKey' UserX | (Key) .
eq < UserX | ('key' : nils , ..) > $ deviceB 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < cloudA | (deviceB : ('owner' : nils , 'key' : Key , ..) , ...) > $ UserX 'bindDevice' cloudA | (deviceB ; Key) 
= < cloudA | (deviceB : ('owner' : UserX , 'key' : Key , ..) , ...) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Key : Qid .
vars OldNear : Set .
vars UserX : User .
vars MessageA : Qid .
vars Rest : Set .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceB .
eq ev2(UserX) = $ UserX 'leave' deviceB .
eq ev3(UserX) = $ UserX 'pressButton' deviceB .
eq ev4(UserX, Key) = $ UserX 'bindDevice' cloudA | (deviceB ; Key) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev2]: E @ S < UserX | ('near' : (deviceB , Rest) , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : (deviceB , Rest) , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | ('near' : (deviceB , Rest) , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : (deviceB , Rest) , ..) > .
rl [rev4]: E @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > 
=> ep: ev4(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > .

endm
