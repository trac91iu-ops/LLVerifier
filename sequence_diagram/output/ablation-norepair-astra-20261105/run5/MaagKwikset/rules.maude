load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < userA | ('signedKey' : nils , 'near' : deviceB , 'key' : nils) > < userC | ('signedKey' : nils , 'near' : nils , 'key' : nils) > < deviceB | ('key' : '' , 'secret' : 'secret' , 'trusted' : (userA)) > < cloudA | (deviceB : ('trusted' : (userA)) , 'secret' : 'secret') > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars DeviceKey : Qid .
vars FreshKey : Qid .
vars Key : Qid .
vars OldNear : Set .
vars Rest : Set .
vars Secret : Qid .
vars SignedKey : Item .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < UserX | ('near' : OldNear , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : OldNear , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
ceq < system | ('counter' : N , ..) > < UserX | ('key' : nils , ...) > < deviceB | ('key' : DeviceKey , ....) > $ UserX 'requestKey' deviceB 
= < system | ('counter' : N + 1 , ..) > < UserX | ('key' : randomStr('Key', N) , ...) > < deviceB | ('key' : randomStr('Key', N) , ....) > if DeviceKey =/= nils .
eq < cloudA | ('secret' : Secret , deviceB : ('trusted' : (UserX , Rest) , ..) , ...) > $ UserX 'signKey' cloudA | (deviceB ; Key) 
= < cloudA | ('secret' : Secret , deviceB : ('trusted' : (UserX , Rest) , ..) , ...) > $ cloudA 'signedKey' UserX | (deviceB ; encrypt(Key, Secret)) .
eq < UserX | ('signedKey' : nils , ..) > $ cloudA 'signedKey' UserX | (deviceB ; SignedKey) 
= < UserX | ('signedKey' : SignedKey , ..) > .
eq < UserX | ('signedKey' : encrypt(Key, Secret) , ..) > < deviceB | ('key' : Key , 'secret' : Secret , 'trusted' : Trusted , ...) > $ UserX 'bind' deviceB | (encrypt(Key, Secret)) 
= < UserX | ('signedKey' : encrypt(Key, Secret) , ..) > < deviceB | ('key' : Key , 'secret' : Secret , 'trusted' : (UserX , Trusted) , ...) > .
eq < cloudA | (deviceB : ('trusted' : Trusted , ..) , ...) > $ UserX 'shareAccess' cloudA | (deviceB ; UserY) 
= < cloudA | (deviceB : ('trusted' : (UserY , Trusted) , ..) , ...) > .
eq < cloudA | (deviceB : ('trusted' : (UserX , UserY , Rest) , ..) , ...) > $ UserX 'revokeAccess' cloudA | (deviceB ; UserY) 
= < cloudA | (deviceB : ('trusted' : (UserX , Rest) , ..) , ...) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars DeviceKey : Qid .
vars FreshKey : Qid .
vars Key : Qid .
vars OldNear : Set .
vars Rest : Set .
vars Secret : Qid .
vars SignedKey : Item .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid -> Event .
ops ev5 : User Qid Qid -> Event .
ops ev6 : User Qid -> Event .
ops ev7 : User User -> Event .
ops ev8 : User User -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceB .
eq ev2(UserX) = $ UserX 'leave' deviceB .
eq ev3(UserX) = $ UserX 'requestKey' deviceB .
eq ev4(UserX, Key) = $ UserX 'signKey' cloudA | (deviceB ; Key) .
eq ev5(UserX, Key, Secret) = $ UserX 'bind' deviceB | (encrypt(Key, Secret)) .
eq ev6(UserX, MessageA) = $ UserX 'bind' deviceB | (MessageA) .
eq ev7(UserX, UserY) = $ UserX 'shareAccess' cloudA | (deviceB ; UserY) .
eq ev8(UserX, UserY) = $ UserX 'revokeAccess' cloudA | (deviceB ; UserY) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > < deviceB | (...) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > < deviceB | (...) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev4]: E @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > 
=> ep: ev4(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > .
rl [rev5]: E @ S < UserX | ('near' : deviceB , 'signedKey' : encrypt(Key, Secret) , ..) > 
=> ep: ev5(UserX, Key, Secret) @ S < UserX | ('near' : deviceB , 'signedKey' : encrypt(Key, Secret) , ..) > .
rl [rev6]: E @ S < UserX | ('near' : deviceB , 'signedKey' : MessageA , ..) > 
=> ep: ev6(UserX, MessageA) @ S < UserX | ('near' : deviceB , 'signedKey' : MessageA , ..) > .
rl [rev7]: E @ S < UserX | (..) > < UserY | (...) > < deviceB | (....) > 
=> ep: ev7(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > < deviceB | (....) > .
rl [rev8]: E @ S < UserX | (..) > < UserY | (...) > 
=> ep: ev8(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > .

endm
