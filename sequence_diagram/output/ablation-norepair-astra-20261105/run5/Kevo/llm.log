```
[B1] < UserX | 'near' : nils , ... > $ UserX 'walkUp' deviceB
=> < UserX | 'near' : deviceB , ... > .
[B2] < deviceB | 'locked' : false , 'token' : OldToken , ... > $ UserX 'submitToken' deviceB | (Token)
=> < deviceB | 'locked' : true , 'token' : Token , ... > $ deviceB 'uploadToken' cloudA | (Token) .
[B2] < cloudA | deviceB : ('token' : OldToken , ...) > $ deviceB 'uploadToken' cloudA | (Token)
=> < cloudA | deviceB : ('token' : Token , ...) > .
[B3] < cloudA | deviceB : ('token' : Token , ...) > $ UserX 'revokeToken' cloudA | (deviceB ; Token)
=> < cloudA | deviceB : ('token' : nils , ...) > $ cloudA 'confirmRevoke' UserX | (deviceB) .
[B3] < UserX | 'token' : Token , ... > $ cloudA 'confirmRevoke' UserX | (deviceB)
=> < UserX | 'token' : nils , ... > .
