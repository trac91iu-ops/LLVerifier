load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < deviceB | ('key' : nils , 'buttonPressed' : false) > < cloudA | (deviceB : ('owner' : nils , 'bindingKey' : '')) > < userA | ('near' : deviceB , 'key' : ('keyA')) > < userC | ('near' : nils , 'key' : ('keyC')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Key : Qid .
vars OldKey : Set .
vars OldNear : Set .
vars UserX : User .
*** policy
eq < deviceB | ('buttonPressed' : false , ..) > $ UserX 'pressButton' deviceB 
= < deviceB | ('buttonPressed' : true , ..) > .
eq < deviceB | ('buttonPressed' : true , 'key' : OldKey , ..) > $ UserX 'setKey' deviceB | (Key) 
= < deviceB | ('buttonPressed' : false , 'key' : Key , ..) > $ deviceB 'sendBindingKey' cloudA | (deviceB ; Key) .
eq < cloudA | (deviceB : ('bindingKey' : OldKey , ..) , ...) > $ deviceB 'sendBindingKey' cloudA | (deviceB ; Key) 
= < cloudA | (deviceB : ('bindingKey' : Key , ..) , ...) > .
ceq < deviceB | ('buttonPressed' : true , 'key' : Key , ..) > $ UserX 'retrieveKey' deviceB 
= < deviceB | ('buttonPressed' : false , 'key' : Key , ..) > $ deviceB 'sendKey' UserX | (Key) if Key =/= nils .
eq < UserX | ('key' : OldKey , ..) > $ deviceB 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < cloudA | (deviceB : ('bindingKey' : Key , 'owner' : nils , ..) , ...) > $ UserX 'bindDevice' cloudA | (deviceB ; Key) 
= < cloudA | (deviceB : ('bindingKey' : Key , 'owner' : UserX , ..) , ...) > .
eq < cloudA | (deviceB : ('bindingKey' : Key , 'owner' : UserX , ..) , ...) > $ UserX 'resetDevice' cloudA | (deviceB ; Key) 
= < cloudA | (deviceB : ('bindingKey' : '' , 'owner' : nils , ..) , ...) > .
eq < UserX | ('near' : OldNear , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : OldNear , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Key : Qid .
vars OldKey : Set .
vars OldNear : Set .
vars UserX : User .
vars MessageA : Qid .
vars KeyRest : Set .
vars NearRest : Set .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Qid -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid -> Event .
ops ev5 : User Qid -> Event .
ops ev6 : User -> Event .
ops ev7 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'pressButton' deviceB .
eq ev2(UserX, Key) = $ UserX 'setKey' deviceB | (Key) .
eq ev3(UserX) = $ UserX 'retrieveKey' deviceB .
eq ev4(UserX, Key) = $ UserX 'bindDevice' cloudA | (deviceB ; Key) .
eq ev5(UserX, Key) = $ UserX 'resetDevice' cloudA | (deviceB ; Key) .
eq ev6(UserX) = $ UserX 'approach' deviceB .
eq ev7(UserX) = $ UserX 'leave' deviceB .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev1]: E @ S < UserX | ('near' : (deviceB , NearRest) , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : (deviceB , NearRest) , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , 'key' : (Key , KeyRest) , ..) > 
=> ep: ev2(UserX, (Key , KeyRest)) @ S < UserX | ('near' : deviceB , 'key' : (Key , KeyRest) , ..) > .
rl [rev2]: E @ S < UserX | ('near' : (deviceB , NearRest) , 'key' : (Key , KeyRest) , ..) > 
=> ep: ev2(UserX, (Key , KeyRest)) @ S < UserX | ('near' : (deviceB , NearRest) , 'key' : (Key , KeyRest) , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | ('near' : (deviceB , NearRest) , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : (deviceB , NearRest) , ..) > .
rl [rev4]: E @ S < UserX | ('key' : (Key , KeyRest) , ..) > < deviceB | (...) > 
=> ep: ev4(UserX, (Key , KeyRest)) @ S < UserX | ('key' : (Key , KeyRest) , ..) > < deviceB | (...) > .
rl [rev5]: E @ S < UserX | ('key' : (Key , KeyRest) , ..) > < deviceB | (...) > 
=> ep: ev5(UserX, (Key , KeyRest)) @ S < UserX | ('key' : (Key , KeyRest) , ..) > < deviceB | (...) > .
rl [rev6]: E @ S < UserX | ('near' : nils , ..) > < deviceB | (...) > 
=> ep: ev6(UserX) @ S < UserX | ('near' : nils , ..) > < deviceB | (...) > .
rl [rev7]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev7(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev7]: E @ S < UserX | ('near' : (deviceB , NearRest) , ..) > 
=> ep: ev7(UserX) @ S < UserX | ('near' : (deviceB , NearRest) , ..) > .

endm
