load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < cloudA | (userA : ('members' : nils , 'device' : deviceB) , userC : ('members' : nils , 'device' : nils)) > < deviceB | ('trusted' : (cloudA) , 'on' : false , 'key' : nils) > < userA | ('key' : nils) > < userC | ('key' : nils) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars DeviceX : Device .
vars FreshKey : Qid .
vars Key : Qid .
vars Members : Set .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < cloudA | (UserX : ('members' : Members , ..) , ...) > $ UserX 'invite' cloudA | (UserY) 
= < cloudA | (UserX : ('members' : (UserY , Members) , ..) , ...) > .
eq < cloudA | (UserX : ('device' : DeviceX , 'members' : (UserY , Members) , ..) , UserY : ('device' : nils , ...) , ....) > < DeviceX | (.....) > 
= < cloudA | (UserX : ('device' : DeviceX , 'members' : (UserY , Members) , ..) , UserY : ('device' : DeviceX , ...) , ....) > < DeviceX | (.....) > .
eq < system | ('counter' : N , ..) > < UserX | ('key' : nils , ...) > < cloudA | (UserX : ('device' : DeviceX , ....) , .....) > $ UserX 'openWindow' cloudA | (DeviceX) 
= < system | ('counter' : N + 1 , ..) > < UserX | ('key' : randomStr('Key', N) , ...) > < cloudA | (UserX : ('device' : DeviceX , ....) , .....) > $ cloudA 'openWindow' DeviceX | (randomStr('Key', N)) .
eq < DeviceX | ('key' : nils , ..) > $ cloudA 'openWindow' DeviceX | (Key) 
= < DeviceX | ('key' : Key , ..) > .
eq < DeviceX | ('key' : Key , 'trusted' : Trusted , ..) > $ UserX 'bind' DeviceX | (Key) 
= < DeviceX | ('key' : Key , 'trusted' : (UserX , Trusted) , ..) > .
eq < DeviceX | ('trusted' : (UserX , Trusted) , 'on' : false , ..) > $ UserX 'turnOn' DeviceX 
= < DeviceX | ('trusted' : (UserX , Trusted) , 'on' : true , ..) > .
eq < cloudA | (UserX : ('device' : DeviceX , ..) , ...) > $ UserX 'turnOn' cloudA 
= < cloudA | (UserX : ('device' : DeviceX , ..) , ...) > $ cloudA 'turnOn' DeviceX .
eq < DeviceX | ('trusted' : (cloudA , Trusted) , 'on' : false , ..) > $ cloudA 'turnOn' DeviceX 
= < DeviceX | ('trusted' : (cloudA , Trusted) , 'on' : true , ..) > .
eq < cloudA | (UserX : ('members' : (UserY , Members) , 'device' : DeviceX , ..) , UserY : ('device' : DeviceX , ...) , ....) > $ UserX 'removeMember' cloudA | (UserY) 
= < cloudA | (UserX : ('members' : Members , 'device' : DeviceX , ..) , UserY : ('device' : nils , ...) , ....) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars DeviceX : Device .
vars FreshKey : Qid .
vars Key : Qid .
vars Members : Set .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User User -> Event .
ops ev2 : User Device -> Event .
ops ev3 : User Device Qid -> Event .
ops ev4 : User Device -> Event .
ops ev5 : User -> Event .
ops ev6 : User User -> Event .
*** events
eq ev1(UserX, UserY) = $ UserX 'invite' cloudA | (UserY) .
eq ev2(UserX, DeviceX) = $ UserX 'openWindow' cloudA | (DeviceX) .
eq ev3(UserX, DeviceX, Key) = $ UserX 'bind' DeviceX | (Key) .
eq ev4(UserX, DeviceX) = $ UserX 'turnOn' DeviceX .
eq ev5(UserX) = $ UserX 'turnOn' cloudA .
eq ev6(UserX, UserY) = $ UserX 'removeMember' cloudA | (UserY) .
*** transitions
rl [rev1]: E @ S < UserX | (..) > < UserY | (...) > 
=> ep: ev1(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > .
rl [rev2]: E @ S < UserX | (..) > < DeviceX | (...) > 
=> ep: ev2(UserX, DeviceX) @ S < UserX | (..) > < DeviceX | (...) > .
rl [rev3]: E @ S < UserX | ('key' : Key , ..) > < DeviceX | (...) > 
=> ep: ev3(UserX, DeviceX, Key) @ S < UserX | ('key' : Key , ..) > < DeviceX | (...) > .
rl [rev4]: E @ S < UserX | (..) > < DeviceX | (...) > 
=> ep: ev4(UserX, DeviceX) @ S < UserX | (..) > < DeviceX | (...) > .
rl [rev5]: E @ S < UserX | (..) > 
=> ep: ev5(UserX) @ S < UserX | (..) > .
rl [rev6]: E @ S < cloudA | (UserX : ('members' : Members , ..) , ...) > < UserY | (....) > 
=> ep: ev6(UserX, UserY) @ S < cloudA | (UserX : ('members' : Members , ..) , ...) > < UserY | (....) > .

endm
