load rules .
load model-checker .
mod PREDS is
pr TRANSITION * (sort State to State') .
including SATISFACTION .
pr BOOL-OPS .

subsort Vertex < State .

vars N : Nat .
vars Rest : Set .
var Vtx : Vertex .
var P : Prop .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .

ops boundReached sp : -> Prop .
ops deviceTrustsAttacker cloudRecordsTrust : -> Prop .

*** property template: OWN-stealth (attacker = userC)
*** deviceTrustsAttacker : the device trusts the attacker
*** cloudRecordsTrust : the cloud records the device's trust in the attacker

eq E @ S < deviceB | ('trustedUsers' : (userC , Rest) , ..) > |= deviceTrustsAttacker = true .
eq E @ S < cloudA | (deviceB : ('trustedUsers' : (userC , Rest) , ..) , ...) > |= cloudRecordsTrust = true .

*** predefined
ceq E @ S |= sp = true if subject(E) == system . *** system performs actions
ceq E @ S < system | 'counter' : N , ... > |= boundReached = true if N >= 5 . *** Max turns number
ceq E @ S < system | 'time' : N , ... > |= boundReached = true if N >= 3 . *** time pass

eq Vtx |= P = false [owise] .
endm

mod CHECK is
pr PREDS .
including MODEL-CHECKER .

ops spec basic safety : -> Prop .

eq basic = [] (~ boundReached) .

eq safety = <> (~ cloudRecordsTrust /\ ~ deviceTrustsAttacker /\ O (~ cloudRecordsTrust /\ deviceTrustsAttacker)) .

*** security property specification
eq spec = O ~ (safety /\ basic) .
endm

load ../lib/postProcess .
