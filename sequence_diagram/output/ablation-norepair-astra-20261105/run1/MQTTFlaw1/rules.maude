load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | (nils) > < cloudB | ('buffer' : nils , deviceB : ('permission' : true) , userA : ('permission' : true)) > < deviceB | ('on' : false) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Message : Qid .
vars OldPermission : Bool .
vars UserX : User .
*** policy
eq < cloudB | ('buffer' : nils , UserX : ('permission' : true , ..) , ...) > $ UserX 'requestPublish' cloudB | ('toggle') 
= < cloudB | ('buffer' : 'toggle' , UserX : ('permission' : true , ..) , ...) > $ cloudB 'acknowledgeReceipt' UserX .
eq < cloudB | (UserX : ('permission' : OldPermission , ..) , ...) > $ cloudB 'revokePermission' cloudB | (UserX) 
= < cloudB | (UserX : ('permission' : false , ..) , ...) > .
ceq < cloudB | ('buffer' : Message , deviceB : ('permission' : true , ..) , ...) > $ UserX 'releaseBufferedMessage' cloudB 
= < cloudB | ('buffer' : nils , deviceB : ('permission' : true , ..) , ...) > $ cloudB 'publish' deviceB | (Message) if Message =/= nils .
eq < deviceB | ('on' : false , ..) > $ cloudB 'publish' deviceB | ('toggle') 
= < deviceB | ('on' : true , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Message : Qid .
vars OldPermission : Bool .
vars UserX : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'requestPublish' cloudB | ('toggle') .
eq ev2(UserX) = $ cloudB 'revokePermission' cloudB | (UserX) .
eq ev3(UserX) = $ UserX 'releaseBufferedMessage' cloudB .
*** transitions
rl [rev1]: E @ S < UserX | (..) > 
=> ep: ev1(UserX) @ S < UserX | (..) > .
rl [rev2]: E @ S < cloudB | (UserX : ('permission' : true , ..) , ...) > 
=> ep: ev2(UserX) @ S < cloudB | (UserX : ('permission' : true , ..) , ...) > .
rl [rev3]: E @ S < UserX | (..) > 
=> ep: ev3(UserX) @ S < UserX | (..) > .

endm
