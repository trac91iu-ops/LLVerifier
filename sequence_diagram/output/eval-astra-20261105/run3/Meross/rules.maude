load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < deviceB | ('key' : 'keyDeviceB') > < userA | ('near' : deviceB , 'keys' : ('keyUserA')) > < userC | ('near' : nils , 'keys' : ('keyUserC')) > < cloudA | (deviceB : ('key' : 'keyDeviceB' , 'owner' : nils) , userA : ('key' : 'keyUserA') , userC : ('key' : 'keyUserC')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Kdevice : Qid .
vars Keys : Set .
vars Kuser : Qid .
vars OldNear : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < deviceB | ('key' : Kdevice , ..) > $ UserX 'pressButton' deviceB 
= < deviceB | ('key' : Kdevice , ..) > $ deviceB 'sendDeviceKey' UserX | (Kdevice) .
eq < UserX | ('keys' : Keys , ..) > $ deviceB 'sendDeviceKey' UserX | (Kdevice) 
= < UserX | ('keys' : (Kdevice , Keys) , ..) > .
eq < deviceB | ('key' : Kdevice , ..) > $ UserX 'bindDevice' deviceB | (Kuser) 
= < deviceB | ('key' : Kdevice , ..) > $ deviceB 'bindDevice' cloudA | (deviceB ; Kdevice ; Kuser) .
eq < cloudA | (deviceB : ('key' : Kdevice , 'owner' : nils , ..) , UserY : ('key' : Kuser , ...) , ....) > $ deviceB 'bindDevice' cloudA | (deviceB ; Kdevice ; Kuser) 
= < cloudA | (deviceB : ('key' : Kdevice , 'owner' : UserY , ..) , UserY : ('key' : Kuser , ...) , ....) > .
eq < cloudA | (deviceB : ('key' : Kdevice , 'owner' : nils , ..) , UserY : ('key' : Kuser , ...) , ....) > $ UserX 'bindDevice' cloudA | (deviceB ; Kdevice ; Kuser) 
= < cloudA | (deviceB : ('key' : Kdevice , 'owner' : UserY , ..) , UserY : ('key' : Kuser , ...) , ....) > .
eq < UserX | ('near' : OldNear , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : OldNear , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Kdevice : Qid .
vars Keys : Set .
vars Kuser : Qid .
vars OldNear : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
vars Rest : Set .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Qid -> Event .
ops ev3 : User Qid Qid -> Event .
ops ev4 : User -> Event .
ops ev5 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'pressButton' deviceB .
eq ev2(UserX, Kuser) = $ UserX 'bindDevice' deviceB | (Kuser) .
eq ev3(UserX, Kdevice, Kuser) = $ UserX 'bindDevice' cloudA | (deviceB ; Kdevice ; Kuser) .
eq ev4(UserX) = $ UserX 'approach' deviceB .
eq ev5(UserX) = $ UserX 'leave' deviceB .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev1]: E @ S < UserX | ('near' : (deviceB , Rest) , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : (deviceB , Rest) , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , 'keys' : (Kuser) , ..) > 
=> ep: ev2(UserX, Kuser) @ S < UserX | ('near' : deviceB , 'keys' : (Kuser) , ..) > .
rl [rev2]: E @ S < UserX | ('near' : (deviceB , Rest) , 'keys' : (Kuser) , ..) > 
=> ep: ev2(UserX, Kuser) @ S < UserX | ('near' : (deviceB , Rest) , 'keys' : (Kuser) , ..) > .
rl [rev3]: E @ S < UserX | ('keys' : (Kdevice , Kuser , Rest) , ..) > 
=> ep: ev3(UserX, Kdevice, Kuser) @ S < UserX | ('keys' : (Kdevice , Kuser , Rest) , ..) > .
rl [rev3]: E @ S < UserX | ('keys' : (Kuser , Rest) , ..) > 
=> ep: ev3(UserX, Kuser, Kuser) @ S < UserX | ('keys' : (Kuser , Rest) , ..) > .
rl [rev4]: E @ S < UserX | ('near' : nils , ..) > < deviceB | (...) > 
=> ep: ev4(UserX) @ S < UserX | ('near' : nils , ..) > < deviceB | (...) > .
rl [rev5]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev5]: E @ S < UserX | ('near' : (deviceB , Rest) , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : (deviceB , Rest) , ..) > .

endm
