load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < cloudB | (deviceLock : ('on' : false , 'trusted' : (cloudSmartThing) , 'key' : 'key')) > < userA | ('key' : nils) > < userC | ('key' : nils) > < cloudSmartThing | (deviceSwitch : ('boundTo' : deviceLock , 'key' : 'key' , 'on' : false , 'trusted' : (userA))) > < deviceSwitch | (nils) > < deviceLock | ('trusted' : (cloudB) , 'on' : false) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars B : Device .
vars Cloud : Cloud .
vars Device : Device .
vars Key : Qid .
vars P : Principal .
vars Rest : Set .
vars UserX : User .
vars UserY : User .
*** policy
ceq < Cloud | (Device : ('trusted' : (UserX , Rest) , 'key' : Key , ..) , ...) > $ UserX 'requestKey' Cloud 
= < Cloud | (Device : ('trusted' : (UserX , Rest) , 'key' : Key , ..) , ...) > $ Cloud 'sendKey' UserX | (Key) if Key =/= nils .
eq < UserX | ('key' : nils , ..) > $ Cloud 'sendKey' UserX | (Key) 
= < UserX | ('key' : Key , ..) > .
eq < Cloud | (Device : ('trusted' : (UserX , Rest) , ..) , ...) > $ UserX 'delegateAccess' Cloud | (Device ; UserY) 
= < Cloud | (Device : ('trusted' : (UserX , UserY , Rest) , ..) , ...) > .
eq < Cloud | (Device : ('trusted' : (UserX , UserY , Rest) , ..) , ...) > $ UserX 'revokeAccess' Cloud | (Device ; UserY) 
= < Cloud | (Device : ('trusted' : (UserX , Rest) , ..) , ...) > .
eq < cloudSmartThing | (Device : ('key' : Key , 'on' : false , ..) , ...) > $ UserX 'turnOnWithKey' cloudSmartThing | (Device ; Key) 
= < cloudSmartThing | (Device : ('key' : Key , 'on' : true , ..) , ...) > $ cloudSmartThing 'turnOn' Device .
eq < Device | (..) > $ UserX 'turnOn' Device 
= < Device | (..) > .
eq < Cloud | (Device : ('on' : false , 'trusted' : (P , Rest) , ..) , ...) > $ P 'turnOn' Device 
= < Cloud | (Device : ('on' : true , 'trusted' : (P , Rest) , ..) , ...) > $ Cloud 'turnOn' Device .
eq < cloudSmartThing | (Device : ('boundTo' : B , ..) , ...) > $ cloudSmartThing 'turnOn' Device 
= < cloudSmartThing | (Device : ('boundTo' : B , ..) , ...) > $ cloudSmartThing 'turnOn' B .
eq < deviceLock | ('trusted' : (P , Rest) , 'on' : false , ..) > $ P 'turnOn' deviceLock 
= < deviceLock | ('trusted' : (P , Rest) , 'on' : true , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars B : Device .
vars Cloud : Cloud .
vars Device : Device .
vars Key : Qid .
vars P : Principal .
vars Rest : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User Cloud -> Event .
ops ev2 : User Cloud Device User -> Event .
ops ev3 : User Cloud Device User -> Event .
ops ev4 : User Device Qid -> Event .
ops ev5 : User Device -> Event .
ops ev6 : Principal Device -> Event .
ops ev7 : Principal -> Event .
*** events
eq ev1(UserX, Cloud) = $ UserX 'requestKey' Cloud .
eq ev2(UserX, Cloud, Device, UserY) = $ UserX 'delegateAccess' Cloud | (Device ; UserY) .
eq ev3(UserX, Cloud, Device, UserY) = $ UserX 'revokeAccess' Cloud | (Device ; UserY) .
eq ev4(UserX, Device, Key) = $ UserX 'turnOnWithKey' cloudSmartThing | (Device ; Key) .
eq ev5(UserX, Device) = $ UserX 'turnOn' Device .
eq ev6(P, Device) = $ P 'turnOn' Device .
eq ev7(P) = $ P 'turnOn' deviceLock .
*** transitions
rl [rev1]: E @ S < UserX | (..) > < Cloud | (...) > 
=> ep: ev1(UserX, Cloud) @ S < UserX | (..) > < Cloud | (...) > .
rl [rev2]: E @ S < UserX | (..) > < UserY | (...) > < Cloud | (....) > < Device | (.....) > 
=> ep: ev2(UserX, Cloud, Device, UserY) @ S < UserX | (..) > < UserY | (...) > < Cloud | (....) > < Device | (.....) > .
rl [rev3]: E @ S < UserX | (..) > < UserY | (...) > < Cloud | (....) > < Device | (.....) > 
=> ep: ev3(UserX, Cloud, Device, UserY) @ S < UserX | (..) > < UserY | (...) > < Cloud | (....) > < Device | (.....) > .
rl [rev4]: E @ S < UserX | ('key' : Key , ..) > < Device | (...) > 
=> ep: ev4(UserX, Device, Key) @ S < UserX | ('key' : Key , ..) > < Device | (...) > .
rl [rev5]: E @ S < UserX | (..) > < Device | (...) > 
=> ep: ev5(UserX, Device) @ S < UserX | (..) > < Device | (...) > .

endm
