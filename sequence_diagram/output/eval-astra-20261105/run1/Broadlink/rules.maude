load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < userA | ('key' : nils , 'near' : deviceB) > < userC | ('key' : nils , 'near' : nils) > < deviceB | ('key' : 'keyB' , 'locked' : false) > < cloudA | (userA : ('members' : nils , 'devices' : nils , 'owners' : nils) , userC : ('members' : nils , 'devices' : nils , 'owners' : nils) , deviceB : ('key' : 'keyB' , 'members' : nils , 'devices' : nils , 'owners' : nils)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars FreshKey : Qid .
vars Key : Qid .
vars Members : Set .
vars OldKey : Qid .
vars OldNear : Set .
vars Owners : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < UserX | ('near' : OldNear , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : OldNear , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
eq < system | ('counter' : N , ..) > < deviceB | ('key' : OldKey , ...) > $ UserX 'pressButton' deviceB 
= < system | ('counter' : N + 1 , ..) > < deviceB | ('key' : randomStr('Key', N) , ...) > .
eq < UserX | ('key' : nils , ..) > < deviceB | ('locked' : false , 'key' : Key , ...) > $ UserX 'retrieveKey' deviceB 
= < UserX | ('key' : Key , ..) > < deviceB | ('locked' : false , 'key' : Key , ...) > .
eq < deviceB | ('locked' : false , 'key' : Key , ..) > $ UserX 'lock' deviceB | (Key) 
= < deviceB | ('locked' : true , 'key' : Key , ..) > .
eq < deviceB | ('key' : Key , ..) > < cloudA | (deviceB : ('owners' : Owners , ...) , ....) > $ UserX 'bind' cloudA | (deviceB ; Key) 
= < deviceB | ('key' : Key , ..) > < cloudA | (deviceB : ('owners' : (UserX , Owners) , ...) , ....) > .
eq < cloudA | (userC : ('devices' : nils , 'members' : Members , ..) , ...) > $ userC 'invite' cloudA | (userA) 
= < cloudA | (userC : ('devices' : nils , 'members' : (userA , Members) , ..) , ...) > .
eq < cloudA | (userC : ('devices' : nils , 'members' : (userA , Members) , ..) , ...) > $ userC 'remove' cloudA | (userA) 
= < cloudA | (userC : ('devices' : nils , 'members' : Members , ..) , ...) > .
eq < cloudA | (..) > $ UserY 'retrieveCloudKey' cloudA | (deviceB ; Key) 
= < cloudA | (..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars FreshKey : Qid .
vars Key : Qid .
vars Members : Set .
vars OldKey : Qid .
vars OldNear : Set .
vars Owners : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User -> Event .
ops ev5 : User Qid -> Event .
ops ev6 : User Qid -> Event .
ops ev7 :  -> Event .
ops ev8 :  -> Event .
ops ev9 : User Qid -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceB .
eq ev2(UserX) = $ UserX 'leave' deviceB .
eq ev3(UserX) = $ UserX 'pressButton' deviceB .
eq ev4(UserX) = $ UserX 'retrieveKey' deviceB .
eq ev5(UserX, Key) = $ UserX 'lock' deviceB | (Key) .
eq ev6(UserX, Key) = $ UserX 'bind' cloudA | (deviceB ; Key) .
eq ev7 = $ userC 'invite' cloudA | (userA) .
eq ev8 = $ userC 'remove' cloudA | (userA) .
eq ev9(UserY, Key) = $ UserY 'retrieveCloudKey' cloudA | (deviceB ; Key) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev4]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev4(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev5]: E @ S < UserX | ('key' : Key , 'near' : deviceB , ..) > 
=> ep: ev5(UserX, Key) @ S < UserX | ('key' : Key , 'near' : deviceB , ..) > .
rl [rev6]: E @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > 
=> ep: ev6(UserX, Key) @ S < UserX | ('key' : Key , ..) > < deviceB | (...) > .
rl [rev7]: E @ S < userC | (..) > < userA | (...) > 
=> ep: ev7(userC) @ S < userC | (..) > < userA | (...) > .
rl [rev8]: E @ S < userC | (..) > < userA | (...) > 
=> ep: ev8(userC) @ S < userC | (..) > < userA | (...) > .
rl [rev9]: E @ S < UserY | ('key' : Key , ..) > < deviceB | (...) > 
=> ep: ev9(UserY, Key) @ S < UserY | ('key' : Key , ..) > < deviceB | (...) > .

endm
