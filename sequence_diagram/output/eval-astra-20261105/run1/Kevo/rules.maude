load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < system | ('counter' : 0) > < userA | ('message' : nils , 'near' : deviceB) > < userC | ('message' : nils , 'near' : nils) > < deviceB | ('key' : 'keyB') > < cloudA | (deviceB : ('owners' : nils , 'key' : 'keyB')) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars FreshR : Qid .
vars Key : Qid .
vars Message : Item .
vars OldNear : Set .
vars Owners : Set .
vars R : Qid .
vars UserX : User .
*** policy
eq < UserX | ('near' : OldNear , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : OldNear , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
eq < system | ('counter' : N , ..) > < deviceB | ('key' : Key , ...) > $ UserX 'pressButton' deviceB 
= < system | ('counter' : N + 1 , ..) > < deviceB | ('key' : Key , ...) > $ deviceB 'sendMessage' UserX | (encrypt(randomStr('R', N), Key)) .
eq < UserX | ('message' : nils , ..) > $ deviceB 'sendMessage' UserX | (Message) 
= < UserX | ('message' : Message , ..) > .
eq < cloudA | (deviceB : ('key' : Key , 'owners' : Owners , ..) , ...) > $ UserX 'bind' cloudA | (deviceB ; encrypt(R, Key)) 
= < cloudA | (deviceB : ('key' : Key , 'owners' : (UserX , Owners) , ..) , ...) > .
eq < cloudA | (deviceB : ('owners' : (UserX , Owners) , ..) , ...) > $ UserX 'reset' cloudA | (deviceB) 
= < cloudA | (deviceB : ('owners' : (nils , Owners) , ..) , ...) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars FreshR : Qid .
vars Key : Qid .
vars Message : Item .
vars OldNear : Set .
vars Owners : Set .
vars R : Qid .
vars UserX : User .
vars MessageA : Qid .
vars Rest : Set .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User -> Event .
ops ev4 : User Qid Qid -> Event .
ops ev5 : User Qid -> Event .
ops ev6 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceB .
eq ev2(UserX) = $ UserX 'leave' deviceB .
eq ev3(UserX) = $ UserX 'pressButton' deviceB .
eq ev4(UserX, R, Key) = $ UserX 'bind' cloudA | (deviceB ; encrypt(R, Key)) .
eq ev5(UserX, MessageA) = $ UserX 'bind' cloudA | (MessageA) .
eq ev6(UserX) = $ UserX 'reset' cloudA | (deviceB) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev2]: E @ S < UserX | ('near' : (deviceB , Rest) , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : (deviceB , Rest) , ..) > .
rl [rev3]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | ('near' : (deviceB , Rest) , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : (deviceB , Rest) , ..) > .
rl [rev4]: E @ S < UserX | ('message' : encrypt(R, Key) , ..) > 
=> ep: ev4(UserX, R, Key) @ S < UserX | ('message' : encrypt(R, Key) , ..) > .
rl [rev5]: E @ S < UserX | ('message' : MessageA , ..) > 
=> ep: ev5(UserX, MessageA) @ S < UserX | ('message' : MessageA , ..) > .
rl [rev6]: E @ S < UserX | (..) > 
=> ep: ev6(UserX) @ S < UserX | (..) > .

endm
