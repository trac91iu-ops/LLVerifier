load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < deviceB | ('key' : nils , 'buttonPressed' : false) > < cloudA | (deviceB : ('owner' : nils) , userA : ('key' : 'keyA') , userC : ('key' : 'keyC')) > < userA | ('near' : deviceB) > < userC | ('near' : nils) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars Key : Qid .
vars OldNear : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < deviceB | ('buttonPressed' : false , ..) > $ UserX 'pressButton' deviceB 
= < deviceB | ('buttonPressed' : true , ..) > .
eq < cloudA | (UserX : ('key' : Key , ..) , ...) > < deviceB | ('buttonPressed' : true , 'key' : nils , ....) > $ UserX 'sendKey' deviceB | (Key) 
= < cloudA | (UserX : ('key' : Key , ..) , ...) > < deviceB | ('buttonPressed' : false , 'key' : Key , ....) > .
ceq < deviceB | ('key' : Key , ..) > $ UserX 'discover' deviceB 
= < deviceB | ('key' : Key , ..) > $ deviceB 'bind' cloudA | (deviceB ; Key) if Key =/= nils .
eq < cloudA | (UserY : ('key' : Key , ..) , deviceB : ('owner' : nils , ...) , ....) > $ deviceB 'bind' cloudA | (deviceB ; Key) 
= < cloudA | (UserY : ('key' : Key , ..) , deviceB : ('owner' : UserY , ...) , ....) > .
eq < UserX | ('near' : OldNear , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : OldNear , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars Key : Qid .
vars OldNear : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
vars Rest : Set .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User Qid -> Event .
ops ev3 : User -> Event .
ops ev4 : User -> Event .
ops ev5 : User -> Event .
*** events
eq ev1(UserX) = $ UserX 'pressButton' deviceB .
eq ev2(UserX, Key) = $ UserX 'sendKey' deviceB | (Key) .
eq ev3(UserX) = $ UserX 'discover' deviceB .
eq ev4(UserX) = $ UserX 'approach' deviceB .
eq ev5(UserX) = $ UserX 'leave' deviceB .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev1]: E @ S < UserX | ('near' : (deviceB , Rest) , ..) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : (deviceB , Rest) , ..) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , ..) > < cloudA | (UserX : ('key' : Key , ...) , ....) > 
=> ep: ev2(UserX, Key) @ S < UserX | ('near' : deviceB , ..) > < cloudA | (UserX : ('key' : Key , ...) , ....) > .
rl [rev2]: E @ S < UserX | ('near' : (deviceB , Rest) , ..) > < cloudA | (UserX : ('key' : Key , ...) , ....) > 
=> ep: ev2(UserX, Key) @ S < UserX | ('near' : (deviceB , Rest) , ..) > < cloudA | (UserX : ('key' : Key , ...) , ....) > .
rl [rev3]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | ('near' : (deviceB , Rest) , ..) > 
=> ep: ev3(UserX) @ S < UserX | ('near' : (deviceB , Rest) , ..) > .
rl [rev4]: E @ S < UserX | ('near' : nils , ..) > < deviceB | (...) > 
=> ep: ev4(UserX) @ S < UserX | ('near' : nils , ..) > < deviceB | (...) > .
rl [rev5]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev5]: E @ S < UserX | ('near' : (deviceB , Rest) , ..) > 
=> ep: ev5(UserX) @ S < UserX | ('near' : (deviceB , Rest) , ..) > .

endm
