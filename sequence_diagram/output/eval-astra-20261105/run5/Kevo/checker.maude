load rules .
load model-checker .
mod PREDS is
pr TRANSITION * (sort State to State') .
including SATISFACTION .
pr BOOL-OPS .

subsort Vertex < State .

vars N : Nat .
vars Rest : Set .
var Vtx : Vertex .
var P : Prop .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .

ops boundReached sp : -> Prop .
ops attackerLocal attackerOwner : -> Prop .

*** property template: OWN-remote (attacker = userC)
*** attackerLocal : the attacker is near / local to the device
*** attackerOwner : the attacker is recorded as an owner of the device

eq E @ S < userC | ('near' : deviceB , ..) > |= attackerLocal = true .
eq E @ S < cloudA | (deviceB : ('owners' : ('owner' : userC , Rest) , ..) , ...) > |= attackerOwner = true .

*** predefined
ceq E @ S |= sp = true if subject(E) == system . *** system performs actions
ceq E @ S < system | 'counter' : N , ... > |= boundReached = true if N >= 5 . *** Max turns number
ceq E @ S < system | 'time' : N , ... > |= boundReached = true if N >= 3 . *** time pass

eq Vtx |= P = false [owise] .
endm

mod CHECK is
pr PREDS .
including MODEL-CHECKER .

ops spec basic safety : -> Prop .

eq basic = [] (~ boundReached) .

eq safety = <> (~ attackerLocal /\ ~ attackerOwner /\ O (~ attackerLocal /\ attackerOwner)) .

*** security property specification
eq spec = O ~ (safety /\ basic) .
endm

load ../lib/postProcess .
