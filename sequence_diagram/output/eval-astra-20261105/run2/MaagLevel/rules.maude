load ../lib/Iot .
mod SYSTEM is
protecting Iot .
eq init = idle @ < userA | ('cachedCommand' : nils , 'near' : nils) > < userC | ('near' : nils , 'cachedCommand' : nils) > < cloudA | ('key' : 'secret' , deviceB : ('trusted' : (userA))) > < deviceB | ('trusted' : (userA)) > .

vars .. ... .... ..... ...... ....... : Set .

*** variables
vars N : Nat .
vars CachingRelayUser : User .
vars ImmediateRelayUser : User .
vars L : List .
vars RelayUser : User .
vars Rest : Set .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
*** policy
eq < UserX | ('near' : nils , ..) > $ UserX 'approach' deviceB 
= < UserX | ('near' : deviceB , ..) > .
eq < UserX | ('near' : deviceB , ..) > $ UserX 'leave' deviceB 
= < UserX | ('near' : nils , ..) > .
eq < cloudA | ('key' : 'secret' , deviceB : ('trusted' : (UserX) , ..) , ...) > < RelayUser | ('near' : deviceB , ....) > $ UserX 'shareAccess' cloudA | (deviceB ; UserY) 
= < cloudA | ('key' : 'secret' , deviceB : ('trusted' : (UserX , UserY , ..) , ..) , ...) > < RelayUser | ('near' : deviceB , ....) > $ cloudA 'deliverCommand' RelayUser | (deviceB ; list((encrypt('auth', 'secret') ; 'share' ; UserY))) .
eq < cloudA | ('key' : 'secret' , deviceB : ('trusted' : (UserX , UserY , Rest) , ..) , ...) > < RelayUser | ('near' : deviceB , ....) > $ UserX 'revokeAccess' cloudA | (deviceB ; UserY) 
= < cloudA | ('key' : 'secret' , deviceB : ('trusted' : (UserX) , ..) , ...) > < RelayUser | ('near' : deviceB , ....) > $ cloudA 'deliverCommand' RelayUser | (deviceB ; list((encrypt('auth', 'secret') ; 'revoke' ; UserY))) .
eq < ImmediateRelayUser | ('near' : deviceB , ..) > $ cloudA 'deliverCommand' RelayUser | (deviceB ; L) 
= < ImmediateRelayUser | ('near' : deviceB , ..) > $ RelayUser 'forwardCommand' deviceB | (L) .
eq < CachingRelayUser | ('near' : deviceB , 'cachedCommand' : nils , ..) > $ cloudA 'deliverCommand' RelayUser | (deviceB ; L) 
= < CachingRelayUser | ('near' : deviceB , 'cachedCommand' : L , ..) > .
ceq < CachingRelayUser | ('near' : deviceB , 'cachedCommand' : L , ..) > 
= < CachingRelayUser | ('near' : deviceB , 'cachedCommand' : nils , ..) > $ CachingRelayUser 'forwardCommand' deviceB | (L) if L =/= nils .
eq < cloudA | ('key' : 'secret' , ..) > < deviceB | ('trusted' : Trusted , ...) > $ RelayUser 'forwardCommand' deviceB | (list((encrypt('auth', 'secret') ; 'share' ; UserY))) 
= < cloudA | ('key' : 'secret' , ..) > < deviceB | ('trusted' : (UserY , Trusted) , ...) > .
eq < cloudA | ('key' : 'secret' , ..) > < deviceB | ('trusted' : (UserY , Rest) , ...) > $ RelayUser 'forwardCommand' deviceB | (list((encrypt('auth', 'secret') ; 'revoke' ; UserY))) 
= < cloudA | ('key' : 'secret' , ..) > < deviceB | ('trusted' : Rest , ...) > .
endm

mod TRANSITION is
including SYSTEM .
var E : Event .
var S : Soup .
vars .. ... .... ..... ...... ....... : Set .
vars N : Nat .
vars CachingRelayUser : User .
vars ImmediateRelayUser : User .
vars L : List .
vars RelayUser : User .
vars Rest : Set .
vars Trusted : Set .
vars UserX : User .
vars UserY : User .
vars MessageA : Qid .
*** events type declaration
ops ev1 : User -> Event .
ops ev2 : User -> Event .
ops ev3 : User User -> Event .
ops ev4 : User User -> Event .
ops ev5 : User List -> Event .
ops ev6 : User User -> Event .
ops ev7 : User User -> Event .
*** events
eq ev1(UserX) = $ UserX 'approach' deviceB .
eq ev2(UserX) = $ UserX 'leave' deviceB .
eq ev3(UserX, UserY) = $ UserX 'shareAccess' cloudA | (deviceB ; UserY) .
eq ev4(UserX, UserY) = $ UserX 'revokeAccess' cloudA | (deviceB ; UserY) .
eq ev5(RelayUser, L) = $ RelayUser 'forwardCommand' deviceB | (L) .
eq ev6(RelayUser, UserY) = $ RelayUser 'forwardCommand' deviceB | (list((encrypt('auth', 'secret') ; 'share' ; UserY))) .
eq ev7(RelayUser, UserY) = $ RelayUser 'forwardCommand' deviceB | (list((encrypt('auth', 'secret') ; 'revoke' ; UserY))) .
*** transitions
rl [rev1]: E @ S < UserX | ('near' : nils , ..) > < deviceB | (...) > 
=> ep: ev1(UserX) @ S < UserX | ('near' : nils , ..) > < deviceB | (...) > .
rl [rev2]: E @ S < UserX | ('near' : deviceB , ..) > 
=> ep: ev2(UserX) @ S < UserX | ('near' : deviceB , ..) > .
rl [rev3]: E @ S < UserX | (..) > < UserY | (...) > 
=> ep: ev3(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > .
rl [rev4]: E @ S < UserX | (..) > < UserY | (...) > 
=> ep: ev4(UserX, UserY) @ S < UserX | (..) > < UserY | (...) > .
rl [rev5]: E @ S < CachingRelayUser | ('near' : deviceB , 'cachedCommand' : L , ..) > 
=> ep: ev5(CachingRelayUser, L) @ S < CachingRelayUser | ('near' : deviceB , 'cachedCommand' : L , ..) > .
rl [rev6]: E @ S < CachingRelayUser | ('near' : deviceB , 'cachedCommand' : list((encrypt('auth', 'secret') ; 'share' ; UserY)) , ..) > 
=> ep: ev6(CachingRelayUser, UserY) @ S < CachingRelayUser | ('near' : deviceB , 'cachedCommand' : list((encrypt('auth', 'secret') ; 'share' ; UserY)) , ..) > .
rl [rev7]: E @ S < CachingRelayUser | ('near' : deviceB , 'cachedCommand' : list((encrypt('auth', 'secret') ; 'revoke' ; UserY)) , ..) > 
=> ep: ev7(CachingRelayUser, UserY) @ S < CachingRelayUser | ('near' : deviceB , 'cachedCommand' : list((encrypt('auth', 'secret') ; 'revoke' ; UserY)) , ..) > .

endm
